<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Ft8Client.App.ViewModels"
             xmlns:v="using:Ft8Client.App.Views"
             x:Class="Ft8Client.App.Views.LogView"
             x:DataType="vm:LogViewModel">
  <Border Classes="card" Margin="16,0,16,12" Padding="14,10">
    <Grid RowDefinitions="Auto,Auto,Auto,*,Auto" ColumnDefinitions="*,Auto">
      <StackPanel Orientation="Horizontal" Spacing="8">
        <TextBox Text="{Binding Search}" PlaceholderText="Search call, grid, country or name" Width="280" AutomationProperties.Name="Search" />
        <Button Content="Edit" Command="{Binding EditCommand}" />
        <Button Content="{Binding ConfirmingDelete, Converter={x:Static v:LogView.DeleteText}}" Command="{Binding DeleteCommand}" />
        <Button Content="Import ADIF" Click="OnImport" />
        <Button Content="Export ADIF" Click="OnExport" />
        <Button Content="Sync with QRZ now" Command="{Binding SyncCommand}" IsEnabled="{Binding !Syncing}" />
      </StackPanel>
      <TextBlock Grid.Row="1" Text="{Binding Message}" Margin="0,6,0,0" TextWrapping="Wrap" />
      <Grid Grid.Row="2" ColumnDefinitions="90,56,100,50,56,50,56,64,150,140,100,*" Margin="0,10,0,4">
        <TextBlock Text="Date" Classes="secondary" /><TextBlock Grid.Column="1" Text="Time" Classes="secondary" />
        <TextBlock Grid.Column="2" Text="Call" Classes="secondary" /><TextBlock Grid.Column="3" Text="Band" Classes="secondary" />
        <TextBlock Grid.Column="4" Text="Mode" Classes="secondary" /><TextBlock Grid.Column="5" Text="Sent" Classes="secondary" />
        <TextBlock Grid.Column="6" Text="Rcvd" Classes="secondary" /><TextBlock Grid.Column="7" Text="Grid" Classes="secondary" />
        <TextBlock Grid.Column="8" Text="Country" Classes="secondary" /><TextBlock Grid.Column="9" Text="Name" Classes="secondary" />
        <TextBlock Grid.Column="10" Text="Why" Classes="secondary" /><TextBlock Grid.Column="11" Text="QRZ" Classes="secondary" />
      </Grid>
      <ListBox Grid.Row="3" ItemsSource="{Binding Rows}" SelectedItem="{Binding Selected}" Background="Transparent" AutomationProperties.Name="Log">
        <ListBox.Styles><Style Selector="ListBoxItem"><Setter Property="Padding" Value="0,2" /></Style></ListBox.Styles>
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="vm:LogRowViewModel">
            <Grid ColumnDefinitions="90,56,100,50,56,50,56,64,150,140,100,*">
              <TextBlock Text="{Binding Date}" Classes="num" /><TextBlock Grid.Column="1" Text="{Binding Time}" Classes="num" />
              <TextBlock Grid.Column="2" Text="{Binding Call}" FontWeight="SemiBold" /><TextBlock Grid.Column="3" Text="{Binding Band}" />
              <TextBlock Grid.Column="4" Text="{Binding Mode}" /><TextBlock Grid.Column="5" Text="{Binding Sent}" Classes="num" />
              <TextBlock Grid.Column="6" Text="{Binding Received}" Classes="num" /><TextBlock Grid.Column="7" Text="{Binding Grid}" />
              <TextBlock Grid.Column="8" Text="{Binding Country}" TextTrimming="CharacterEllipsis" />
              <TextBlock Grid.Column="9" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
              <TextBlock Grid.Column="10" Text="{Binding Need}" />
              <TextBlock Grid.Column="11" Text="{Binding Qrz}" Foreground="{Binding QrzKind, Converter={x:Static v:Converters.KindBrush}}" TextTrimming="CharacterEllipsis" />
            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
      <TextBlock Grid.Row="4" Text="{Binding Status}" Classes="secondary num" Margin="0,6,0,0" />

      <Border Grid.Column="1" Grid.RowSpan="5" Width="260" Margin="12,0,0,0" Padding="12" Classes="card"
              IsVisible="{Binding Editing, Converter={x:Static ObjectConverters.IsNotNull}}">
        <StackPanel DataContext="{Binding Editing}" x:DataType="vm:QsoEditViewModel" Spacing="6">
          <TextBlock Text="Edit contact" Classes="title" />
          <TextBlock Text="Call" /><TextBox Text="{Binding Call}" />
          <TextBlock Text="Grid" /><TextBox Text="{Binding Grid}" />
          <TextBlock Text="Report sent" /><TextBox Text="{Binding Sent}" />
          <TextBlock Text="Report received" /><TextBox Text="{Binding Received}" />
          <TextBlock Text="Name" /><TextBox Text="{Binding Name}" />
          <TextBlock Text="Comment" /><TextBox Text="{Binding Comment}" />
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Content="Save" Command="{Binding $parent[UserControl].((vm:LogViewModel)DataContext).SaveEditCommand}" />
            <Button Content="Cancel" Command="{Binding $parent[UserControl].((vm:LogViewModel)DataContext).CancelEditCommand}" />
          </StackPanel>
        </StackPanel>
      </Border>
    </Grid>
  </Border>
</UserControl>
