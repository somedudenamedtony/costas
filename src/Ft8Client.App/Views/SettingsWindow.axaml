<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Ft8Client.App.ViewModels"
        xmlns:services="using:Ft8Client.App.Services"
        xmlns:v="using:Ft8Client.App.Views"
        x:Class="Ft8Client.App.Views.SettingsWindow"
        Icon="/Assets/costas.ico"
        x:DataType="vm:SettingsViewModel"
        Title="Settings" Width="900" Height="640" MinWidth="760" MinHeight="520" WindowStartupLocation="CenterOwner">
  <Window.Styles>
    <!-- One setting: label on the left, control and a short explanation on the right. -->
    <Style Selector="Grid.field">
      <Setter Property="Margin" Value="0,0,0,14" />
    </Style>
    <Style Selector="Grid.field > TextBlock.label">
      <Setter Property="VerticalAlignment" Value="Top" />
      <Setter Property="Margin" Value="0,6,12,0" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TextBlock.help">
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="Opacity" Value="0.75" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Margin" Value="0,4,0,0" />
    </Style>
    <Style Selector="TextBlock.page">
      <Setter Property="FontSize" Value="20" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Margin" Value="0,0,0,4" />
    </Style>
    <Style Selector="TextBlock.intro">
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="Opacity" Value="0.8" />
      <Setter Property="Margin" Value="0,0,0,18" />
    </Style>
    <Style Selector="TabControl.pages > TabItem">
      <Setter Property="FontSize" Value="14" />
      <Setter Property="MinHeight" Value="36" />
      <Setter Property="Padding" Value="14,6" />
    </Style>
  </Window.Styles>

  <Grid RowDefinitions="*,Auto">
    <TabControl Classes="pages" TabStripPlacement="Left" SelectedIndex="{Binding SelectedPage}" Padding="24,16,24,0">

      <!-- 0 Station -->
      <TabItem Header="Station">
        <ScrollViewer>
          <StackPanel>
            <TextBlock Classes="page" Text="Station" />
            <TextBlock Classes="intro" Text="Who you are and where you are. Used in every message you send and to work out distances." />
            <Grid Classes="field" ColumnDefinitions="210,*">
              <TextBlock Classes="label" Text="Station profile" />
              <StackPanel Grid.Column="1" Spacing="6">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <ComboBox ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile}" MinWidth="160" AutomationProperties.Name="Station profile">
                    <ComboBox.ItemTemplate>
                      <DataTemplate x:DataType="vm:ProfileDraft"><TextBlock Text="{Binding Name}" /></DataTemplate>
                    </ComboBox.ItemTemplate>
                  </ComboBox>
                  <Button Content="New profile" Command="{Binding NewProfileCommand}" />
                  <Button Content="Delete" Command="{Binding DeleteProfileCommand}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="8" DataContext="{Binding SelectedProfile}" x:DataType="vm:ProfileDraft">
                  <TextBlock Text="Name" VerticalAlignment="Center" />
                  <TextBox Text="{Binding Name}" Width="160" AutomationProperties.Name="Profile name" />
                </StackPanel>
                <TextBlock Classes="help" Text="Each profile keeps its own callsign, grid, power, radio, audio devices and QRZ logbook key, for example a portable or park setup with a /P call or another grid. A new profile starts as a copy of the one shown. The profile shown when you press Save is the one Costas uses; set its radio and audio in Station setup." />
              </StackPanel>
            </Grid>
            <Grid Classes="field" ColumnDefinitions="210,*">
              <TextBlock Classes="label" Text="Callsign" />
              <StackPanel Grid.Column="1"><TextBox Text="{Binding Callsign}" Width="160" HorizontalAlignment="Left" /></StackPanel>
            </Grid>
            <Grid Classes="field" ColumnDefinitions="210,*">
              <TextBlock Classes="label" Text="Grid square" />
              <StackPanel Grid.Column="1">
                <TextBox Text="{Binding Grid}" Width="120" HorizontalAlignment="Left" />
                <TextBlock Classes="help" Text="4 or 6 characters, for example DN40 or DN40dd." />
              </StackPanel>
            </Grid>
            <Grid Classes="field" ColumnDefinitions="210,*">
              <TextBlock Classes="label" Text="Power (watts)" />
              <StackPanel Grid.Column="1">
                <TextBox Text="{Binding Power}" Width="90" HorizontalAlignment="Left" />
                <TextBlock Classes="help" Text="Recorded in the log when the radio cannot report its own power setting. It does not change the radio's power." />
              </StackPanel>
            </Grid>
            <TextBlock Classes="help" Text="Radio, audio devices and the transmit test are in Station setup (menu ☰)." />
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <!-- 1 Transmitting -->
      <TabItem Header="Transmitting">
        <ScrollViewer>
          <StackPanel>
            <TextBlock Classes="page" Text="Transmitting" />
            <TextBlock Classes="intro" Text="How contacts are run once you start one. Nothing is sent unless you click Call or Call CQ." />
            <Grid Classes="field" ColumnDefinitions="210,*">
              <TextBlock Classes="label" Text="{Binding TxGainLabel}" />
              <StackPanel Grid.Column="1">
                <TextBox Text="{Binding TxGain}" Width="90" HorizontalAlignment="Left" />
                <CheckBox IsChecked="{Binding AutoTxLevel}" Content="Adjust automatically from the radio's ALC" />
                <TextBlock Classes="help" Text="Level of the transmit audio sent to the radio on this band, from -40 to 0. Automatic adjustment changes it between transmissions so the radio's ALC barely moves, and remembers it per band. It rises at most 6 dB above a level you type here. Turn it off to keep the level fixed." />
              </StackPanel>
            </Grid>
            <Grid Classes="field" ColumnDefinitions="210,*">
              <TextBlock Classes="label" Text="CQ" />
              <StackPanel Grid.Column="1">
                <TextBox Text="{Binding CqModifier}" Width="90" MaxLength="4" Watermark="modifier" HorizontalAlignment="Left" />
                <TextBlock Classes="help" Text="Leave the modifier empty for a plain CQ, or use DX, POTA, NA, a number and so on." />
              </StackPanel>
            </Grid>
            <Grid Classes="field" ColumnDefinitions="210,*">
              <TextBlock Classes="label" Text="Answering a CQ" />
              <StackPanel Grid.Column="1">
                <CheckBox IsChecked="{Binding GridInReply}" Content="Send my grid" />
                <TextBlock Classes="help" Text="Without the grid the first message is just their call and yours." />
              </StackPanel>
            </Grid>
            <Grid Classes="field" ColumnDefinitions="210,*">
              <TextBlock Classes="label" Text="Sign-off on my CQ" />
              <StackPanel Grid.Column="1">
                <ComboBox ItemsSource="{Binding Signoffs}" SelectedItem="{Binding Signoff}" MinWidth="110" />
                <TextBlock Classes="help" Text="RR73 ends the contact in one message; RRR waits for the other station's 73." />
              </StackPanel>
            </Grid>
            <Grid Classes="field" ColumnDefinitions="210,*">
              <TextBlock Classes="label" Text="Last message when answering" />
              <StackPanel Grid.Column="1">
                <ComboBox ItemsSource="{Binding AnswerSignoffs}" SelectedItem="{Binding AnswerSignoff}" MinWidth="110" />
                <TextBlock Classes="help" Text="Sent once after their RR73. The contact is already logged by then." />
              </StackPanel>
            </Grid>
            <Grid Classes="field" ColumnDefinitions="210,*">
              <TextBlock Classes="label" Text="Then send free text" />
              <StackPanel Grid.Column="1">
                <TextBox Text="{Binding FreeTextAfter}" Width="160" HorizontalAlignment="Left" MaxLength="13" Watermark="none" />
                <TextBlock Classes="help" Text="Optional, up to 13 characters such as TNX 73 GL. Sent once in your next slot after the last message, unless you start another contact first." />
              </StackPanel>
            </Grid>
            <Grid Classes="field" ColumnDefinitions="210,*">
              <TextBlock Classes="label" Text="What you send" />
              <StackPanel Grid.Column="1">
                <TextBlock Text="{Binding MessagePreview}" FontFamily="Consolas,Menlo,monospace" />
                <TextBlock Text="{Binding MessageProblem}" Foreground="{DynamicResource CriticalBrush}" TextWrapping="Wrap" Margin="0,4,0,0"
                           IsVisible="{Binding MessageProblem, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                <TextBlock Classes="help" Text="The order of the exchange and the reports are fixed by FT8, so only these parts can change." />
              </StackPanel>
            </Grid>
            <Grid Classes="field" ColumnDefinitions="210,*">
              <TextBlock Classes="label" Text="Call CQ in" />
              <StackPanel Grid.Column="1">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <ComboBox ItemsSource="{Binding Parities}" SelectedItem="{Binding CqParity}" MinWidth="110" />
                  <TextBlock Text="slots" VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock Classes="help" Text="Even slots start at :00 and :30, odd slots at :15 and :45." />
              </StackPanel>
            </Grid>
            <Grid Classes="field" ColumnDefinitions="210,*">
              <TextBlock Classes="label" Text="Give up after" />
              <StackPanel Grid.Column="1">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <TextBox Text="{Binding RetryLimit}" Width="70" />
                  <TextBlock Text="tries without an answer" VerticalAlignment="Center" />
                </StackPanel>
              </StackPanel>
            </Grid>
            <Grid Classes="field" ColumnDefinitions="210,*">
              <TextBlock Classes="label" Text="Watchdog" />
              <StackPanel Grid.Column="1">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <TextBox Text="{Binding Watchdog}" Width="70" />
                  <TextBlock Text="minutes" VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock Classes="help" Text="Transmitting stops if you have not touched the app for this long." />
              </StackPanel>
            </Grid>
            <Grid Classes="field" ColumnDefinitions="210,*">
              <TextBlock Classes="label" Text="Clock limit" />
              <StackPanel Grid.Column="1">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <TextBox Text="{Binding ClockBlock}" Width="70" />
                  <TextBlock Text="seconds" VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock Classes="help" Text="Transmitting is blocked when the computer's clock is off by more than this. FT8 needs it within about a second." />
              </StackPanel>
            </Grid>
            <Grid Classes="field" ColumnDefinitions="210,*">
              <TextBlock Classes="label" Text="Clock correction" />
              <StackPanel Grid.Column="1">
                <CheckBox Content="Correct the clock inside Costas from internet time" IsChecked="{Binding CorrectClock}" />
                <TextBlock Classes="help" Text="When the computer's clock is off, Costas times its slots from internet time instead, checked every 15 minutes. Your computer's clock is not changed. Offsets over a minute are not corrected: set the Windows clock and time zone instead." TextWrapping="Wrap" />
              </StackPanel>
            </Grid>
            <Grid Classes="field" ColumnDefinitions="210,*">
              <TextBlock Classes="label" Text="Logging" />
              <CheckBox Grid.Column="1" Content="Log each contact automatically when it completes" IsChecked="{Binding AutoLog}" />
            </Grid>
            <Grid Classes="field" ColumnDefinitions="210,*">
              <TextBlock Classes="label" Text="Calling you" />
              <StackPanel Grid.Column="1" Spacing="4">
                <CheckBox Content="Chime when a new station calls me" IsChecked="{Binding ChimeOnCaller}" />
                <TextBlock Classes="help" Text="Plays on the computer's default speakers, never on the radio's audio device. If the default device is the radio's, the chime stays silent." />
              </StackPanel>
            </Grid>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <!-- 2 Who to call -->
      <TabItem Header="Who to call">
        <ScrollViewer>
          <StackPanel>
            <TextBlock Classes="page" Text="Who to call" />
            <TextBlock Classes="intro" Text="How the Next in line list on the Operate screen is ordered. Stations you need most come first." />
            <Grid Classes="field" ColumnDefinitions="210,*">
              <TextBlock Classes="label" Text="Priority" />
              <StackPanel Grid.Column="1">
                <ItemsControl ItemsSource="{Binding TierOrder}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:TierItem">
                      <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,2">
                        <Button Content="▲" Padding="8,2" ToolTip.Tip="Move up"
                                Command="{Binding $parent[Window].((vm:SettingsViewModel)DataContext).TierUpCommand}" CommandParameter="{Binding}" AutomationProperties.Name="Move up" />
                        <Button Content="▼" Padding="8,2" ToolTip.Tip="Move down"
                                Command="{Binding $parent[Window].((vm:SettingsViewModel)DataContext).TierDownCommand}" CommandParameter="{Binding}" AutomationProperties.Name="Move down" />
                        <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                      </StackPanel>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Classes="help" Text="A station that is a new country for you outranks one that is only a new band, and so on down the list." />
              </StackPanel>
            </Grid>
            <Grid Classes="field" ColumnDefinitions="210,*">
              <TextBlock Classes="label" Text="Options" />
              <StackPanel Grid.Column="1" Spacing="6">
                <CheckBox Content="Rank stations that hear me higher (from PSK Reporter)" IsChecked="{Binding PreferHearsMe}" />
                <CheckBox Content="Only list stations that are calling CQ" IsChecked="{Binding OnlyCallingCq}" />
                <CheckBox Content="Hide stations I have already worked on this band" IsChecked="{Binding HideWorked}" />
                <CheckBox Content="Leave out long shots (signals too weak to likely complete)" IsChecked="{Binding SkipLongShots}" />
                <CheckBox Content="Count a country or state as worked only when confirmed" IsChecked="{Binding ConfirmedOnly}" />
                <CheckBox Content="Count only LoTW confirmations (what DXCC and WAS credit)" IsChecked="{Binding ConfirmedByLotw}" Margin="24,0,0,0" />
                <TextBlock Classes="help" Margin="24,0,0,0" Text="QRZ and eQSL confirmations do not count for DXCC. Turn this off to count QRZ, eQSL and card confirmations too. With only confirmed contacts counting, stations that upload to LoTW rank ahead of those that do not." />
              </StackPanel>
            </Grid>
            <Grid Classes="field" ColumnDefinitions="210,*">
              <TextBlock Classes="label" Text="Parks on the Air" />
              <StackPanel Grid.Column="1">
                <CheckBox Content="Show which park a station is activating (POTA spots)" IsChecked="{Binding PotaSpots}" />
                <CheckBox Content="Rank stations at a park I have not worked higher" IsChecked="{Binding PreferNewParks}" IsEnabled="{Binding PotaSpots}" Margin="24,0,0,0" />
                <TextBlock Classes="help" Text="Reads the public spot list at pota.app every two minutes and shows New park or Park with the reference under Why. A station at a new park comes right after your first need (new countries by default), even if you have worked its call on this band before. A park you work is written to the log." TextWrapping="Wrap" />
              </StackPanel>
            </Grid>
            <Grid Classes="field" ColumnDefinitions="210,*">
              <TextBlock Classes="label" Text="Keep CQ callers listed" />
              <StackPanel Grid.Column="1">
                <ComboBox ItemsSource="{Binding KeepCqCallersChoices}" SelectedItem="{Binding KeepCqCallers}" MinWidth="200"
                          AutomationProperties.Name="Keep CQ callers listed" />
                <TextBlock Classes="help" Text="How long a station calling CQ stays in Next in line after it was last heard, so a missed slot does not drop it. It leaves the list as soon as it is heard working someone else." />
              </StackPanel>
            </Grid>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <!-- 3 Hunt list -->
      <TabItem Header="Hunt list">
        <ScrollViewer>
          <StackPanel>
            <TextBlock Classes="page" Text="Hunt list" />
            <TextBlock Classes="intro" Text="Countries, calls, states and grids you are looking for. When one is heard, a bar at the top of Costas says where, mini mode and the phone page show it, and the chime plays. Costas never changes band or calls anyone by itself: you decide. An entry stops alerting once it is in your log on its band (or on any band, for an any-band entry)." />
            <Grid Classes="field" ColumnDefinitions="210,*">
              <TextBlock Classes="label" Text="Looking for" />
              <StackPanel Grid.Column="1" Spacing="4">
                <TextBlock Classes="help" Text="Nothing on the list yet. Add an entry below, or use Hunt this call in a station's details." IsVisible="{Binding HuntEmpty}" Margin="0,6,0,0" />
                <ItemsControl ItemsSource="{Binding HuntRows}" AutomationProperties.Name="Hunt list">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:HuntRowViewModel">
                      <DockPanel Margin="0,2">
                        <Button DockPanel.Dock="Right" Content="Remove" Padding="8,2" Margin="12,0,0,0" HorizontalAlignment="Right"
                                Command="{Binding $parent[Window].((vm:SettingsViewModel)DataContext).RemoveHuntCommand}" CommandParameter="{Binding}"
                                AutomationProperties.Name="{Binding Text, StringFormat='Remove {0}'}" />
                        <TextBlock Text="{Binding Text}" VerticalAlignment="Center" />
                      </DockPanel>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Grid>
            <Grid Classes="field" ColumnDefinitions="210,*">
              <TextBlock Classes="label" Text="Add" />
              <StackPanel Grid.Column="1" Spacing="4">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <ComboBox ItemsSource="{Binding HuntKinds}" SelectedItem="{Binding HuntKind}" MinWidth="150" AutomationProperties.Name="Kind" />
                  <TextBox Text="{Binding HuntValue}" Width="180" IsVisible="{Binding HuntNeedsValue}" PlaceholderText="KL7, Alaska, VK9XA, TX, FN31"
                           AutomationProperties.Name="What to look for" />
                  <ComboBox ItemsSource="{Binding HuntBands}" SelectedItem="{Binding HuntBand}" MinWidth="110" AutomationProperties.Name="Band" />
                  <Button Content="Add" Command="{Binding AddHuntCommand}" />
                </StackPanel>
                <TextBlock Classes="help" Text="{Binding HuntError}" Foreground="{DynamicResource CriticalBrush}"
                           IsVisible="{Binding HuntError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                <TextBlock Classes="help" Text="A country by prefix or name (KL7 or Alaska), a call, a US state (TX or Texas), a 4-character grid, or any country you have not worked." />
              </StackPanel>
            </Grid>
            <Grid Classes="field" ColumnDefinitions="210,*">
              <TextBlock Classes="label" Text="Every band" />
              <StackPanel Grid.Column="1">
                <CheckBox Content="Also watch the bands I am not on, through PSK Reporter" IsChecked="{Binding HuntAllBands}" />
                <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,6,0,0" IsEnabled="{Binding HuntAllBands}">
                  <TextBlock Text="Count receivers within" VerticalAlignment="Center" />
                  <TextBox Text="{Binding HuntNearby}" Width="70" AutomationProperties.Name="Distance" />
                  <TextBlock Text="{Binding HuntNearbyUnit}" VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock Classes="help" Text="Countries and calls on your list are followed on every band in PSK Reporter's live feed. An alert needs a receiver this close to you to have heard the station in the last 15 minutes, so the station is likely workable from here. States and grids are only matched in your own decodes. Needs PSK Reporter's live feed (PSK Reporter page)." />
              </StackPanel>
            </Grid>
            <Grid Classes="field" ColumnDefinitions="210,*">
              <TextBlock Classes="label" Text="Alert" />
              <StackPanel Grid.Column="1">
                <CheckBox Content="Play the chime and flash Costas in the taskbar" IsChecked="{Binding HuntSound}" />
                <TextBlock Classes="help" Text="Each entry alerts once per band, then stays quiet there for 30 minutes. The chime plays on the computer's default speakers, never on the radio's audio device." />
              </StackPanel>
            </Grid>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <!-- 3 QRZ -->
      <TabItem Header="QRZ">
        <ScrollViewer>
          <StackPanel>
            <TextBlock Classes="page" Text="QRZ" />
            <TextBlock Classes="intro" Text="QRZ has two separate services, and each needs its own sign-in. The logbook API key opens your logbook only: what you have worked and confirmed, and uploading new contacts. Looking up other stations' names and locations goes through QRZ's XML callsign service, which does not accept the API key and needs your QRZ username and password. Both are optional." />
            <Grid Classes="field" ColumnDefinitions="210,*">
              <TextBlock Classes="label" Text="Logbook API key" />
              <StackPanel Grid.Column="1">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <TextBox Text="{Binding LogbookKey}" Width="260" PasswordChar="•" PlaceholderText="XXXX-XXXX-XXXX-XXXX" />
                  <Button Content="Test key" Command="{Binding TestKeyCommand}" />
                </StackPanel>
                <TextBlock Classes="help" Text="{Binding KeyStatus}" IsVisible="{Binding KeyStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                <TextBlock Classes="help" Text="Find it in your QRZ Logbook: open the logbook's Settings and copy its API access key." />
                <Button Classes="link" Command="{Binding OpenQrzCommand}" Padding="0" Margin="0,4,0,0">
                  <TextBlock Text="Open the QRZ Logbook" />
                </Button>
              </StackPanel>
            </Grid>
            <Grid Classes="field" ColumnDefinitions="210,*">
              <TextBlock Classes="label" Text="Sync" />
              <StackPanel Grid.Column="1" Spacing="6">
                <CheckBox Content="Read my logbook and upload new contacts" IsChecked="{Binding LogbookEnabled}" />
                <CheckBox Content="Upload each contact as soon as it is logged" IsChecked="{Binding UploadOnComplete}" IsEnabled="{Binding LogbookEnabled}" />
                <StackPanel Orientation="Horizontal" Spacing="8" IsEnabled="{Binding LogbookEnabled}">
                  <TextBlock Text="Check for changes every" VerticalAlignment="Center" />
                  <TextBox Text="{Binding SyncMinutes}" Width="70" />
                  <TextBlock Text="minutes" VerticalAlignment="Center" />
                </StackPanel>
              </StackPanel>
            </Grid>
            <Grid Classes="field" ColumnDefinitions="210,*">
              <TextBlock Classes="label" Text="Callsign lookups" />
              <StackPanel Grid.Column="1" Spacing="6">
                <TextBox Text="{Binding QrzUser}" Width="260" HorizontalAlignment="Left" PlaceholderText="QRZ username" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <TextBox Text="{Binding QrzPassword}" Width="260" PasswordChar="•" PlaceholderText="QRZ password" />
                  <Button Content="Test login" Command="{Binding TestLookupCommand}" />
                </StackPanel>
                <TextBlock Classes="help" Text="{Binding LookupStatus}" IsVisible="{Binding LookupStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                <TextBlock Classes="help" Text="Shows the name, city and state of the station you select or are working, and fills them in on logged contacts. The logbook API key cannot do this: QRZ only answers lookups for a signed-in user. Full details need a QRZ XML subscription; without one QRZ returns fewer fields. Leave both blank to turn lookups off." />
              </StackPanel>
            </Grid>
            <TextBlock Classes="help" Text="{Binding SecretsNote}" />
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <!-- LoTW -->
      <TabItem Header="LoTW">
        <ScrollViewer>
          <StackPanel>
            <TextBlock Classes="page" Text="LoTW" />
            <TextBlock Classes="intro" Text="ARRL's Logbook of the World is where DXCC and WAS credit comes from. Costas downloads your LoTW confirmations with your LoTW website login, and uploads your contacts through TQSL, which signs them with your callsign certificate. Both are optional." />
            <Grid Classes="field" ColumnDefinitions="210,*">
              <TextBlock Classes="label" Text="Confirmations" />
              <StackPanel Grid.Column="1" Spacing="6">
                <CheckBox Content="Download my LoTW confirmations" IsChecked="{Binding LotwEnabled}" />
                <TextBox Text="{Binding LotwUser}" Width="260" HorizontalAlignment="Left" PlaceholderText="LoTW login (usually your call)" IsEnabled="{Binding LotwEnabled}" />
                <TextBox Text="{Binding LotwPassword}" Width="260" HorizontalAlignment="Left" PasswordChar="•" PlaceholderText="LoTW website password" IsEnabled="{Binding LotwEnabled}" />
                <TextBlock Classes="help" Text="The website password, not the TQSL certificate password. Costas checks for new confirmations every 12 hours, and when you choose Download new confirmations in the Log view. A confirmation for a contact missing from your log adds it." />
              </StackPanel>
            </Grid>
            <Grid Classes="field" ColumnDefinitions="210,*">
              <TextBlock Classes="label" Text="Uploads (TQSL)" />
              <StackPanel Grid.Column="1" Spacing="6">
                <TextBox Text="{Binding TqslPath}" Width="420" HorizontalAlignment="Left" PlaceholderText="Leave blank to find TQSL in its usual folder" />
                <TextBlock Classes="help" Text="{Binding TqslFound}" />
                <TextBox Text="{Binding StationLocation}" Width="260" HorizontalAlignment="Left" PlaceholderText="TQSL Station Location" Margin="0,6,0,0" />
                <TextBlock Classes="help" Text="The Station Location name exactly as it is in TQSL. Leave blank if TQSL has only one." />
                <CheckBox Content="Sign and upload each contact as soon as it is logged" IsChecked="{Binding LotwUploadOnComplete}" Margin="0,6,0,0" />
                <TextBlock Classes="help" Text="Otherwise use Upload new contacts with TQSL in the Log view. TQSL skips contacts LoTW already has. Your certificate must not have a password, or TQSL will ask for it." />
              </StackPanel>
            </Grid>
            <Grid Classes="field" ColumnDefinitions="210,*">
              <TextBlock Classes="label" Text="Who uses LoTW" />
              <StackPanel Grid.Column="1">
                <CheckBox Content="Download ARRL's list of LoTW users once a week" IsChecked="{Binding LotwUserList}" />
                <TextBlock Classes="help" Text="Shows Uses LoTW in station details and the Why tooltip, and ranks LoTW users ahead when only confirmed contacts count. About 6 MB; no login needed." />
              </StackPanel>
            </Grid>
            <TextBlock Classes="help" Text="{Binding SecretsNote}" />
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <!-- 4 PSK Reporter -->
      <TabItem Header="PSK Reporter">
        <ScrollViewer>
          <StackPanel>
            <TextBlock Classes="page" Text="PSK Reporter" />
            <TextBlock Classes="intro" Text="PSK Reporter collects reports of who hears whom. It powers the Reach view and the Hears you column." />
            <Grid Classes="field" ColumnDefinitions="210,*">
              <TextBlock Classes="label" Text="Who hears me" />
              <StackPanel Grid.Column="1">
                <CheckBox Content="Receive live reports of stations hearing my signal" IsChecked="{Binding FeedEnabled}" />
                <CheckBox Content="Compare my signal with stations near me" IsChecked="{Binding CompareNeighbours}" IsEnabled="{Binding FeedEnabled}" />
                <TextBlock Classes="help" Text="Also receives reports of stations within 300 miles on your band, so the Reach view can show where you are stronger or weaker than them." TextWrapping="Wrap" />
                <CheckBox Content="Show band activity near me in Reach and the band menu" IsChecked="{Binding BandActivity}" IsEnabled="{Binding FeedEnabled}" Margin="0,8,0,0" />
                <TextBlock Classes="help" Text="Receives reports of stations within 300 miles on every band, so Reach and the band menu show which bands are open from your area and where they are heard." TextWrapping="Wrap" />
              </StackPanel>
            </Grid>
            <Grid Classes="field" ColumnDefinitions="210,*">
              <TextBlock Classes="label" Text="Share what I hear" />
              <StackPanel Grid.Column="1">
                <CheckBox Content="Send the stations I decode to PSK Reporter" IsChecked="{Binding UploadSpots}" />
                <TextBlock Classes="help" Text="Helps other operators see where their signals reach. Sent every few minutes; never in simulation." />
              </StackPanel>
            </Grid>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <!-- 5 Other programs -->
      <TabItem Header="Other programs">
        <ScrollViewer>
          <StackPanel>
            <TextBlock Classes="page" Text="Other programs" />
            <TextBlock Classes="intro" Text="Share decodes and logged contacts with GridTracker, JTAlert, N1MM+ and loggers that understand WSJT-X." />
            <Grid Classes="field" ColumnDefinitions="210,*">
              <TextBlock Classes="label" Text="WSJT-X UDP" />
              <StackPanel Grid.Column="1" Spacing="6">
                <CheckBox Content="Send decodes, status and logged contacts" IsChecked="{Binding UdpEnabled}" />
                <StackPanel Orientation="Horizontal" Spacing="8" IsEnabled="{Binding UdpEnabled}">
                  <TextBlock Text="Address" VerticalAlignment="Center" />
                  <TextBox Text="{Binding UdpAddress}" Width="150" />
                  <TextBlock Text="Port" VerticalAlignment="Center" />
                  <TextBox Text="{Binding UdpPort}" Width="80" />
                </StackPanel>
                <TextBlock Classes="help" Text="The defaults (127.0.0.1, port 2237) work with GridTracker and JTAlert on this computer." />
              </StackPanel>
            </Grid>
            <Grid Classes="field" ColumnDefinitions="210,*">
              <TextBlock Classes="label" Text="Save received audio" />
              <StackPanel Grid.Column="1">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <ComboBox ItemsSource="{Binding WavChoices}" SelectedItem="{Binding SaveWav}" MinWidth="110" />
                  <TextBlock Text="keep for" VerticalAlignment="Center" />
                  <TextBox Text="{Binding Retention}" Width="70" />
                  <TextBlock Text="days" VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock Classes="help" Text="Saves each 15-second slot as a WAV file: none, only slots with decodes, or all. Useful for checking reception later." />
              </StackPanel>
            </Grid>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <!-- Mobile connection -->
      <TabItem Header="Mobile connection">
        <ScrollViewer>
          <StackPanel>
            <TextBlock Classes="page" Text="Mobile connection" />
            <TextBlock Classes="intro" Text="Operate from a phone on your home network: see the contact, who is calling you and Next in line, call stations, call CQ and halt transmit. The phone opens a page in its browser; nothing to install." />
            <Grid Classes="field" ColumnDefinitions="210,*">
              <TextBlock Classes="label" Text="Mobile connection" />
              <StackPanel Grid.Column="1" Spacing="6">
                <CheckBox Content="Let a paired phone on this network operate the station" IsChecked="{Binding RemoteEnabled}" />
                <TextBlock Classes="help" Text="{Binding RemoteStatus}" />
                <TextBlock Classes="help" IsVisible="{Binding RemoteEnabled}"
                           Text="If Windows asks whether Costas may use the network, choose Allow for private networks. Phones cannot connect until you do. Addresses outside your home network are always refused." />
              </StackPanel>
            </Grid>

            <!-- The pairing code, large enough to read from across the desk while typing it on the phone. -->
            <Border IsVisible="{Binding HasPairingCode}" Margin="0,4,0,16" Padding="20,16" CornerRadius="8" BorderThickness="2"
                    BorderBrush="{DynamicResource AccentBrush}" Background="{DynamicResource CardBackgroundBrush}">
              <StackPanel Spacing="10">
                <TextBlock Text="Pair a phone" FontSize="18" FontWeight="SemiBold" />
                <StackPanel Spacing="2">
                  <TextBlock Classes="help" Text="1. On the phone, open" />
                  <SelectableTextBlock Text="{Binding PairingUrl}" FontSize="22" FontWeight="SemiBold" />
                  <TextBlock Classes="help" Text="{Binding PairingOtherUrls}" IsVisible="{Binding PairingOtherUrls, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                </StackPanel>
                <StackPanel Spacing="2">
                  <TextBlock Classes="help" Text="2. Type this code" />
                  <SelectableTextBlock Text="{Binding PairingCode}" FontSize="56" FontWeight="Bold" FontFamily="Consolas,Menlo,monospace"
                                       LetterSpacing="4" Foreground="{DynamicResource AccentBrush}" />
                  <TextBlock Classes="help" Text="{Binding PairingExpiry}" />
                </StackPanel>
                <Button Content="New code" Command="{Binding PairPhoneCommand}" HorizontalAlignment="Left" />
              </StackPanel>
            </Border>

            <Grid Classes="field" ColumnDefinitions="210,*" IsVisible="{Binding RemoteEnabled}">
              <TextBlock Classes="label" Text="Phones" />
              <StackPanel Grid.Column="1" Spacing="6">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <Button Content="Pair a phone" Command="{Binding PairPhoneCommand}" IsEnabled="{Binding RemoteRunning}" IsVisible="{Binding !HasPairingCode}" />
                  <Button Content="{Binding ForgetPhonesText}" Command="{Binding ForgetPhonesCommand}" IsVisible="{Binding HasPairedPhones}" />
                </StackPanel>
                <TextBlock Classes="help" Text="{Binding PairingNote}" IsVisible="{Binding PairingNote, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                <TextBlock Classes="help" Text="A paired phone stays paired until you forget it here. The code only works while this window is open." />
              </StackPanel>
            </Grid>
            <Grid Classes="field" ColumnDefinitions="210,*">
              <TextBlock Classes="label" Text="Port" />
              <StackPanel Grid.Column="1" Spacing="6">
                <TextBox Text="{Binding RemotePort}" Width="80" HorizontalAlignment="Left" />
                <TextBlock Classes="help" Text="Change it only if another program uses 8073. A new port takes effect when you save." />
              </StackPanel>
            </Grid>
            <Grid Classes="field" ColumnDefinitions="210,*">
              <TextBlock Classes="label" Text="Safety" />
              <StackPanel Grid.Column="1" Spacing="6">
                <TextBlock Classes="help" Text="A phone takes control when it sends a command; a click or key press here takes it back. While a phone has control, transmit stops if the phone loses touch for 15 seconds (screen locked, browser closed, Wi-Fi lost), and the Tx watchdog is at most 3 minutes. Keep the page open on screen while you operate." />
              </StackPanel>
            </Grid>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <!-- 6 Appearance -->
      <TabItem Header="Appearance">
        <ScrollViewer>
          <StackPanel>
            <TextBlock Classes="page" Text="Appearance" />
            <TextBlock Classes="intro" Text="How the app looks." />
            <Grid Classes="field" ColumnDefinitions="210,*">
              <TextBlock Classes="label" Text="Skin" />
              <StackPanel Grid.Column="1" Spacing="6">
                <ComboBox ItemsSource="{Binding Skins}" SelectedItem="{Binding Skin}" MinWidth="160" AutomationProperties.Name="Skin">
                  <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="services:AppSkin"><TextBlock Text="{Binding Name}" /></DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
                <TextBlock Classes="help" Text="{Binding Skin.Description}" />
                <Grid ColumnDefinitions="*,*" ColumnSpacing="8" Margin="0,4,0,0">
                  <Border Background="{Binding Skin.Light.WindowBrush}" Padding="10" CornerRadius="6" BorderThickness="1" BorderBrush="{Binding Skin.Light.SecondaryBrush}">
                    <StackPanel Spacing="8">
                      <TextBlock Text="Light" Foreground="{Binding Skin.Light.SecondaryBrush}" FontSize="12" />
                      <Border Background="{Binding Skin.Light.CardBrush}" Padding="8" CornerRadius="{Binding Skin.PreviewCornerRadius}">
                        <StackPanel Spacing="6">
                          <TextBlock Text="{Binding Skin.PreviewTitle}" FontFamily="{Binding Skin.PreviewFont}" Foreground="{Binding Skin.Light.TextBrush}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" IsVisible="{Binding Skin.HasPlainPreview}" />
                          <Border Background="#111A0B" Padding="4" IsVisible="{Binding Skin.HasSegmentedDisplay}">
                            <v:SegmentedDisplay Text="14.074.000" DigitHeight="22" AutomationProperties.Name="Example frequency 14.074 MHz" />
                          </Border>
                          <Border Background="{Binding Skin.Light.SelectionBrush}" Height="12" CornerRadius="2" />
                          <Border Background="{Binding Skin.Light.AccentBrush}" Height="6" Width="40" HorizontalAlignment="Left" CornerRadius="2" />
                        </StackPanel>
                      </Border>
                    </StackPanel>
                  </Border>
                  <Border Grid.Column="1" Background="{Binding Skin.Dark.WindowBrush}" Padding="10" CornerRadius="6" BorderThickness="1" BorderBrush="{Binding Skin.Dark.SecondaryBrush}">
                    <StackPanel Spacing="8">
                      <TextBlock Text="Dark" Foreground="{Binding Skin.Dark.SecondaryBrush}" FontSize="12" />
                      <Border Background="{Binding Skin.Dark.CardBrush}" Padding="8" CornerRadius="{Binding Skin.PreviewCornerRadius}">
                        <StackPanel Spacing="6">
                          <TextBlock Text="{Binding Skin.PreviewTitle}" FontFamily="{Binding Skin.PreviewFont}" Foreground="{Binding Skin.Dark.TextBrush}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" IsVisible="{Binding Skin.HasPlainPreview}" />
                          <Border Background="#111A0B" Padding="4" IsVisible="{Binding Skin.HasSegmentedDisplay}">
                            <v:SegmentedDisplay Text="14.074.000" DigitHeight="22" AutomationProperties.Name="Example frequency 14.074 MHz" />
                          </Border>
                          <Border Background="{Binding Skin.Dark.SelectionBrush}" Height="12" CornerRadius="2" />
                          <Border Background="{Binding Skin.Dark.AccentBrush}" Height="6" Width="40" HorizontalAlignment="Left" CornerRadius="2" />
                        </StackPanel>
                      </Border>
                    </StackPanel>
                  </Border>
                </Grid>
                <TextBlock Classes="help" Text="Save applies the skin to all desktop windows. Transmit and warning colors stay the same." />
              </StackPanel>
            </Grid>
            <Grid Classes="field" ColumnDefinitions="210,*">
              <TextBlock Classes="label" Text="Theme" />
              <StackPanel Grid.Column="1">
                <ComboBox ItemsSource="{Binding Themes}" SelectedItem="{Binding Theme}" MinWidth="120" />
                <TextBlock Classes="help" Text="System follows your device's light or dark setting. Every skin supports both." />
              </StackPanel>
            </Grid>
            <Grid Classes="field" ColumnDefinitions="210,*">
              <TextBlock Classes="label" Text="Distances in" />
              <ComboBox Grid.Column="1" ItemsSource="{Binding UnitChoices}" SelectedItem="{Binding Units}" MinWidth="120" />
            </Grid>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <!-- 7 Updates -->
      <TabItem Header="Updates">
        <ScrollViewer>
          <StackPanel>
            <TextBlock Classes="page" Text="Updates" />
            <TextBlock Classes="intro" Text="New builds are published on GitHub. When one is available, a bar at the top of the main window offers to install it." />
            <Grid Classes="field" ColumnDefinitions="210,*">
              <TextBlock Classes="label" Text="Automatic check" />
              <CheckBox Grid.Column="1" Content="Check for a new build once a day" IsChecked="{Binding CheckUpdates}" />
            </Grid>
            <Grid Classes="field" ColumnDefinitions="210,*">
              <TextBlock Classes="label" Text="Check now" />
              <StackPanel Grid.Column="1">
                <Button Content="Check now" Command="{Binding CheckNowCommand}" />
                <TextBlock Classes="help" Text="{Binding UpdateStatus}" />
              </StackPanel>
            </Grid>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <!-- 8 Advanced -->
      <!-- Privacy: anonymous usage statistics (opt-out) -->
      <TabItem Header="Privacy">
        <ScrollViewer>
          <StackPanel>
            <TextBlock Classes="page" Text="Privacy" />
            <TextBlock Classes="intro" Text="Costas can send anonymous usage counts to Aptabase so its developer can see how many people use it and which features matter. Nothing is sent while your computer is offline." />
            <Grid Classes="field" ColumnDefinitions="210,*">
              <TextBlock Classes="label" Text="Usage statistics" />
              <StackPanel Grid.Column="1">
                <CheckBox Content="Send anonymous usage statistics" IsChecked="{Binding UsageEnabled}" />
                <TextBlock Classes="help" Text="Sent: the Costas version, Windows or Linux, band and mode, the kind of radio connection and Hamlib model number, which views and features you use, and when a contact is logged. Never sent: your callsign, grid, name, frequencies, the stations you work, or anything from your log. No account or tracking id; each run of Costas is a separate anonymous session." />
                <TextBlock Classes="help" Text="{Binding UsageBuildNote}" IsVisible="{Binding UsageBuildNote, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
              </StackPanel>
            </Grid>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="Advanced">
        <ScrollViewer>
          <StackPanel>
            <TextBlock Classes="page" Text="Advanced" />
            <TextBlock Classes="intro" Text="The app finds its decoder and radio control programs by itself. Set these only to use a different copy." />
            <Grid Classes="field" ColumnDefinitions="210,*">
              <TextBlock Classes="label" Text="jt9 decoder" />
              <StackPanel Grid.Column="1">
                <TextBox Text="{Binding Jt9Path}" PlaceholderText="Found automatically" />
                <TextBlock Classes="help" Text="Full path to jt9.exe from WSJT-X." />
              </StackPanel>
            </Grid>
            <Grid Classes="field" ColumnDefinitions="210,*">
              <TextBlock Classes="label" Text="Hamlib folder" />
              <StackPanel Grid.Column="1">
                <TextBox Text="{Binding HamlibDir}" PlaceholderText="Found automatically" />
                <TextBlock Classes="help" Text="Folder containing rigctld.exe." />
              </StackPanel>
            </Grid>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <!-- 9 Developer (hidden unless developer mode is on) -->
      <TabItem Header="Developer" IsVisible="{Binding ShowDeveloper}">
        <ScrollViewer>
          <StackPanel>
            <TextBlock Classes="page" Text="Developer" />
            <TextBlock Classes="intro" Text="Test tools. To test against Hamlib's test radio, choose Hamlib Dummy in Station setup; transmit audio is never played while a test radio is selected. Replay changes apply after a restart." />
            <Grid Classes="field" ColumnDefinitions="210,*">
              <TextBlock Classes="label" Text="Replay" />
              <StackPanel Grid.Column="1" Spacing="6">
                <CheckBox Content="Replay the sample recordings instead of the sound card" IsChecked="{Binding ReplaySamples}" />
                <CheckBox Content="A simulated station answers my calls" IsChecked="{Binding SimulatedPartner}" IsEnabled="{Binding ReplaySamples}" />
              </StackPanel>
            </Grid>
            <Grid Classes="field" ColumnDefinitions="210,*">
              <TextBlock Classes="label" Text="Developer mode" />
              <CheckBox Grid.Column="1" Content="On (untick to hide this page)" IsChecked="{Binding DeveloperMode}" />
            </Grid>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
      <TabItem Header="eQSL">
        <ScrollViewer>
          <StackPanel>
            <TextBlock Classes="page" Text="eQSL" />
            <TextBlock Classes="intro" Text="Send newly logged contacts to eQSL.cc. Uploads are optional, run in the background and retry when eQSL is unavailable. These settings belong to the current station profile." />
            <Grid Classes="field" ColumnDefinitions="210,*">
              <TextBlock Classes="label" Text="Account" />
              <StackPanel Grid.Column="1" Spacing="6">
                <TextBox Text="{Binding EqslUser}" Width="260" HorizontalAlignment="Left" PlaceholderText="eQSL username" />
                <TextBox Text="{Binding EqslPassword}" Width="260" HorizontalAlignment="Left" PasswordChar="•" PlaceholderText="eQSL password" />
                <TextBlock Classes="help" Text="{Binding SecretsNote}" />
              </StackPanel>
            </Grid>
            <Grid Classes="field" ColumnDefinitions="210,*">
              <TextBlock Classes="label" Text="QTH nickname" />
              <StackPanel Grid.Column="1">
                <TextBox Text="{Binding EqslQthNickname}" Width="260" HorizontalAlignment="Left" />
                <TextBlock Classes="help" Text="Copy the nickname from your eQSL account for this callsign and location. Leave blank only if your account has a single matching QTH." />
              </StackPanel>
            </Grid>
            <CheckBox Content="Upload each new contact to eQSL as soon as it is logged" IsChecked="{Binding EqslUploadOnComplete}" />
            <CheckBox Content="Read my eQSL inbox and sync confirmations hourly" IsChecked="{Binding EqslSyncEnabled}" />
            <Button Content="Sync inbox now / test login" Command="{Binding SyncEqslCommand}" HorizontalAlignment="Left" />
            <TextBlock Classes="help" Text="{Binding EqslSyncStatus}" />
            <TextBlock Classes="help" Text="Save to apply automatic sync and uploads. Incoming cards confirm matching contacts in your local log. Unmatched cards stay in your inbox below. Simulation never contacts eQSL." />
            <TextBlock Text="Recent inbox cards (up to 100)" FontWeight="SemiBold" Margin="0,12,0,4" />
            <ItemsControl ItemsSource="{Binding EqslInboxCards}" />
          </StackPanel>
        </ScrollViewer>
      </TabItem>
    </TabControl>

    <Border Grid.Row="1" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="0,1,0,0">
      <DockPanel Margin="20,12">
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8">
          <Button Content="Cancel" Command="{Binding CancelCommand}" />
          <Button Content="Save" Command="{Binding SaveCommand}" Classes="accent" MinWidth="80" />
        </StackPanel>
        <TextBlock Text="{Binding Message}" Foreground="{DynamicResource CriticalBrush}" VerticalAlignment="Center" TextWrapping="Wrap" />
      </DockPanel>
    </Border>
  </Grid>
</Window>
