<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Ft8Client.App.ViewModels"
        xmlns:v="using:Ft8Client.App.Views"
        xmlns:rig="using:Ft8Client.Rig"
        x:Class="Ft8Client.App.Views.SetupWindow"
        x:DataType="vm:SetupViewModel"
        Title="Set up Costas" Width="860" Height="600" WindowStartupLocation="CenterOwner">
  <Grid ColumnDefinitions="200,*" RowDefinitions="*,Auto">
    <Border Grid.RowSpan="2" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="0,0,1,0">
      <ListBox ItemsSource="{Binding Steps}" SelectedIndex="{Binding Step}" Background="Transparent" Margin="8,16" IsEnabled="False">
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="x:String"><TextBlock Text="{Binding}" Margin="8,6" /></DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </Border>
    <ScrollViewer Grid.Column="1" Margin="24,20,24,0">
      <StackPanel Spacing="10">
        <!-- 1 Station -->
        <StackPanel Spacing="8" IsVisible="{Binding Step, Converter={x:Static v:Converters.IntEquals}, ConverterParameter=0}">
          <TextBlock Text="Your station" FontSize="20" FontWeight="SemiBold" />
          <TextBlock Text="Callsign" /><TextBox Text="{Binding Callsign}" Width="200" HorizontalAlignment="Left" />
          <TextBlock Text="Grid (4 or 6 characters)" /><TextBox Text="{Binding Grid}" Width="200" HorizontalAlignment="Left" />
          <CheckBox Content="Show distances in kilometres (miles otherwise)" IsChecked="{Binding UnitsKm}" />
        </StackPanel>
        <!-- 2 Radio -->
        <StackPanel Spacing="14" IsVisible="{Binding Step, Converter={x:Static v:Converters.IntEquals}, ConverterParameter=1}">
          <TextBlock Text="Your radio" FontSize="20" FontWeight="SemiBold" />
          <TextBlock Classes="secondary" TextWrapping="Wrap"
                     Text="Choose your radio so the app can set its frequency and key it for transmit. Not connected yet? Press Next and come back from ☰ › Station setup." />
          <CheckBox Content="My radio has no CAT control: use audio and VOX only" IsChecked="{Binding AudioOnly}" />
          <Grid ColumnDefinitions="130,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto" RowSpacing="10" IsEnabled="{Binding !AudioOnly}">
            <TextBlock Grid.Row="0" Text="Manufacturer" VerticalAlignment="Center" />
            <ComboBox Grid.Row="0" Grid.Column="1" ItemsSource="{Binding Manufacturers}" SelectedItem="{Binding Manufacturer}" Width="300"
                      PlaceholderText="Choose…" MaxDropDownHeight="360" />
            <TextBlock Grid.Row="1" Text="Model" VerticalAlignment="Center" />
            <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding Models}" SelectedItem="{Binding Model}" Width="300"
                      PlaceholderText="Choose…" MaxDropDownHeight="360">
              <ComboBox.ItemTemplate><DataTemplate x:DataType="rig:HamlibModel"><TextBlock Text="{Binding Model}" /></DataTemplate></ComboBox.ItemTemplate>
            </ComboBox>
            <TextBlock Grid.Row="2" Text="Port" VerticalAlignment="Center" />
            <ComboBox Grid.Row="2" Grid.Column="1" ItemsSource="{Binding Ports}" SelectedItem="{Binding Port}" Width="300" PlaceholderText="Find automatically" />
            <TextBlock Grid.Row="3" Text="Speed (baud)" VerticalAlignment="Center" />
            <ComboBox Grid.Row="3" Grid.Column="1" ItemsSource="{Binding BaudChoices}" SelectedItem="{Binding BaudChoice}" Width="300" />
            <TextBlock Grid.Row="4" Text="Transmit (PTT)" VerticalAlignment="Center" />
            <ComboBox Grid.Row="4" Grid.Column="1" ItemsSource="{Binding PttChoices}" SelectedItem="{Binding PttChoice}" Width="300" />
          </Grid>
          <StackPanel Orientation="Horizontal" Spacing="12" IsEnabled="{Binding !AudioOnly}">
            <Button Content="Test connection" Command="{Binding ScanCommand}" IsEnabled="{Binding !Busy}" Margin="130,0,0,0" />
            <TextBlock VerticalAlignment="Center" IsVisible="{Binding Readback, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
              <Run Text="Connected: the radio is on " /><Run Text="{Binding Readback}" FontWeight="SemiBold" />
            </TextBlock>
          </StackPanel>
        </StackPanel>
        <!-- 3 Audio -->
        <StackPanel Spacing="8" IsVisible="{Binding Step, Converter={x:Static v:Converters.IntEquals}, ConverterParameter=2}">
          <TextBlock Text="Audio" FontSize="20" FontWeight="SemiBold" />
          <TextBlock Text="Input (audio from the radio)" />
          <ComboBox ItemsSource="{Binding Inputs}" SelectedItem="{Binding Input}" MinWidth="320" />
          <TextBlock Text="Output (audio to the radio)" />
          <ComboBox ItemsSource="{Binding Outputs}" SelectedItem="{Binding Output}" MinWidth="320" />
          <TextBlock Text="Choose the radio's USB audio device, not the computer's speakers. The app never uses the default device by itself." Classes="secondary" TextWrapping="Wrap" />
          <TextBlock Classes="secondary" TextWrapping="Wrap" Text="Not ready? Press Next; audio can be chosen later from ☰ › Station setup." />
        </StackPanel>
        <!-- 4 Transmit test -->
        <StackPanel Spacing="8" IsVisible="{Binding Step, Converter={x:Static v:Converters.IntEquals}, ConverterParameter=3}">
          <TextBlock Text="Transmit test" FontSize="20" FontWeight="SemiBold" />
          <TextBlock TextWrapping="Wrap" Text="This sends a steady tone for 2 seconds so you can check that the radio keys and the power meter moves. Connect a dummy load or turn the power down first. Nothing is sent unless you press the button." />
          <Button Content="Send test tone" Command="{Binding SendTestToneCommand}" HorizontalAlignment="Left" />
          <CheckBox Content="The radio transmitted" IsChecked="{Binding ToneConfirmed}" />
        </StackPanel>
        <!-- 5 Clock -->
        <StackPanel Spacing="8" IsVisible="{Binding Step, Converter={x:Static v:Converters.IntEquals}, ConverterParameter=4}">
          <TextBlock Text="Clock check" FontSize="20" FontWeight="SemiBold" />
          <TextBlock Text="FT8 needs your clock within about a second. The app measures it against internet time; it never changes your clock." TextWrapping="Wrap" />
          <TextBlock Text="{Binding ClockResult}" FontWeight="SemiBold" TextWrapping="Wrap" />
        </StackPanel>
        <!-- 6 QRZ -->
        <StackPanel Spacing="8" IsVisible="{Binding Step, Converter={x:Static v:Converters.IntEquals}, ConverterParameter=5}">
          <TextBlock Text="QRZ and PSK Reporter" FontSize="20" FontWeight="SemiBold" />
          <TextBlock Text="QRZ logbook API key (optional)" FontWeight="SemiBold" />
          <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBox Text="{Binding LogbookKey}" Width="260" PasswordChar="•" PlaceholderText="XXXX-XXXX-XXXX-XXXX" />
            <Button Content="Test key" Command="{Binding TestKeyCommand}" />
          </StackPanel>
          <TextBlock Classes="secondary" TextWrapping="Wrap" Text="With it, the app knows what you have worked and confirmed, and uploads new contacts. Find it in your QRZ Logbook: open the logbook's Settings and copy its API access key." />
          <Button Classes="link" Command="{Binding OpenQrzCommand}" Padding="0"><TextBlock Text="Open the QRZ Logbook" /></Button>
          <TextBlock Text="QRZ username and password for callsign lookups (optional)" FontWeight="SemiBold" Margin="0,8,0,0" />
          <TextBox Text="{Binding QrzUser}" Width="260" HorizontalAlignment="Left" PlaceholderText="QRZ username" />
          <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBox Text="{Binding QrzPassword}" Width="260" PasswordChar="•" PlaceholderText="QRZ password" />
            <Button Content="Test login" Command="{Binding TestLookupCommand}" />
          </StackPanel>
          <TextBlock Classes="secondary" TextWrapping="Wrap" Text="Shows the name, city and state of the stations you work. The API key above opens your logbook only; QRZ's callsign lookups need you to sign in with your username and password." />
          <CheckBox Content="Upload the stations I hear to PSK Reporter" IsChecked="{Binding UploadSpots}" />
          <TextBlock Text="{Binding SyncProgress}" Classes="secondary" />
        </StackPanel>
        <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Foreground="{DynamicResource AccentTextBrush}" />
      </StackPanel>
    </ScrollViewer>
    <StackPanel Grid.Column="1" Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="24,12">
      <Button Content="Skip" Command="{Binding SkipCommand}" IsVisible="{Binding CanSkip}" />
      <Button Content="Back" Command="{Binding BackCommand}" IsEnabled="{Binding CanBack}" />
      <Button Content="{Binding NextText}" Command="{Binding NextCommand}" Classes="accent" MinWidth="90" />
    </StackPanel>
  </Grid>
</Window>
