<!-- Detailed station facts below the contact's horizontal conversation. -->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Ft8Client.App.ViewModels"
             xmlns:v="using:Ft8Client.App.Views"
             x:Class="Ft8Client.App.Views.StationInfoStrip"
             x:DataType="vm:StationDetailsViewModel">
  <Border Background="{DynamicResource WindowBackgroundBrush}" CornerRadius="6" Padding="16,12"
          AutomationProperties.Name="Contact station details">
    <StackPanel Spacing="8">
      <WrapPanel ItemSpacing="28" LineSpacing="12">
        <StackPanel Width="220" Spacing="4">
          <TextBlock Text="Station" Classes="secondary" FontSize="12" />
          <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap" />
          <TextBlock Text="{Binding LicenseClass}" Classes="secondary" IsVisible="{Binding HasLicenseClass}" TextWrapping="Wrap" />
          <WrapPanel ItemSpacing="12" LineSpacing="4">
            <Button Classes="link" Padding="0" Content="QRZ.com ↗" ToolTip.Tip="{Binding QrzUrl}"
                    Command="{Binding $parent[v:OperateView].((vm:OperateViewModel)DataContext).OpenQrzCommand}" CommandParameter="{Binding}" />
            <Button Classes="link" Padding="0" Content="Photo ↗" IsVisible="{Binding HasPhoto}" ToolTip.Tip="Opens the QRZ photo in your browser"
                    Command="{Binding $parent[v:OperateView].((vm:OperateViewModel)DataContext).OpenPhotoCommand}" CommandParameter="{Binding}" />
          </WrapPanel>
        </StackPanel>
        <StackPanel Width="240" Spacing="4">
          <TextBlock Text="Location &amp; distance" Classes="secondary" FontSize="12" />
          <TextBlock Text="{Binding Location}" FontWeight="SemiBold" TextWrapping="Wrap" />
          <TextBlock Text="{Binding County}" Classes="secondary" IsVisible="{Binding HasCounty}" TextWrapping="Wrap" />
          <TextBlock Text="{Binding LocalTime}" Classes="secondary num" IsVisible="{Binding HasLocalTime}" TextWrapping="Wrap" />
        </StackPanel>
        <StackPanel Width="150" Spacing="4">
          <TextBlock Text="Grid &amp; bearing" Classes="secondary" FontSize="12" />
          <TextBlock Text="{Binding Grid}" FontWeight="SemiBold" Classes="num" />
          <TextBlock Classes="secondary num"><Run Text="Bearing " /><Run Text="{Binding Bearing}" /></TextBlock>
          <TextBlock Text="{Binding Zones}" Classes="secondary" IsVisible="{Binding HasZones}" TextWrapping="Wrap" />
        </StackPanel>
        <StackPanel Width="260" Spacing="4" IsVisible="{Binding HasConfirmationDetails}">
          <TextBlock Text="QSL &amp; awards" Classes="secondary" FontSize="12" />
          <TextBlock Text="{Binding Qsl}" FontWeight="SemiBold" IsVisible="{Binding HasQsl}" TextWrapping="Wrap" />
          <TextBlock Text="{Binding Rarity}" Classes="secondary" FontSize="12" IsVisible="{Binding HasRarity}" TextWrapping="Wrap" />
          <TextBlock Text="{Binding Park}" Classes="secondary" FontSize="12" IsVisible="{Binding HasPark}" TextWrapping="Wrap" />
        </StackPanel>
      </WrapPanel>
      <TextBlock Text="{Binding LookupNote}" Classes="secondary" FontSize="12" TextWrapping="Wrap" IsVisible="{Binding HasLookupNote}" />
    <!-- Who else is calling: the pileup on this station, from my own decodes. -->
    <Border Classes="attention" Margin="0,8,0,0" IsVisible="{Binding HasPileup}" AutomationProperties.Name="Who else is calling">
      <StackPanel Spacing="4">
        <TextBlock Text="Who else is calling" FontWeight="SemiBold" Foreground="{DynamicResource CautionBrush}" />
        <TextBlock Text="{Binding PileupHeadline}" Classes="secondary" TextWrapping="Wrap" IsVisible="{Binding HasPileupHeadline}" />
        <ItemsControl ItemsSource="{Binding PileupCallers}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:PileupCallerViewModel">
              <Grid ColumnDefinitions="90,50,*">
                <TextBlock Text="{Binding Call}" FontWeight="SemiBold" />
                <TextBlock Grid.Column="1" Text="{Binding Snr}" Classes="num" />
                <TextBlock Grid.Column="2" Text="{Binding Offset}" Classes="secondary num" />
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <TextBlock Text="{Binding PileupOffset}" Classes="secondary" TextWrapping="Wrap" IsVisible="{Binding HasPileupOffset}" />
        <TextBlock Text="{Binding PileupPicks}" Classes="secondary" TextWrapping="Wrap" IsVisible="{Binding HasPileupPicks}" />
      </StackPanel>
    </Border>
    </StackPanel>
  </Border>
</UserControl>
