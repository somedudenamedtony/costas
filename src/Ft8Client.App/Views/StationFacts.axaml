<!-- What is known about a station: shared by the details flyout and the Who you're calling card. -->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Ft8Client.App.ViewModels"
             xmlns:v="using:Ft8Client.App.Views"
             x:Class="Ft8Client.App.Views.StationFacts"
             x:DataType="vm:StationDetailsViewModel">
  <StackPanel Spacing="4">
    <TextBlock Text="{Binding Name}" TextWrapping="Wrap" />
    <TextBlock Text="{Binding Location}" Classes="secondary" TextWrapping="Wrap" />
    <TextBlock Text="{Binding County}" Classes="secondary" IsVisible="{Binding HasCounty}" />
    <TextBlock Classes="secondary"><Run Text="Grid " /><Run Text="{Binding Grid}" /><Run Text=" · bearing " /><Run Text="{Binding Bearing}" /></TextBlock>
    <TextBlock Text="{Binding LocalTime}" Classes="secondary num" IsVisible="{Binding HasLocalTime}" />
    <TextBlock Text="{Binding LicenseClass}" Classes="secondary" IsVisible="{Binding HasLicenseClass}" />
    <TextBlock Classes="secondary" IsVisible="{Binding HasQsl}" TextWrapping="Wrap"><Run Text="QSL: " /><Run Text="{Binding Qsl}" /></TextBlock>
    <TextBlock Text="{Binding Zones}" Classes="secondary" IsVisible="{Binding HasZones}" />
    <TextBlock Text="{Binding Rarity}" Classes="secondary" IsVisible="{Binding HasRarity}" TextWrapping="Wrap" />
    <TextBlock Text="{Binding Park}" Classes="secondary" IsVisible="{Binding HasPark}" TextWrapping="Wrap" />
    <TextBlock Text="{Binding Heard}" Classes="secondary" IsVisible="{Binding HasHeard}" TextWrapping="Wrap" ToolTip.Tip="From your decode journal" />
    <TextBlock Text="{Binding LookupNote}" Classes="secondary" FontSize="12" TextWrapping="Wrap" IsVisible="{Binding HasLookupNote}" />
    <WrapPanel ItemSpacing="12">
      <Button Classes="link" Padding="0" Content="Open on QRZ.com" ToolTip.Tip="{Binding QrzUrl}"
              Command="{Binding $parent[v:OperateView].((vm:OperateViewModel)DataContext).OpenQrzCommand}" CommandParameter="{Binding}" />
      <Button Classes="link" Padding="0" Content="Photo" IsVisible="{Binding HasPhoto}" ToolTip.Tip="Opens the QRZ photo in your browser"
              Command="{Binding $parent[v:OperateView].((vm:OperateViewModel)DataContext).OpenPhotoCommand}" CommandParameter="{Binding}" />
      <Button Classes="link" Padding="0" Content="Hunt this call" ToolTip.Tip="Add this call to your Hunt list: you are told when it is heard on any band"
              Command="{Binding $parent[v:OperateView].((vm:OperateViewModel)DataContext).HuntCallCommand}" CommandParameter="{Binding}" />
      <Button Classes="link" Padding="0" Content="{Binding HuntCountryText}" IsVisible="{Binding CanHuntCountry}"
              ToolTip.Tip="Add this country to your Hunt list: you are told when it is heard on any band"
              Command="{Binding $parent[v:OperateView].((vm:OperateViewModel)DataContext).HuntCountryCommand}" CommandParameter="{Binding}" />
    </WrapPanel>
    <!-- Who else is calling: the pileup on this station, from my own decodes. -->
    <StackPanel Spacing="4" Margin="0,8,0,0" IsVisible="{Binding HasPileup}" AutomationProperties.Name="Who else is calling">
      <TextBlock Text="Who else is calling" FontWeight="SemiBold" />
      <TextBlock Text="{Binding PileupHeadline}" Classes="secondary" TextWrapping="Wrap" IsVisible="{Binding HasPileupHeadline}" />
      <ItemsControl ItemsSource="{Binding PileupCallers}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:PileupCallerViewModel">
            <Grid ColumnDefinitions="90,50,*">
              <TextBlock Text="{Binding Call}" FontWeight="SemiBold" />
              <TextBlock Grid.Column="1" Text="{Binding Snr}" Classes="num" />
              <TextBlock Grid.Column="2" Text="{Binding Offset}" Classes="secondary num" />
            </Grid>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      <TextBlock Text="{Binding PileupOffset}" Classes="secondary" TextWrapping="Wrap" IsVisible="{Binding HasPileupOffset}" />
      <TextBlock Text="{Binding PileupPicks}" Classes="secondary" TextWrapping="Wrap" IsVisible="{Binding HasPileupPicks}" />
    </StackPanel>
  </StackPanel>
</UserControl>
