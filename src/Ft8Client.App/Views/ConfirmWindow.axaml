<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Ft8Client.App.Views.ConfirmWindow"
        Icon="/Assets/costas.ico"
        Title="Costas" Width="420" SizeToContent="Height" CanResize="False" WindowStartupLocation="CenterOwner">
  <StackPanel Margin="20" Spacing="16">
    <TextBlock x:Name="Question" TextWrapping="Wrap" />
    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
      <Button x:Name="Yes" Classes="accent" />
      <Button x:Name="No" Content="Cancel" IsDefault="True" IsCancel="True" />
    </StackPanel>
  </StackPanel>
</Window>
