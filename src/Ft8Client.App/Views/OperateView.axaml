<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Ft8Client.App.ViewModels"
             xmlns:v="using:Ft8Client.App.Views"
             x:Class="Ft8Client.App.Views.OperateView"
             x:DataType="vm:OperateViewModel">
  <Grid x:Name="Root" ColumnDefinitions="*,300" RowDefinitions="*,Auto" Margin="16,0,16,12">
    <ScrollViewer Grid.Column="0" Grid.Row="0" x:Name="LeftScroll" VerticalScrollBarVisibility="Auto">
      <StackPanel Spacing="12" Margin="0,0,12,0">

        <!-- Top slot: band summary (idle) -->
        <Border Classes="card" Padding="18,14" IsVisible="{Binding !InContact}">
          <Grid ColumnDefinitions="*,*,*" DataContext="{Binding Summary}" x:DataType="vm:SummaryViewModel">
            <StackPanel Grid.Column="0" Spacing="6">
              <TextBlock Text="{Binding Title}" Classes="title" />
              <StackPanel Orientation="Horizontal" Spacing="22">
                <StackPanel><TextBlock Text="{Binding StationsHeard}" FontSize="26" FontWeight="SemiBold" Classes="num" /><TextBlock Text="Stations heard" Classes="secondary" /></StackPanel>
                <StackPanel><TextBlock Text="{Binding Countries}" FontSize="26" FontWeight="SemiBold" Classes="num" /><TextBlock Text="Countries" Classes="secondary" /></StackPanel>
                <StackPanel><TextBlock Text="{Binding CallingCq}" FontSize="26" FontWeight="SemiBold" Classes="num" /><TextBlock Text="Calling CQ" Classes="secondary" /></StackPanel>
                <StackPanel><TextBlock Text="{Binding YouNeed}" FontSize="26" FontWeight="SemiBold" Classes="num" Foreground="{DynamicResource AccentTextBrush}" /><TextBlock Text="You need" Classes="secondary" /></StackPanel>
              </StackPanel>
              <TextBlock Text="{Binding Caption}" Classes="secondary num" />
              <TextBlock Text="{Binding LogNotice}" IsVisible="{Binding HasLogNotice}" Foreground="{DynamicResource CautionBrush}" TextWrapping="Wrap" />
            </StackPanel>
            <StackPanel Grid.Column="1" Spacing="6" Margin="12,0">
              <TextBlock Text="Heard from" Classes="title" />
              <ItemsControl ItemsSource="{Binding Continents}">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Rows="1" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:ContinentBar">
                    <Grid RowDefinitions="72,Auto" Margin="2,0">
                      <Grid Grid.Row="0" VerticalAlignment="Bottom">
                        <StackPanel VerticalAlignment="Bottom">
                          <TextBlock Text="{Binding Count}" HorizontalAlignment="Center" FontWeight="SemiBold" Classes="num" />
                          <Border Height="{Binding BarHeight}" MinHeight="2" Background="{DynamicResource AccentBrush}" Margin="4,2,4,0" />
                        </StackPanel>
                      </Grid>
                      <TextBlock Grid.Row="1" Text="{Binding Name}" Classes="secondary" HorizontalAlignment="Center" FontSize="12" Margin="0,4,0,0" />
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
            <Grid Grid.Column="2" ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto">
              <TextBlock Grid.ColumnSpan="2" Text="{Binding LogTitle}" Classes="title" Margin="0,0,0,6" />
              <TextBlock Grid.Row="1" Text="Countries" Classes="secondary" Margin="0,2,16,2" />
              <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding LogCountries}" Classes="num" Margin="0,2" />
              <TextBlock Grid.Row="2" Text="US states" Classes="secondary" Margin="0,2,16,2" />
              <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding LogStates}" Classes="num" TextWrapping="Wrap" Margin="0,2" />
              <TextBlock Grid.Row="3" Text="Grid squares" Classes="secondary" Margin="0,2,16,2" />
              <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding LogGrids}" Classes="num" Margin="0,2" />
              <TextBlock Grid.Row="4" Text="Tonight" Classes="secondary" Margin="0,2,16,2" />
              <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding Tonight}" Classes="num" TextWrapping="Wrap" Margin="0,2" />
            </Grid>
          </Grid>
        </Border>

        <!-- Top slot: contact -->
        <Border Classes="card" Padding="18,12" IsVisible="{Binding InContact}">
          <StackPanel DataContext="{Binding Contact}" x:DataType="vm:ContactPanelViewModel" Spacing="4">
            <DockPanel>
              <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="18" VerticalAlignment="Top">
                <StackPanel><TextBlock Text="You sent" Classes="secondary" /><TextBlock Text="{Binding Sent}" FontSize="24" FontWeight="SemiBold" Classes="num" /></StackPanel>
                <StackPanel><TextBlock Text="You received" Classes="secondary" /><TextBlock Text="{Binding Received}" FontSize="24" FontWeight="SemiBold" Classes="num" /></StackPanel>
                <Button Content="Resend" Command="{Binding $parent[UserControl].((vm:OperateViewModel)DataContext).ResendCommand}" IsEnabled="{Binding Active}" VerticalAlignment="Center" />
                <Button Content="Log now" Command="{Binding $parent[UserControl].((vm:OperateViewModel)DataContext).LogNowCommand}" IsEnabled="{Binding CanLogNow}" VerticalAlignment="Center" />
                <Button Content="Abandon (Esc)" Classes="critical" Command="{Binding $parent[UserControl].((vm:OperateViewModel)DataContext).AbandonCommand}" IsEnabled="{Binding Active}" VerticalAlignment="Center" />
              </StackPanel>
              <StackPanel>
                <TextBlock Text="{Binding Caption}" Classes="secondary" />
                <StackPanel Orientation="Horizontal" Spacing="10">
                  <TextBlock Text="{Binding Call}" FontSize="40" FontWeight="SemiBold" />
                  <TextBlock Text="{Binding Need}" FontWeight="SemiBold" VerticalAlignment="Bottom" Margin="0,0,0,8"
                             Foreground="{Binding NeedKind, Converter={x:Static v:Converters.KindBrush}}" />
                </StackPanel>
                <TextBlock Text="{Binding Subline}" FontSize="15" />
              </StackPanel>
            </DockPanel>
            <ItemsControl ItemsSource="{Binding Steps}" Margin="0,4,0,0">
              <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Rows="1" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:StepViewModel">
                  <Button Padding="0" Background="Transparent" BorderThickness="0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                          Margin="{Binding Offset, Converter={x:Static v:Converters.StepMargin}}" IsHitTestVisible="{Binding CanJump}"
                          Command="{Binding $parent[UserControl].((vm:OperateViewModel)DataContext).JumpCommand}" CommandParameter="{Binding}"
                          ToolTip.Tip="Click to send this next">
                    <Panel>
                      <Rectangle RadiusX="4" RadiusY="4" Stroke="{DynamicResource ControlBorderBrush}" StrokeThickness="1"
                                 StrokeDashArray="{Binding Look, Converter={x:Static v:Converters.StepDash}}"
                                 IsVisible="{Binding Look, Converter={x:Static v:Converters.IsUpcoming}}" />
                      <Border CornerRadius="4" BorderThickness="1" Padding="10,6"
                              Background="{Binding Look, Converter={x:Static v:Converters.StepBackground}}"
                              BorderBrush="{Binding Look, Converter={x:Static v:Converters.StepBorder}}">
                        <StackPanel>
                          <TextBlock Text="{Binding Header}" FontSize="12" Foreground="{Binding Look, Converter={x:Static v:Converters.StepForeground}}" TextTrimming="CharacterEllipsis" />
                          <TextBlock Text="{Binding Message}" Classes="message" Foreground="{Binding Look, Converter={x:Static v:Converters.StepForeground}}" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                      </Border>
                    </Panel>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>

        <!-- Next in line -->
        <Border Classes="card">
          <Panel>
            <StackPanel>
              <DockPanel Margin="14,12,14,8">
                <Button DockPanel.Dock="Right" Content="List updated" IsVisible="{Binding ListUpdated}" Command="{Binding ApplyUpdateCommand}"
                        Background="{DynamicResource AccentBrush}" Foreground="White" CornerRadius="12" MinHeight="24" Padding="10,2" />
                <TextBlock Text="Next in line" Classes="title" />
              </DockPanel>
              <Grid ColumnDefinitions="36,100,190,110,*,140,46,80,74" Margin="14,0,14,4">
                <TextBlock Grid.Column="0" Text="#" Classes="secondary" />
                <TextBlock Grid.Column="1" Text="Call" Classes="secondary" />
                <TextBlock Grid.Column="2" Text="Where" Classes="secondary" />
                <TextBlock Grid.Column="3" Text="Why" Classes="secondary" />
                <TextBlock Grid.Column="4" Text="Doing now" Classes="secondary" />
                <TextBlock Grid.Column="5" Text="Hears you" Classes="secondary" />
                <TextBlock Grid.Column="6" Text="dB" Classes="secondary" HorizontalAlignment="Right" Margin="0,0,8,0" />
                <TextBlock Grid.Column="7" Text="Chance" Classes="secondary" />
              </Grid>
              <ListBox x:Name="LineList" ItemsSource="{Binding Line}" SelectedItem="{Binding Selected}" Background="Transparent"
                       ScrollViewer.VerticalScrollBarVisibility="Disabled" AutomationProperties.Name="Next in line">
                <ListBox.Styles>
                  <Style Selector="ListBoxItem">
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="Background" Value="Transparent" />
                  </Style>
                  <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
                    <Setter Property="Background" Value="Transparent" />
                  </Style>
                </ListBox.Styles>
                <ListBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:StationRowViewModel">
                    <Border Background="{Binding IsSelected, Converter={x:Static v:Converters.SelectedBackground}}"
                            BorderBrush="{DynamicResource RowDividerBrush}" BorderThickness="0,1,0,0">
                      <Grid ColumnDefinitions="3,33,100,190,110,*,140,46,80,74" MinHeight="40">
                        <Border Grid.Column="0" Background="{Binding IsSelected, Converter={x:Static v:Converters.SelectedBar}}" />
                        <TextBlock Grid.Column="1" Text="{Binding Rank}" Classes="num secondary" VerticalAlignment="Center" Margin="11,0,0,0" />
                        <TextBlock Grid.Column="2" Text="{Binding Call}" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="3" Text="{Binding Where}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Column="4" Text="{Binding Why}" VerticalAlignment="Center"
                                   Foreground="{Binding WhyKind, Converter={x:Static v:Converters.KindBrush}}" FontWeight="{Binding WhyBold, Converter={x:Static v:Converters.Bold}}" />
                        <TextBlock Grid.Column="5" Text="{Binding DoingNow}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Column="6" Text="{Binding HearsYou}" VerticalAlignment="Center" TextWrapping="Wrap" />
                        <TextBlock Grid.Column="7" Text="{Binding Db}" Classes="num" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,8,0" />
                        <TextBlock Grid.Column="8" Text="{Binding Chance}" VerticalAlignment="Center" FontWeight="{Binding ChanceBold, Converter={x:Static v:Converters.Bold}}" />
                        <Button Grid.Column="9" Content="Call" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,12,0"
                                Command="{Binding $parent[UserControl].((vm:OperateViewModel)DataContext).CallRowCommand}" CommandParameter="{Binding}"
                                AutomationProperties.Name="{Binding Call, StringFormat='Call {0}'}" />
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
              <TextBlock Text="Nobody you need is calling CQ right now." Classes="secondary" Margin="14,10" IsVisible="{Binding LineEmpty}" />
              <TextBlock Text="{Binding MoreText}" Classes="secondary" Margin="14,6,14,10" IsVisible="{Binding MoreText, Converter={x:Static v:Converters.NotEmpty}}" />
            </StackPanel>

            <!-- Details flyout -->
            <Border Classes="card" IsVisible="{Binding Details, Converter={x:Static ObjectConverters.IsNotNull}}" HorizontalAlignment="Right" VerticalAlignment="Top"
                    Width="300" Margin="0,44,8,0" Padding="14" BoxShadow="0 4 16 0 #33000000">
              <StackPanel DataContext="{Binding Details}" x:DataType="vm:StationDetailsViewModel" Spacing="4">
                <DockPanel>
                  <Button DockPanel.Dock="Right" Content="✕" Classes="link" AutomationProperties.Name="Close details"
                          Command="{Binding $parent[UserControl].((vm:OperateViewModel)DataContext).CloseDetailsCommand}" />
                  <TextBlock Text="{Binding Call}" Classes="title" />
                </DockPanel>
                <TextBlock Text="{Binding Name}" />
                <TextBlock Text="{Binding Location}" Classes="secondary" />
                <TextBlock Classes="secondary"><Run Text="Grid " /><Run Text="{Binding Grid}" /><Run Text=" · bearing " /><Run Text="{Binding Bearing}" /></TextBlock>
                <TextBlock Text="Your contacts" FontWeight="SemiBold" Margin="0,8,0,0" />
                <TextBlock Text="No contacts with this call yet." Classes="secondary" IsVisible="{Binding NoPast}" />
                <ItemsControl ItemsSource="{Binding Past}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:PastContactViewModel">
                      <Grid ColumnDefinitions="90,50,50,*">
                        <TextBlock Text="{Binding Date}" Classes="num" />
                        <TextBlock Grid.Column="1" Text="{Binding Band}" />
                        <TextBlock Grid.Column="2" Text="{Binding Mode}" />
                        <TextBlock Grid.Column="3" Text="{Binding Confirmed}" Classes="secondary" />
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>
          </Panel>
        </Border>

        <!-- Watching -->
        <Border Classes="card" Padding="0,10,0,6">
          <StackPanel>
            <TextBlock Text="Watching" Classes="title" Margin="14,0" />
            <TextBlock Text="Needed, but not callable right now. They join the line when that changes." Classes="secondary" Margin="14,2,14,6" />
            <ItemsControl ItemsSource="{Binding Watching}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:WatchRowViewModel">
                  <Border BorderBrush="{DynamicResource RowDividerBrush}" BorderThickness="0,1,0,0">
                    <Grid ColumnDefinitions="100,180,160,*" MinHeight="34" Margin="14,0">
                      <TextBlock Text="{Binding Call}" Classes="secondary" FontWeight="SemiBold" VerticalAlignment="Center" />
                      <TextBlock Grid.Column="1" Text="{Binding Where}" Classes="secondary" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                      <TextBlock Grid.Column="2" Text="{Binding Why}" VerticalAlignment="Center" Foreground="{Binding WhyKind, Converter={x:Static v:Converters.KindBrush}}" />
                      <TextBlock Grid.Column="3" Text="{Binding Reason}" Classes="secondary" VerticalAlignment="Center" />
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Border BorderBrush="{DynamicResource RowDividerBrush}" BorderThickness="0,1,0,0" Padding="14,8,14,2"
                    IsVisible="{Binding WorkedFooter, Converter={x:Static v:Converters.NotEmpty}}">
              <StackPanel Orientation="Horizontal" Spacing="4">
                <TextBlock Text="{Binding WorkedFooter}" Classes="secondary" />
                <Button Classes="link" Command="{Binding ToggleWorkedCommand}"><TextBlock Text="{Binding ShowWorked, Converter={x:Static v:OperateView.ShowHide}}" /></Button>
              </StackPanel>
            </Border>
            <ItemsControl ItemsSource="{Binding Worked}" IsVisible="{Binding ShowWorked}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:StationRowViewModel">
                  <Grid ColumnDefinitions="100,180,130,*,140,46,80" MinHeight="32" Margin="14,0">
                    <TextBlock Text="{Binding Call}" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="{Binding Where}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Column="2" Text="{Binding Why}" Classes="secondary" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="3" Text="{Binding DoingNow}" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="4" Text="{Binding HearsYou}" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="5" Text="{Binding Db}" Classes="num" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="6" Text="{Binding Chance}" VerticalAlignment="Center" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>

    <!-- Right column -->
    <ScrollViewer Grid.Column="1" Grid.Row="0" x:Name="RightColumn" VerticalScrollBarVisibility="Auto">
      <StackPanel Spacing="12">
        <Border Classes="card" Padding="14,12" IsVisible="{Binding HasWaiting}">
          <StackPanel Spacing="6">
            <TextBlock Text="{Binding WaitingTitle}" Classes="title" />
            <ItemsControl ItemsSource="{Binding WaitingRows}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:WaitingRowViewModel">
                  <StackPanel Margin="0,4">
                    <TextBlock Text="{Binding Call}" FontWeight="SemiBold" />
                    <TextBlock><Run Text="{Binding Where}" /><Run Text=" · " /><Run Text="{Binding Need}" /></TextBlock>
                    <TextBlock Text="{Binding Detail}" Classes="secondary num" />
                    <Button Content="{Binding ButtonText}" Margin="0,4,0,0" IsEnabled="{Binding !Queued}"
                            Command="{Binding $parent[UserControl].((vm:OperateViewModel)DataContext).AnswerRowCommand}" CommandParameter="{Binding}" />
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>

        <Border Classes="card" Padding="14,12">
          <StackPanel Spacing="6">
            <TextBlock Text="{Binding SignalTitle}" Classes="title" />
            <TextBlock Text="{Binding SignalSource}" Classes="secondary" FontSize="12" Margin="0,-4,0,0" />
            <Grid ColumnDefinitions="128,*">
              <v:ReachPlot Width="124" Height="124" Points="{Binding ReachPoints}" Compact="True" />
              <StackPanel Grid.Column="1" Spacing="4" Margin="8,0,0,0">
                <TextBlock Text="{Binding SignalHeadline}" TextWrapping="Wrap" />
                <TextBlock Text="Farthest" Classes="secondary" FontSize="12" />
                <TextBlock Text="{Binding SignalFarthest}" />
                <TextBlock Text="Best report" Classes="secondary" FontSize="12" />
                <TextBlock Text="{Binding SignalBest}" />
              </StackPanel>
            </Grid>
            <ItemsControl ItemsSource="{Binding ReportRows}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:ReportRowViewModel">
                  <Grid ColumnDefinitions="70,*,36,70" MinHeight="28">
                    <TextBlock Text="{Binding Call}" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="{Binding Where}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Column="2" Text="{Binding Db}" Classes="num" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="3" Text="{Binding Age}" Classes="secondary" VerticalAlignment="Center" HorizontalAlignment="Right" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Button Classes="link" Command="{Binding OpenReachCommand}"><TextBlock Text="Open reach view" /></Button>
          </StackPanel>
        </Border>

        <Border Classes="card" Padding="14,12">
          <StackPanel Spacing="4">
            <TextBlock Text="{Binding TonightTitle}" Classes="title" />
            <TextBlock Text="{Binding TonightSubline}" Classes="secondary" />
            <ItemsControl ItemsSource="{Binding TonightRows}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:TonightRowViewModel">
                  <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" Margin="0,6,0,0">
                    <TextBlock Text="{Binding CallWhere}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Column="1" Text="{Binding Need}" Foreground="{Binding NeedKind, Converter={x:Static v:Converters.KindBrush}}" HorizontalAlignment="Right" />
                    <Button Grid.Row="1" Classes="link" Command="{Binding $parent[UserControl].((vm:OperateViewModel)DataContext).RetryUploadCommand}" CommandParameter="{Binding}">
                      <TextBlock Text="{Binding Upload}" FontSize="12" TextDecorations="{x:Null}" Foreground="{Binding UploadKind, Converter={x:Static v:Converters.KindBrush}}" />
                    </Button>
                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Time}" Classes="secondary num" FontSize="12" HorizontalAlignment="Right" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Button Classes="link" Command="{Binding OpenLogCommand}" Margin="0,6,0,0"><TextBlock Text="{Binding TonightLink}" /></Button>
          </StackPanel>
        </Border>

        <Border Classes="card" Padding="14,12">
          <StackPanel Spacing="4">
            <TextBlock Text="How the line is ordered" Classes="title" />
            <TextBlock Text="{Binding OrderText}" TextWrapping="Wrap" Classes="secondary" />
            <Button Classes="link" Command="{Binding OpenRankingCommand}"><TextBlock Text="Change" /></Button>
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>
