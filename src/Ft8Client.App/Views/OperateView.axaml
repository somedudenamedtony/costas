<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Ft8Client.App.ViewModels"
             xmlns:v="using:Ft8Client.App.Views"
             x:Class="Ft8Client.App.Views.OperateView"
             x:DataType="vm:OperateViewModel">
  <Grid x:Name="Root" ColumnDefinitions="*,300" RowDefinitions="*,Auto" Margin="16,0,16,12">
    <DockPanel Grid.Column="0" Grid.Row="0">
    <!-- Calling you: pinned above everything else whenever a station is calling me, so it is never scrolled away. -->
    <Border DockPanel.Dock="Top" Classes="card" Padding="14,10" Margin="0,0,12,12" IsVisible="{Binding HasWaiting}"
            BorderBrush="{DynamicResource AccentBrush}" BorderThickness="2" AutomationProperties.Name="Calling you">
      <StackPanel Spacing="6">
        <TextBlock Text="{Binding WaitingTitle}" Classes="title" />
        <ItemsControl ItemsSource="{Binding WaitingRows}">
          <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel ItemSpacing="24" LineSpacing="8" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:WaitingRowViewModel">
              <Grid ColumnDefinitions="Auto,Auto" MaxWidth="460">
                <StackPanel Spacing="1" Margin="0,0,12,0">
                  <TextBlock><Run Text="{Binding Call}" FontWeight="SemiBold" /><Run Text="  " /><Run Text="{Binding Where}" /><Run Text=" " /><Run Text="{Binding Need}" /></TextBlock>
                  <TextBlock Text="{Binding Note}" IsVisible="{Binding AfterStop}" Foreground="{DynamicResource CautionBrush}" FontWeight="SemiBold" TextWrapping="Wrap" />
                  <TextBlock Text="{Binding Detail}" Classes="secondary num" TextWrapping="Wrap" />
                </StackPanel>
                <Button Grid.Column="1" Content="{Binding ButtonText}" VerticalAlignment="Center" IsEnabled="{Binding !Queued}"
                        Command="{Binding $parent[UserControl].((vm:OperateViewModel)DataContext).AnswerRowCommand}" CommandParameter="{Binding}"
                        AutomationProperties.Name="{Binding Call, StringFormat='Answer {0}'}" />
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </Border>
    <ScrollViewer x:Name="LeftScroll" VerticalScrollBarVisibility="Auto">
      <StackPanel Spacing="12" Margin="0,0,12,0">

        <!-- Top slot: the contact card, always shown. With no contact it is idle: no call, empty reports, the countdown and Call CQ. -->
        <Border Classes="card" Padding="18,12">
          <StackPanel DataContext="{Binding Panel}" x:DataType="vm:ContactPanelViewModel" Spacing="4">
            <DockPanel>
              <!-- On-air panel: the reports, the slot countdown and every control that acts on this contact or the next transmission, together. -->
              <Border DockPanel.Dock="Right" VerticalAlignment="Top" CornerRadius="8" Padding="14,10" BorderThickness="1"
                      BorderBrush="{DynamicResource ControlBorderBrush}" AutomationProperties.Name="On air">
                <StackPanel Spacing="10">
                  <Grid ColumnDefinitions="Auto,Auto,*" ColumnSpacing="24">
                    <StackPanel>
                      <TextBlock Text="You sent" Classes="secondary" />
                      <StackPanel Orientation="Horizontal" Spacing="4">
                        <TextBlock Text="{Binding Sent}" FontSize="24" FontWeight="SemiBold" Classes="num" />
                        <TextBlock Text="dB" Classes="secondary" VerticalAlignment="Bottom" Margin="0,0,0,5" />
                      </StackPanel>
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                      <TextBlock Text="You received" Classes="secondary" />
                      <StackPanel Orientation="Horizontal" Spacing="4">
                        <TextBlock Text="{Binding Received}" FontSize="24" FontWeight="SemiBold" Classes="num" />
                        <TextBlock Text="dB" Classes="secondary" VerticalAlignment="Bottom" Margin="0,0,0,5" />
                      </StackPanel>
                    </StackPanel>
                    <StackPanel Grid.Column="2" MinWidth="150" AutomationProperties.LiveSetting="Polite">
                      <TextBlock Text="{Binding $parent[UserControl].((vm:OperateViewModel)DataContext).SlotLabel}" Classes="secondary" />
                      <StackPanel Orientation="Horizontal" Spacing="4">
                        <TextBlock Text="{Binding $parent[UserControl].((vm:OperateViewModel)DataContext).SlotLeft}" FontSize="24" FontWeight="SemiBold" Classes="num"
                                   Foreground="{Binding $parent[UserControl].((vm:OperateViewModel)DataContext).Transmitting, Converter={x:Static v:Converters.TransmittingText}}" />
                        <TextBlock Text="left" Classes="secondary" VerticalAlignment="Bottom" Margin="0,0,0,5" />
                      </StackPanel>
                      <ProgressBar Value="{Binding $parent[UserControl].((vm:OperateViewModel)DataContext).SlotProgress}" Maximum="1" Height="4" MinHeight="4" Margin="0,2,0,0"
                                   Foreground="{Binding $parent[UserControl].((vm:OperateViewModel)DataContext).Transmitting, Converter={x:Static v:Converters.ProgressBrush}}" />
                    </StackPanel>
                  </Grid>
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Content="{Binding $parent[UserControl].((vm:OperateViewModel)DataContext).CqText}"
                            Command="{Binding $parent[UserControl].((vm:OperateViewModel)DataContext).ToggleCqCommand}" MinWidth="80" />
                    <ComboBox ItemsSource="{Binding $parent[UserControl].((vm:OperateViewModel)DataContext).CqModifiers}"
                              SelectedItem="{Binding $parent[UserControl].((vm:OperateViewModel)DataContext).SelectedCqModifier}"
                              MinWidth="96" AutomationProperties.Name="CQ modifier"
                              ToolTip.Tip="What your CQ says: CQ for everyone, CQ DX for stations outside your country, CQ NA and the like for one continent. Applies to your next CQ.">
                      <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:CqModifierChoice">
                          <TextBlock Text="{Binding Label}" />
                        </DataTemplate>
                      </ComboBox.ItemTemplate>
                    </ComboBox>
                    <Button Content="Resend" Command="{Binding $parent[UserControl].((vm:OperateViewModel)DataContext).ResendCommand}" IsEnabled="{Binding Active}" />
                    <Button Content="Log now" Command="{Binding $parent[UserControl].((vm:OperateViewModel)DataContext).LogNowCommand}" IsEnabled="{Binding CanLogNow}" />
                    <Button Content="Abandon (Esc)" Classes="critical" Command="{Binding $parent[UserControl].((vm:OperateViewModel)DataContext).AbandonCommand}" IsEnabled="{Binding Active}" />
                  </StackPanel>
                </StackPanel>
              </Border>
              <StackPanel>
                <TextBlock Text="{Binding Caption}" Classes="secondary" />
                <StackPanel Orientation="Horizontal" Spacing="10">
                  <TextBlock Text="{Binding Call}" FontSize="40" FontWeight="SemiBold" />
                  <TextBlock Text="{Binding Need}" FontWeight="SemiBold" VerticalAlignment="Bottom" Margin="0,0,0,8"
                             Foreground="{Binding NeedKind, Converter={x:Static v:Converters.KindBrush}}" />
                </StackPanel>
                <TextBlock Text="{Binding Subline}" FontSize="15" />
              </StackPanel>
            </DockPanel>
            <!-- The conversation strip: a progress track with one marker per step, and the boxes below it, mine raised and theirs lowered. -->
            <ItemsControl ItemsSource="{Binding Steps}" Margin="0,8,0,0" AutomationProperties.Name="Conversation" IsVisible="{Binding HasSteps}">
              <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Rows="1" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:StepViewModel">
                  <StackPanel>
                    <Grid ColumnDefinitions="*,Auto,*" Margin="0,0,6,6">
                      <Rectangle Height="2" VerticalAlignment="Center" IsVisible="{Binding !First}"
                                 Fill="{Binding Reached, Converter={x:Static v:Converters.TrackBrush}}" />
                      <Border Grid.Column="1" Width="22" Height="22" CornerRadius="11" BorderThickness="2" Margin="4,0"
                              Background="{Binding Look, Converter={x:Static v:Converters.MarkerFill}}"
                              BorderBrush="{Binding Look, Converter={x:Static v:Converters.MarkerStroke}}">
                        <TextBlock Text="{Binding Marker}" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="{Binding Look, Converter={x:Static v:Converters.MarkerForeground}}" />
                      </Border>
                      <Rectangle Grid.Column="2" Height="2" VerticalAlignment="Center" IsVisible="{Binding !Last}"
                                 Fill="{Binding NextReached, Converter={x:Static v:Converters.TrackBrush}}" />
                    </Grid>
                    <Button Padding="0" Background="Transparent" BorderThickness="0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                            Margin="{Binding Offset, Converter={x:Static v:Converters.StepMargin}}" IsHitTestVisible="{Binding CanJump}"
                            Command="{Binding $parent[UserControl].((vm:OperateViewModel)DataContext).JumpCommand}" CommandParameter="{Binding}"
                            ToolTip.Tip="Click to send this next">
                      <Panel>
                        <Rectangle RadiusX="6" RadiusY="6" Stroke="{DynamicResource ControlBorderBrush}" StrokeThickness="1"
                                   StrokeDashArray="{Binding Look, Converter={x:Static v:Converters.StepDash}}"
                                   IsVisible="{Binding Look, Converter={x:Static v:Converters.IsUpcoming}}" />
                        <Border CornerRadius="6" Padding="10,6"
                                Background="{Binding Look, Converter={x:Static v:Converters.StepBackground}}"
                                BorderBrush="{Binding Look, Converter={x:Static v:Converters.StepBorder}}"
                                BorderThickness="{Binding Look, Converter={x:Static v:Converters.StepBorderThickness}}">
                          <StackPanel Spacing="2">
                            <DockPanel>
                              <TextBlock DockPanel.Dock="Right" Text="{Binding Time}" Classes="num" FontSize="12"
                                         Foreground="{Binding Look, Converter={x:Static v:Converters.StepStatusForeground}}" />
                              <TextBlock Text="{Binding Who}" FontSize="13" TextTrimming="CharacterEllipsis"
                                         FontWeight="{Binding Mine, Converter={x:Static v:Converters.NotBold}}"
                                         Foreground="{Binding Look, Converter={x:Static v:Converters.StepForeground}}" />
                            </DockPanel>
                            <TextBlock Text="{Binding Message}" Classes="message" TextTrimming="CharacterEllipsis"
                                       Foreground="{Binding Look, Converter={x:Static v:Converters.StepForeground}}" />
                            <TextBlock Text="{Binding Status}" FontSize="12" TextTrimming="CharacterEllipsis"
                                       Foreground="{Binding Look, Converter={x:Static v:Converters.StepStatusForeground}}" />
                          </StackPanel>
                        </Border>
                      </Panel>
                    </Button>
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <!-- Who you're calling: QRZ details of the station in the current contact. -->
            <Border Padding="0,10,0,0" Margin="0,8,0,0" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource ControlBorderBrush}" IsVisible="{Binding $parent[UserControl].((vm:OperateViewModel)DataContext).Calling, Converter={x:Static ObjectConverters.IsNotNull}}"
                    AutomationProperties.Name="Who you're calling">
              <StackPanel DataContext="{Binding $parent[UserControl].((vm:OperateViewModel)DataContext).Calling}" x:DataType="vm:StationDetailsViewModel" Spacing="4">
                <TextBlock Classes="title"><Run Text="About " /><Run Text="{Binding Call}" /></TextBlock>
                <v:StationFacts />
              </StackPanel>
            </Border>
          </StackPanel>
        </Border>
        <!-- Top slot: band summary (idle) -->
        <Border Classes="card" Padding="18,14" IsVisible="{Binding !InContact}">
          <Grid ColumnDefinitions="*,*,*" DataContext="{Binding Summary}" x:DataType="vm:SummaryViewModel">
            <StackPanel Grid.Column="0" Spacing="6">
              <TextBlock Text="{Binding Title}" Classes="title" />
              <WrapPanel ItemSpacing="22" LineSpacing="6">
                <StackPanel><TextBlock Text="{Binding StationsHeard}" FontSize="26" FontWeight="SemiBold" Classes="num" /><TextBlock Text="Stations heard" Classes="secondary" /></StackPanel>
                <StackPanel><TextBlock Text="{Binding Countries}" FontSize="26" FontWeight="SemiBold" Classes="num" /><TextBlock Text="Countries" Classes="secondary" /></StackPanel>
                <StackPanel><TextBlock Text="{Binding CallingCq}" FontSize="26" FontWeight="SemiBold" Classes="num" /><TextBlock Text="Calling CQ" Classes="secondary" /></StackPanel>
                <StackPanel><TextBlock Text="{Binding YouNeed}" FontSize="26" FontWeight="SemiBold" Classes="num" Foreground="{DynamicResource AccentTextBrush}" /><TextBlock Text="You need" Classes="secondary" /></StackPanel>
              </WrapPanel>
              <TextBlock Text="{Binding Caption}" Classes="secondary num" TextWrapping="Wrap" Margin="0,0,12,0" />
              <TextBlock Text="{Binding LogNotice}" IsVisible="{Binding HasLogNotice}" Foreground="{DynamicResource CautionBrush}" TextWrapping="Wrap" Margin="0,0,12,0" />
            </StackPanel>
            <StackPanel Grid.Column="1" Spacing="6" Margin="12,0">
              <TextBlock Text="Heard from" Classes="title" />
              <ItemsControl ItemsSource="{Binding Continents}">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Rows="1" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:ContinentBar">
                    <Grid RowDefinitions="72,Auto" Margin="2,0">
                      <Grid Grid.Row="0" VerticalAlignment="Bottom">
                        <StackPanel VerticalAlignment="Bottom">
                          <TextBlock Text="{Binding Count}" HorizontalAlignment="Center" FontWeight="SemiBold" Classes="num" />
                          <Border Height="{Binding BarHeight}" MinHeight="2" Background="{DynamicResource AccentBrush}" Margin="4,2,4,0" />
                        </StackPanel>
                      </Grid>
                      <TextBlock Grid.Row="1" Text="{Binding Name}" Classes="secondary" HorizontalAlignment="Center" FontSize="12" Margin="0,4,0,0" />
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
            <Grid Grid.Column="2" ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto">
              <TextBlock Grid.ColumnSpan="2" Text="{Binding LogTitle}" Classes="title" Margin="0,0,0,6" />
              <TextBlock Grid.Row="1" Text="Countries" Classes="secondary" Margin="0,2,16,2" />
              <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding LogCountries}" Classes="num" TextWrapping="Wrap" Margin="0,2" />
              <TextBlock Grid.Row="2" Text="US states" Classes="secondary" Margin="0,2,16,2" />
              <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding LogStates}" Classes="num" TextWrapping="Wrap" Margin="0,2" />
              <TextBlock Grid.Row="3" Text="Grid squares" Classes="secondary" Margin="0,2,16,2" />
              <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding LogGrids}" Classes="num" TextWrapping="Wrap" Margin="0,2" />
              <TextBlock Grid.Row="4" Text="Tonight" Classes="secondary" Margin="0,2,16,2" />
              <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding Tonight}" Classes="num" TextWrapping="Wrap" Margin="0,2" />
            </Grid>
          </Grid>
        </Border>


        <!-- Next in line -->
        <Border Classes="card">
          <Panel>
            <StackPanel>
              <DockPanel Margin="14,12,14,8">
                <Button DockPanel.Dock="Right" Content="List updated" IsVisible="{Binding ListUpdated}" Command="{Binding ApplyUpdateCommand}"
                        Background="{DynamicResource AccentBrush}" Foreground="White" CornerRadius="12" MinHeight="24" Padding="10,2" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <TextBlock Text="Next in line" Classes="title" />
                  <!-- How the line is ordered: a tooltip, with Change opening the ranking settings. -->
                  <Button Classes="link" Command="{Binding OpenRankingCommand}" Padding="0" VerticalAlignment="Center"
                          AutomationProperties.Name="How the line is ordered">
                    <ToolTip.Tip>
                      <StackPanel MaxWidth="320" Spacing="4">
                        <TextBlock Text="How the line is ordered" FontWeight="SemiBold" TextDecorations="{x:Null}" />
                        <TextBlock Text="{Binding OrderText}" TextWrapping="Wrap" TextDecorations="{x:Null}" />
                        <TextBlock Text="Click to change." Opacity="0.7" TextDecorations="{x:Null}" />
                      </StackPanel>
                    </ToolTip.Tip>
                    <TextBlock Text="ⓘ" FontSize="15" />
                  </Button>
                </StackPanel>
              </DockPanel>
              <!-- Next in line and Repeats share these columns so the two tables line up. -->
              <Grid ColumnDefinitions="36,100,190,160,*,100,46,64,230,120,74" Margin="14,0,14,4">
                <TextBlock Grid.Column="0" Text="#" Classes="secondary" />
                <TextBlock Grid.Column="1" Text="Call" Classes="secondary" />
                <TextBlock Grid.Column="2" Text="Where" Classes="secondary" />
                <TextBlock Grid.Column="3" Text="Why" Classes="secondary" />
                <TextBlock Grid.Column="4" Text="Doing now" Classes="secondary" />
                <TextBlock Grid.Column="5" Text="Last heard" Classes="secondary" />
                <TextBlock Grid.Column="6" Text="dB" Classes="secondary" HorizontalAlignment="Right" Margin="0,0,8,0" />
                <TextBlock Grid.Column="7" Text="Signal" Classes="secondary" />
                <TextBlock Grid.Column="8" Text="Chance" Classes="secondary" />
                <TextBlock Grid.Column="9" Text="Last worked" Classes="secondary" />
              </Grid>
              <ListBox x:Name="LineList" ItemsSource="{Binding Line}" SelectedItem="{Binding Selected}" Background="Transparent" Padding="0"
                       ScrollViewer.VerticalScrollBarVisibility="Disabled" AutomationProperties.Name="Next in line">
                <ListBox.Styles>
                  <Style Selector="ListBoxItem">
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="Background" Value="Transparent" />
                  </Style>
                  <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
                    <Setter Property="Background" Value="Transparent" />
                  </Style>
                </ListBox.Styles>
                <ListBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:StationRowViewModel">
                    <!-- The tint and left bar mark the station in contact; the picked row (keyboard, click) only gets an outline. -->
                    <Border Background="{Binding IsInContact, Converter={x:Static v:Converters.SelectedBackground}}"
                            BorderBrush="{DynamicResource RowDividerBrush}" BorderThickness="0,1,0,0">
                      <Panel>
                        <Border Width="3" HorizontalAlignment="Left" Background="{Binding IsInContact, Converter={x:Static v:Converters.SelectedBar}}" />
                        <Border BorderThickness="1" CornerRadius="3" Margin="1" IsHitTestVisible="False"
                                BorderBrush="{Binding IsSelected, Converter={x:Static v:Converters.CursorOutline}}" />
                        <Grid ColumnDefinitions="36,100,190,160,*,100,46,64,230,120,74" MinHeight="40" Margin="14,0">
                          <TextBlock Grid.Column="0" Text="{Binding Rank}" Classes="num secondary" VerticalAlignment="Center" />
                          <TextBlock Grid.Column="1" Text="{Binding Call}" FontWeight="SemiBold" VerticalAlignment="Center" />
                          <TextBlock Grid.Column="2" Text="{Binding Where}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                          <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Why}" VerticalAlignment="Center" ToolTip.Tip="{Binding WhyTip}"
                                       Foreground="{Binding WhyKind, Converter={x:Static v:Converters.KindBrush}}" FontWeight="{Binding WhyBold, Converter={x:Static v:Converters.Bold}}" />
                            <v:RarityMeter Level="{Binding RarityLevel}" IsVisible="{Binding HasRarity}" VerticalAlignment="Center"
                                           ToolTip.Tip="{Binding RarityTip}" AutomationProperties.Name="{Binding RarityTip}" />
                          </StackPanel>
                          <TextBlock Grid.Column="4" Text="{Binding DoingNow}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                          <TextBlock Grid.Column="5" Text="{Binding LastHeard}" Classes="secondary" VerticalAlignment="Center" />
                          <TextBlock Grid.Column="6" Text="{Binding Db}" Classes="num" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,8,0" />
                          <v:SignalSparkline Grid.Column="7" Values="{Binding History}" Width="52" Height="24" HorizontalAlignment="Left" VerticalAlignment="Center"
                                             ToolTip.Tip="{Binding HistoryTip}" AutomationProperties.Name="{Binding HistoryTip}" />
                          <!-- Chance with what it is based on beside it, so the PSK Reporter evidence is not a column of its own. -->
                          <Grid Grid.Column="8" ColumnDefinitions="Auto,*" ColumnSpacing="6" VerticalAlignment="Center" Margin="0,0,8,0" ToolTip.Tip="{Binding ChanceReason}">
                            <TextBlock Text="{Binding Chance}" FontWeight="{Binding ChanceBold, Converter={x:Static v:Converters.Bold}}" />
                            <TextBlock Grid.Column="1" Text="{Binding ChanceReason}" Classes="secondary" TextTrimming="CharacterEllipsis" />
                          </Grid>
                          <TextBlock Grid.Column="9" Text="{Binding LastWorked}" Classes="secondary" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                     ToolTip.Tip="{Binding LastWorkedTip}" />
                          <Button Grid.Column="10" Content="{Binding CallText}" VerticalAlignment="Center" HorizontalAlignment="Right"
                                  Command="{Binding $parent[UserControl].((vm:OperateViewModel)DataContext).CallRowCommand}" CommandParameter="{Binding}"
                                  AutomationProperties.Name="{Binding Call, StringFormat='Call or answer {0}'}" />
                        </Grid>
                      </Panel>
                    </Border>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
              <TextBlock Text="Nobody you need is calling CQ right now." Classes="secondary" Margin="14,10" IsVisible="{Binding LineEmpty}" />
              <TextBlock Text="{Binding MoreText}" Classes="secondary" Margin="14,6,14,10" IsVisible="{Binding MoreText, Converter={x:Static v:Converters.NotEmpty}}" />
            </StackPanel>

            <!-- Details flyout -->
            <Border Classes="card" IsVisible="{Binding Details, Converter={x:Static ObjectConverters.IsNotNull}}" HorizontalAlignment="Right" VerticalAlignment="Top"
                    Width="300" Margin="0,44,8,0" Padding="14" BoxShadow="0 4 16 0 #33000000">
              <StackPanel DataContext="{Binding Details}" x:DataType="vm:StationDetailsViewModel" Spacing="4">
                <DockPanel>
                  <Button DockPanel.Dock="Right" Content="✕" Classes="link" AutomationProperties.Name="Close details"
                          Command="{Binding $parent[UserControl].((vm:OperateViewModel)DataContext).CloseDetailsCommand}" />
                  <TextBlock Text="{Binding Call}" Classes="title" />
                </DockPanel>
                <v:StationFacts />
                <TextBlock Text="Your contacts" FontWeight="SemiBold" Margin="0,8,0,0" />
                <TextBlock Text="No contacts with this call yet." Classes="secondary" IsVisible="{Binding NoPast}" />
                <ItemsControl ItemsSource="{Binding Past}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:PastContactViewModel">
                      <Grid ColumnDefinitions="90,50,50,*">
                        <TextBlock Text="{Binding Date}" Classes="num" />
                        <TextBlock Grid.Column="1" Text="{Binding Band}" />
                        <TextBlock Grid.Column="2" Text="{Binding Mode}" />
                        <TextBlock Grid.Column="3" Text="{Binding Confirmed}" Classes="secondary" />
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>
          </Panel>
        </Border>

        <!-- Repeats: stations heard now that are already in the log on this band and mode -->
        <Border Classes="card" Padding="0,10,0,6" AutomationProperties.Name="Repeats">
          <StackPanel>
            <TextBlock Text="Repeats" Classes="title" Margin="14,0" />
            <TextBlock Text="{Binding RepeatsSubtitle}" Classes="secondary" Margin="14,2,14,6" />
            <!-- The same columns as Next in line. -->
            <Grid ColumnDefinitions="36,100,190,160,*,100,46,64,230,120,74" Margin="14,0,14,4" IsVisible="{Binding !!Repeats.Count}">
              <TextBlock Grid.Column="0" Text="#" Classes="secondary" />
              <TextBlock Grid.Column="1" Text="Call" Classes="secondary" />
              <TextBlock Grid.Column="2" Text="Where" Classes="secondary" />
              <TextBlock Grid.Column="3" Text="Why" Classes="secondary" />
              <TextBlock Grid.Column="4" Text="Doing now" Classes="secondary" />
              <TextBlock Grid.Column="5" Text="Last heard" Classes="secondary" />
              <TextBlock Grid.Column="6" Text="dB" Classes="secondary" HorizontalAlignment="Right" Margin="0,0,8,0" />
              <TextBlock Grid.Column="7" Text="Signal" Classes="secondary" />
              <TextBlock Grid.Column="8" Text="Chance" Classes="secondary" />
              <TextBlock Grid.Column="9" Text="Last worked" Classes="secondary" />
            </Grid>
            <ItemsControl x:Name="RepeatList" ItemsSource="{Binding Repeats}" Background="Transparent">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:RepeatRowViewModel">
                  <Border Background="{Binding IsInContact, Converter={x:Static v:Converters.SelectedBackground}}"
                          BorderBrush="{DynamicResource RowDividerBrush}" BorderThickness="0,1,0,0">
                    <Panel>
                      <Border Width="3" HorizontalAlignment="Left" Background="{Binding IsInContact, Converter={x:Static v:Converters.SelectedBar}}" />
                      <Grid ColumnDefinitions="36,100,190,160,*,100,46,64,230,120,74" MinHeight="36" Margin="14,0">
                        <TextBlock Grid.Column="0" Text="{Binding Rank}" Classes="num secondary" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="{Binding Call}" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="2" Text="{Binding Where}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Column="3" Text="{Binding Why}" VerticalAlignment="Center"
                                   Foreground="{Binding WhyKind, Converter={x:Static v:Converters.KindBrush}}" FontWeight="{Binding WhyBold, Converter={x:Static v:Converters.Bold}}" />
                        <TextBlock Grid.Column="4" Text="{Binding DoingNow}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                   Classes.secondary="{Binding !CanCall}" />
                        <TextBlock Grid.Column="5" Text="{Binding LastHeard}" Classes="secondary" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="6" Text="{Binding Db}" Classes="num" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,8,0" />
                        <v:SignalSparkline Grid.Column="7" Values="{Binding History}" Width="52" Height="20" HorizontalAlignment="Left" VerticalAlignment="Center"
                                           ToolTip.Tip="{Binding HistoryTip}" AutomationProperties.Name="{Binding HistoryTip}" />
                        <Grid Grid.Column="8" ColumnDefinitions="Auto,*" ColumnSpacing="6" VerticalAlignment="Center" Margin="0,0,8,0" ToolTip.Tip="{Binding ChanceReason}">
                          <TextBlock Text="{Binding Chance}" FontWeight="{Binding ChanceBold, Converter={x:Static v:Converters.Bold}}" />
                          <TextBlock Grid.Column="1" Text="{Binding ChanceReason}" Classes="secondary" TextTrimming="CharacterEllipsis" />
                        </Grid>
                        <TextBlock Grid.Column="9" Text="{Binding LastWorked}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                   ToolTip.Tip="{Binding LastWorkedTip}" />
                        <Button Grid.Column="10" Content="{Binding CallText}" VerticalAlignment="Center" HorizontalAlignment="Right"
                                Command="{Binding $parent[UserControl].((vm:OperateViewModel)DataContext).CallRepeatCommand}" CommandParameter="{Binding}"
                                AutomationProperties.Name="{Binding Call, StringFormat='Call or answer {0} again'}" />
                      </Grid>
                    </Panel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Text="{Binding RepeatsEmptyText}" Classes="secondary" Margin="14,4,14,4" IsVisible="{Binding RepeatsEmptyText, Converter={x:Static v:Converters.NotEmpty}}" />
            <TextBlock Text="{Binding RepeatsMoreText}" Classes="secondary" Margin="14,6,14,4" IsVisible="{Binding RepeatsMoreText, Converter={x:Static v:Converters.NotEmpty}}" />
          </StackPanel>
        </Border>

        <!-- Watching -->
        <Border Classes="card" Padding="0,10,0,6">
          <StackPanel>
            <TextBlock Text="Watching" Classes="title" Margin="14,0" />
            <TextBlock Text="Needed, but not callable right now. They join the line when that changes." Classes="secondary" Margin="14,2,14,6" />
            <ItemsControl ItemsSource="{Binding Watching}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:WatchRowViewModel">
                  <Border BorderBrush="{DynamicResource RowDividerBrush}" BorderThickness="0,1,0,0">
                    <Grid ColumnDefinitions="100,180,160,64,*" MinHeight="34" Margin="14,0">
                      <TextBlock Text="{Binding Call}" Classes="secondary" FontWeight="SemiBold" VerticalAlignment="Center" />
                      <TextBlock Grid.Column="1" Text="{Binding Where}" Classes="secondary" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                      <TextBlock Grid.Column="2" Text="{Binding Why}" VerticalAlignment="Center" Foreground="{Binding WhyKind, Converter={x:Static v:Converters.KindBrush}}" />
                      <v:SignalSparkline Grid.Column="3" Values="{Binding History}" Width="52" Height="18" HorizontalAlignment="Left" VerticalAlignment="Center" Opacity="0.7"
                                         ToolTip.Tip="{Binding HistoryTip}" AutomationProperties.Name="{Binding HistoryTip}" />
                      <TextBlock Grid.Column="4" Text="{Binding Reason}" Classes="secondary" VerticalAlignment="Center" />
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>
    </DockPanel>

    <!-- Right column -->
    <ScrollViewer Grid.Column="1" Grid.Row="0" x:Name="RightColumn" VerticalScrollBarVisibility="Auto">
      <StackPanel Spacing="12">
        <!-- Heard here: map and band activity -->
        <Border Classes="card" Padding="14,12">
          <StackPanel Spacing="8">
            <StackPanel Spacing="8" DataContext="{Binding Map}" x:DataType="vm:HeardMapViewModel">
              <TextBlock Text="Heard here" Classes="title" />
              <TextBlock Text="{Binding Headline}" Classes="secondary" FontSize="12" TextWrapping="Wrap" Margin="0,-4,0,0" />
              <WrapPanel ItemSpacing="6" LineSpacing="6">
                <ComboBox ItemsSource="{x:Static vm:HeardMapViewModel.Views}" SelectedItem="{Binding View}" MinWidth="110" AutomationProperties.Name="Map view" ToolTip.Tip="Map view" />
                <ComboBox ItemsSource="{x:Static vm:HeardMapViewModel.Shows}" SelectedItem="{Binding Show}" MinWidth="130" AutomationProperties.Name="Stations shown" ToolTip.Tip="Stations shown" />
                <ComboBox ItemsSource="{x:Static vm:HeardMapViewModel.Colours}" SelectedItem="{Binding Colour}" MinWidth="110" AutomationProperties.Name="Colour by" ToolTip.Tip="Colour by" />
              </WrapPanel>
              <WrapPanel ItemSpacing="14">
                <CheckBox Content="Who heard you" IsChecked="{Binding HearsMe}" />
                <CheckBox Content="Day and night" IsChecked="{Binding DayNight}" IsVisible="{Binding World}" />
              </WrapPanel>
              <v:StationMap Points="{Binding Points}" Centre="{Binding Centre}" World="{Binding World}" DayNight="{Binding DayNight}"
                            NowUtc="{Binding NowUtc}" Units="{Binding Units}" HorizontalAlignment="Stretch" />
              <TextBlock Text="{Binding Notice}" Classes="secondary" FontSize="12" TextWrapping="Wrap" IsVisible="{Binding Notice, Converter={x:Static v:Converters.NotEmpty}}" />
              <ItemsControl ItemsSource="{Binding Legend}">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel ItemSpacing="12" LineSpacing="2" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:LegendItem">
                    <StackPanel Orientation="Horizontal" Spacing="5">
                      <Ellipse Width="9" Height="9" VerticalAlignment="Center" Opacity="{Binding Opacity}"
                               Fill="{Binding Converter={x:Static v:Converters.LegendFill}}" Stroke="{Binding Converter={x:Static v:Converters.LegendStroke}}" StrokeThickness="1.5" />
                      <TextBlock Text="{Binding Text}" Classes="secondary" FontSize="12" />
                    </StackPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <TextBlock Text="Band activity, last hour" Classes="title" Margin="0,6,0,0" />
              <v:ActivityChart Activity="{Binding Activity}" NowUtc="{Binding NowUtc}" Height="80" HorizontalAlignment="Stretch"
                               AutomationProperties.Name="{Binding ActivityText}" />
              <TextBlock Text="{Binding ActivityText}" Classes="secondary" FontSize="12" TextWrapping="Wrap" />
              <StackPanel Orientation="Horizontal" Spacing="12">
                <StackPanel Orientation="Horizontal" Spacing="5">
                  <Rectangle Width="9" Height="9" Fill="{DynamicResource TextSecondaryBrush}" Opacity="0.35" VerticalAlignment="Center" />
                  <TextBlock Text="Decodes per slot" Classes="secondary" FontSize="12" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="5">
                  <Rectangle Width="9" Height="9" Fill="{DynamicResource AccentBrush}" VerticalAlignment="Center" />
                  <TextBlock Text="Needed stations" Classes="secondary" FontSize="12" />
                </StackPanel>
              </StackPanel>
            </StackPanel>
            <Border BorderThickness="0,1,0,0" BorderBrush="{DynamicResource ControlBorderBrush}" Padding="0,10,0,0">
              <StackPanel Spacing="6">
                <TextBlock Text="{Binding SignalTitle}" Classes="title" />
                <TextBlock Text="{Binding SignalSource}" Classes="secondary" FontSize="12" Margin="0,-4,0,0" />
                <!-- No map here: Heard here's "Who heard you" rings already show these stations on a map. -->
                <TextBlock Text="{Binding SignalHeadline}" TextWrapping="Wrap" />
                <TextBlock Text="Stations hearing you · every 5 minutes" Classes="secondary" FontSize="12" />
                <v:ReceptionChart History="{Binding SignalHistory}" Height="100"
                                  AutomationProperties.Name="Distinct stations hearing you in five-minute intervals over the last hour"
                                  ToolTip.Tip="One count per receiver per interval, on this band and mode. Times are local. The final bar is incomplete. Reports can arrive late; fewer transmissions or a feed outage can also lower counts." />
                <TextBlock Text="Last hour · local time · * current interval incomplete" Classes="secondary" FontSize="11" TextWrapping="Wrap" />
                <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                  <StackPanel>
                    <TextBlock Text="Farthest" Classes="secondary" FontSize="12" />
                    <TextBlock Text="{Binding SignalFarthest}" TextTrimming="CharacterEllipsis" />
                  </StackPanel>
                  <StackPanel Grid.Column="1">
                    <TextBlock Text="Best report" Classes="secondary" FontSize="12" />
                    <TextBlock Text="{Binding SignalBest}" TextTrimming="CharacterEllipsis" />
                  </StackPanel>
                </Grid>
                <TextBlock Text="{Binding SignalNeighbours}" TextWrapping="Wrap" IsVisible="{Binding SignalNeighbours, Converter={x:Static v:Converters.NotEmpty}}"
                           ToolTip.Tip="From PSK Reporter receivers that heard both you and stations within 300 miles in the last 30 minutes. Details in the Reach view." />
                <ItemsControl ItemsSource="{Binding ReportRows}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:ReportRowViewModel">
                      <Grid ColumnDefinitions="70,*,36,70" MinHeight="28">
                        <TextBlock Text="{Binding Call}" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="{Binding Where}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Column="2" Text="{Binding Db}" Classes="num" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="3" Text="{Binding Age}" Classes="secondary" VerticalAlignment="Center" HorizontalAlignment="Right" />
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Button Classes="link" Command="{Binding OpenReachCommand}"><TextBlock Text="Open reach view" /></Button>
              </StackPanel>
            </Border>
          </StackPanel>
        </Border>

        <Border Classes="card" Padding="14,12">
          <StackPanel Spacing="4">
            <TextBlock Text="{Binding TonightTitle}" Classes="title" />
            <TextBlock Text="{Binding TonightSubline}" Classes="secondary" />
            <ItemsControl ItemsSource="{Binding TonightRows}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:TonightRowViewModel">
                  <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" Margin="0,6,0,0">
                    <TextBlock Text="{Binding CallWhere}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Column="1" Text="{Binding Need}" Foreground="{Binding NeedKind, Converter={x:Static v:Converters.KindBrush}}" HorizontalAlignment="Right" />
                    <Button Grid.Row="1" Classes="link" Command="{Binding $parent[UserControl].((vm:OperateViewModel)DataContext).RetryUploadCommand}" CommandParameter="{Binding}">
                      <TextBlock Text="{Binding Upload}" FontSize="12" TextDecorations="{x:Null}" Foreground="{Binding UploadKind, Converter={x:Static v:Converters.KindBrush}}" />
                    </Button>
                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Time}" Classes="secondary num" FontSize="12" HorizontalAlignment="Right" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Button Classes="link" Command="{Binding OpenLogCommand}" Margin="0,6,0,0"><TextBlock Text="{Binding TonightLink}" /></Button>
          </StackPanel>
        </Border>

      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>
