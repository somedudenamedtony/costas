<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Ft8Client.App.ViewModels"
        xmlns:v="using:Ft8Client.App.Views"
        x:Class="Ft8Client.App.Views.MainWindow"
        Icon="/Assets/costas.ico"
        x:DataType="vm:MainViewModel"
        Title="{Binding Title}"
        Width="1440" Height="900" MinWidth="1100" MinHeight="720">
  <!-- The whole window is outlined in red while the radio is keyed. -->
  <Border Classes="frame" Classes.onair="{Binding Transmitting}" BorderThickness="4">
    <Border.Styles>
      <Style Selector="Border.frame"><Setter Property="BorderBrush" Value="Transparent" /></Style>
      <Style Selector="Border.frame.onair"><Setter Property="BorderBrush" Value="{DynamicResource OnAirBrush}" /></Style>
    </Border.Styles>
  <Grid RowDefinitions="Auto,Auto,Auto,Auto,*,Auto">
    <!-- Instrument faceplates use live state and open the existing dial editor. -->
    <ContentControl x:Name="InstrumentFace" Grid.Row="0" Content="{Binding}" Margin="16,12,16,4"
                    ContentTemplate="{DynamicResource InstrumentFaceTemplate}" IsVisible="{DynamicResource InstrumentSkin}"
                    HorizontalContentAlignment="Stretch" />
    <!-- Top bar -->
    <DockPanel Grid.Row="1" Margin="16,8,16,8" LastChildFill="False">
      <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
        <TextBlock Text="Band" VerticalAlignment="Center" />
        <!-- The open list shows, per band, where stations near me are heard right now (PSK Reporter); the closed box shows only the band. -->
        <ComboBox ItemsSource="{Binding Bands}" SelectedItem="{Binding SelectedBandChoice}"
                  IsEnabled="{Binding CanChangeBand}" MinWidth="80" MaxDropDownHeight="520" AutomationProperties.Name="Band">
          <ComboBox.SelectionBoxItemTemplate>
            <DataTemplate x:DataType="vm:BandChoiceViewModel"><TextBlock Text="{Binding Name}" /></DataTemplate>
          </ComboBox.SelectionBoxItemTemplate>
          <ComboBox.ItemTemplate>
            <DataTemplate x:DataType="vm:BandChoiceViewModel">
              <Grid ColumnDefinitions="48,Auto,Auto,Auto,Auto" ToolTip.Tip="{Binding Tip}" AutomationProperties.Name="{Binding Name}">
                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" Width="150" IsVisible="{Binding HasActivity}" VerticalAlignment="Center">
                  <Border Width="60" Height="6" CornerRadius="3" Background="{DynamicResource ControlBorderBrush}" VerticalAlignment="Center">
                    <Border Width="{Binding BarWidth}" HorizontalAlignment="Left" CornerRadius="3" Background="{DynamicResource AccentBrush}" />
                  </Border>
                  <TextBlock Text="{Binding SpotsText}" Classes="secondary num" FontSize="12" VerticalAlignment="Center" />
                </StackPanel>
                <ItemsControl Grid.Column="2" ItemsSource="{Binding Continents}" IsVisible="{Binding HasActivity}" VerticalAlignment="Center"
                              AutomationProperties.Name="Heard in">
                  <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="3" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:ContinentChip">
                      <Border Width="28" Padding="0,1" CornerRadius="3" BorderThickness="1" ToolTip.Tip="{Binding Tip}"
                              Background="{Binding Level, Converter={x:Static v:Converters.ShadeBackground}}"
                              BorderBrush="{Binding Level, Converter={x:Static v:Converters.ShadeBorder}}">
                        <TextBlock Text="{Binding Label}" FontSize="11" HorizontalAlignment="Center"
                                   Foreground="{Binding Level, Converter={x:Static v:Converters.ShadeForeground}}" />
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Grid.Column="3" Text="{Binding NeedText}" Margin="12,0,0,0" FontSize="12" VerticalAlignment="Center"
                           Foreground="{DynamicResource CautionBrush}" IsVisible="{Binding HasActivity}" ToolTip.Tip="{Binding NeedTip}" />
                <TextBlock Grid.Column="4" Text="{Binding HuntText}" Margin="12,0,0,0" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"
                           Foreground="{DynamicResource AccentBrush}" IsVisible="{Binding HasHunt}" ToolTip.Tip="{Binding HuntTip}" />
              </Grid>
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>
        <TextBlock Text="Mode" VerticalAlignment="Center" Margin="8,0,0,0" />
        <ComboBox ItemsSource="{Binding Modes}" SelectedItem="{Binding SelectedMode}" IsEnabled="{Binding CanChangeBand}" MinWidth="70"
                  AutomationProperties.Name="Mode" />
        <!-- Click the dial to type a frequency (DXpeditions often sit off the standard one) or to use one you saved. -->
        <Button x:Name="DialFrequencyButton" Classes="link" Margin="12,0,0,0" Padding="0" VerticalAlignment="Center" IsEnabled="{Binding CanChangeBand}"
                IsVisible="{DynamicResource StandardSkin}"
                ToolTip.Tip="Type a frequency, or use one you saved" AutomationProperties.Name="Dial frequency">
          <TextBlock Text="{Binding Frequency}" FontSize="24" FontWeight="SemiBold" Classes="num" TextDecorations="{x:Null}" />
          <Button.Flyout>
            <Flyout Placement="BottomEdgeAlignedLeft">
              <StackPanel Spacing="8" Width="280">
                <TextBlock Text="Dial frequency" Classes="title" />
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <TextBox Text="{Binding DialEntry}" Width="130" PlaceholderText="14.090" AutomationProperties.Name="Frequency in megahertz">
                    <TextBox.KeyBindings><KeyBinding Gesture="Enter" Command="{Binding TuneDialCommand}" /></TextBox.KeyBindings>
                  </TextBox>
                  <TextBlock Text="MHz" VerticalAlignment="Center" />
                  <Button Content="Tune" Command="{Binding TuneDialCommand}" />
                </StackPanel>
                <TextBlock Text="{Binding DialMessage}" TextWrapping="Wrap" Foreground="{DynamicResource CautionBrush}"
                           IsVisible="{Binding DialMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                <TextBlock Text="Your frequencies" Classes="secondary" Margin="0,4,0,0"
                           IsVisible="{Binding !!SavedDials.Count}" />
                <ItemsControl ItemsSource="{Binding SavedDials}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:SavedDialViewModel">
                      <DockPanel Margin="0,2">
                        <Button DockPanel.Dock="Right" Classes="link" Content="Remove" Margin="8,0,0,0"
                                Command="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).RemoveSavedDialCommand}" CommandParameter="{Binding}" />
                        <Button Content="{Binding Text}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                Command="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).UseSavedDialCommand}" CommandParameter="{Binding}" />
                      </DockPanel>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Button Content="Save the current frequency" Command="{Binding SaveDialCommand}" HorizontalAlignment="Stretch" />
              </StackPanel>
            </Flyout>
          </Button.Flyout>
        </Button>
        <TextBlock Text="MHz" Classes="secondary" VerticalAlignment="Bottom" Margin="0,0,0,6" IsVisible="{DynamicResource StandardSkin}" />
      </StackPanel>
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
        <Button Classes="tab" Classes.selected="{Binding Tab, Converter={x:Static v:Converters.IntEquals}, ConverterParameter=0}"
                Content="Operate" Command="{Binding ShowTabCommand}" CommandParameter="0" ToolTip.Tip="Who to call next, ranked by what you need, and the contact in progress (Ctrl+1)" />
        <Button Classes="tab" Classes.selected="{Binding Tab, Converter={x:Static v:Converters.IntEquals}, ConverterParameter=1}"
                Content="Raw decodes" Command="{Binding ShowTabCommand}" CommandParameter="1" ToolTip.Tip="Every decoded message, as the decoder printed it (Ctrl+2)" />
        <Button Classes="tab" Classes.selected="{Binding Tab, Converter={x:Static v:Converters.IntEquals}, ConverterParameter=2}"
                Content="Reach" Command="{Binding ShowTabCommand}" CommandParameter="2" ToolTip.Tip="Who is hearing your signal, from PSK Reporter (Ctrl+3)" />
        <Button Classes="tab" Classes.selected="{Binding Tab, Converter={x:Static v:Converters.IntEquals}, ConverterParameter=3}"
                Content="Log" Command="{Binding ShowTabCommand}" CommandParameter="3" ToolTip.Tip="Your contacts: search, edit, import and export (Ctrl+4)" />
        <Button Classes="tab" Classes.selected="{Binding Tab, Converter={x:Static v:Converters.IntEquals}, ConverterParameter=4}"
                Content="Awards" Command="{Binding ShowTabCommand}" CommandParameter="4" ToolTip.Tip="DXCC, WAS, WAZ and VUCC progress, and when you hear the countries you still need (Ctrl+5)" />
        <TextBlock Text="{Binding ClockText}" FontSize="16" FontWeight="SemiBold" Classes="num" Margin="12,0,4,0" VerticalAlignment="Center"
                   Foreground="{Binding ClockKind, Converter={x:Static v:Converters.KindBrush}}" ToolTip.Tip="{Binding ClockTip}"
                   AutomationProperties.Name="UTC clock" />
        <Button Content="☰" AutomationProperties.Name="Menu" Padding="10,4">
          <Button.Flyout>
            <MenuFlyout>
              <MenuItem Header="Mini mode" InputGesture="Ctrl+M" Command="{Binding OpenCommand}" CommandParameter="mini" />
              <Separator />
              <MenuItem Header="Settings" Command="{Binding OpenCommand}" CommandParameter="settings" />
              <MenuItem Header="Station setup" Command="{Binding OpenCommand}" CommandParameter="setup" />
              <MenuItem Header="Diagnostics" Command="{Binding OpenCommand}" CommandParameter="diagnostics" />
              <MenuItem Header="Keyboard shortcuts" Command="{Binding OpenCommand}" CommandParameter="shortcuts" />
              <MenuItem Header="Report a problem…" Command="{Binding OpenCommand}" CommandParameter="feedback" />
              <MenuItem Header="About" Command="{Binding OpenCommand}" CommandParameter="about" />
            </MenuFlyout>
          </Button.Flyout>
        </Button>
      </StackPanel>
    </DockPanel>

    <!-- Views -->
    <!-- Update bar -->
    <!-- Radio state: red while keyed, yellow when no radio is connected. -->
    <Border Grid.Row="2" IsVisible="{Binding Transmitting}" Background="{DynamicResource OnAirBrush}" Padding="16,10"
            AutomationProperties.Name="On air" AutomationProperties.LiveSetting="Assertive">
      <DockPanel>
        <Button DockPanel.Dock="Right" Content="Halt (Esc)" Command="{Binding HaltCommand}" Background="White" Foreground="#D11F1F"
                FontWeight="SemiBold" Padding="14,4" />
        <!-- The radio's transmit meters over CAT, live while on the air (display only, owner decision D13). Instrument
             skins show them on the faceplate instead. -->
        <Panel DockPanel.Dock="Right" IsVisible="{DynamicResource StandardSkin}" Margin="16,0,20,0">
          <StackPanel x:Name="BarMeters" Orientation="Horizontal" Spacing="16" VerticalAlignment="Center" IsVisible="{Binding HasMeters}"
                      Background="Transparent" ToolTip.Tip="{Binding MeterTip}" AutomationProperties.Name="{Binding MeterTip}">
            <StackPanel.Styles>
              <Style Selector="TextBlock.onair-label"><Setter Property="Foreground" Value="#E6FFFFFF" /><Setter Property="FontSize" Value="13" /><Setter Property="VerticalAlignment" Value="Center" /></Style>
              <Style Selector="TextBlock.onair-value"><Setter Property="FontSize" Value="16" /><Setter Property="FontWeight" Value="Bold" /><Setter Property="FontFeatures" Value="+tnum" /><Setter Property="VerticalAlignment" Value="Center" /></Style>
            </StackPanel.Styles>
            <StackPanel Orientation="Horizontal" Spacing="5" IsVisible="{Binding HasPowerOut}">
              <TextBlock Text="PO" Classes="onair-label" />
              <TextBlock Text="{Binding PowerOutText}" Classes="onair-value" Foreground="White" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding HasAlc}">
              <TextBlock Text="ALC" Classes="onair-label" />
              <v:TxMeterBar Value="{Binding AlcBar}" CautionAt="0.5" Segments="10" Width="60" Height="10" VerticalAlignment="Center"
                            MeterBrush="White" CautionBrush="#FFD27A" TrackBrush="#55FFFFFF" />
              <TextBlock Text="{Binding AlcText}" Classes="onair-value">
                <TextBlock.Foreground>
                  <MultiBinding Converter="{x:Static v:Converters.FaceKindBrush}">
                    <Binding Path="AlcKind" /><Binding Source="{x:Static Brushes.White}" /><Binding Source="#FFD27A" /><Binding Source="#FFD27A" />
                  </MultiBinding>
                </TextBlock.Foreground>
              </TextBlock>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="5" IsVisible="{Binding HasSwr}">
              <TextBlock Text="SWR" Classes="onair-label" />
              <TextBlock Text="{Binding SwrText}" Classes="onair-value">
                <TextBlock.Foreground>
                  <MultiBinding Converter="{x:Static v:Converters.FaceKindBrush}">
                    <Binding Path="SwrKind" /><Binding Source="{x:Static Brushes.White}" /><Binding Source="#FFD27A" /><Binding Source="#FFD27A" />
                  </MultiBinding>
                </TextBlock.Foreground>
              </TextBlock>
            </StackPanel>
          </StackPanel>
        </Panel>
        <TextBlock Text="{Binding OnAirText}" Foreground="White" FontSize="18" FontWeight="Bold" VerticalAlignment="Center"
                   TextTrimming="CharacterEllipsis" />
      </DockPanel>
    </Border>
    <Border Grid.Row="2" IsVisible="{Binding NoRadio}" Background="{DynamicResource NoRadioBrush}" Padding="16,8"
            AutomationProperties.Name="No radio connected">
      <DockPanel>
        <Button DockPanel.Dock="Right" Content="Station setup" Command="{Binding OpenCommand}" CommandParameter="setup"
                Background="#1A1A1A" Foreground="White" Padding="12,4" />
        <TextBlock Text="{Binding NoRadioText}" Foreground="#1A1A1A" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"
                   TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding NoRadioText}" />
      </DockPanel>
    </Border>

    <StackPanel Grid.Row="3">
    <!-- Hunt list alert: a wanted station was heard. It only tells; changing band is the operator's click and nothing is sent. -->
    <Border IsVisible="{Binding HuntVisible}" Margin="16,0,16,8" Padding="12,8" CornerRadius="6"
            Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CautionBrush}" BorderThickness="1"
            AutomationProperties.Name="Hunt list alert" AutomationProperties.LiveSetting="Polite">
      <DockPanel LastChildFill="True">
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8">
          <Button Content="{Binding HuntGoText}" Classes="accent" Command="{Binding HuntGoCommand}" IsVisible="{Binding HuntCanGo}"
                  ToolTip.Tip="Change to that band. Nothing is sent until you call someone." />
          <Button Content="Dismiss" Command="{Binding HuntDismissCommand}" />
        </StackPanel>
        <DockPanel VerticalAlignment="Center" Margin="0,0,12,0">
          <TextBlock DockPanel.Dock="Left" Text="Hunt list" FontWeight="SemiBold" Foreground="{DynamicResource CautionBrush}" VerticalAlignment="Center"
                     Margin="0,0,12,0" />
          <TextBlock Text="{Binding HuntText}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding HuntText}" />
        </DockPanel>
      </DockPanel>
    </Border>
    <Border IsVisible="{Binding Update.Visible}" Margin="16,0,16,8" Padding="12,8" CornerRadius="6"
            Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1">
      <DockPanel LastChildFill="True">
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8">
          <Button Content="Update" Classes="accent" Command="{Binding Update.InstallCommand}" IsEnabled="{Binding !Update.Busy}" />
          <Button Content="Release notes" Command="{Binding Update.ReleaseNotesCommand}" />
          <Button Content="Skip this version" Command="{Binding Update.SkipCommand}" IsEnabled="{Binding !Update.Busy}" />
        </StackPanel>
        <DockPanel VerticalAlignment="Center" Margin="0,0,12,0">
          <TextBlock DockPanel.Dock="Left" Text="{Binding Update.Text}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,12,0" />
          <TextBlock Text="{Binding Update.Detail}" Classes="secondary" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                     ToolTip.Tip="{Binding Update.Detail}" />
        </DockPanel>
      </DockPanel>
    </Border>
    </StackPanel>

    <Panel Grid.Row="4">
      <v:OperateView x:Name="OperatePage" DataContext="{Binding Operate}" IsVisible="{Binding $parent[Window].((vm:MainViewModel)DataContext).Tab, Converter={x:Static v:Converters.IntEquals}, ConverterParameter=0}" />
      <v:RawDecodesView DataContext="{Binding Raw}" IsVisible="{Binding $parent[Window].((vm:MainViewModel)DataContext).Tab, Converter={x:Static v:Converters.IntEquals}, ConverterParameter=1}" />
      <v:ReachView DataContext="{Binding Reach}" IsVisible="{Binding $parent[Window].((vm:MainViewModel)DataContext).Tab, Converter={x:Static v:Converters.IntEquals}, ConverterParameter=2}" />
      <v:LogView DataContext="{Binding LogView}" IsVisible="{Binding $parent[Window].((vm:MainViewModel)DataContext).Tab, Converter={x:Static v:Converters.IntEquals}, ConverterParameter=3}" />
      <v:AwardsView DataContext="{Binding Awards}" IsVisible="{Binding $parent[Window].((vm:MainViewModel)DataContext).Tab, Converter={x:Static v:Converters.IntEquals}, ConverterParameter=4}" />
      <!-- "Logged" notice: over the right-hand column, clear of the contact card and Next in line. -->
      <v:LoggedNoticeView DataContext="{Binding Logged}" Margin="0,0,16,12" HorizontalAlignment="Right" VerticalAlignment="Bottom" />
    </Panel>

    <!-- Bottom bar -->
    <Border Grid.Row="5" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="0,1,0,0" Background="{DynamicResource CardBackgroundBrush}">
      <Grid x:Name="BottomGrid" RowDefinitions="Auto,Auto,52" Margin="16,6">
      <DockPanel Margin="0,0,0,4">
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
          <!-- After a transmission whose SWR or ALC was outside limits: what to check. The live meters are in the on-air bar. -->
          <TextBlock Text="{Binding MeterText}" FontWeight="SemiBold" VerticalAlignment="Center" ToolTip.Tip="{Binding MeterWarningTip}"
                     Foreground="{Binding MeterKind, Converter={x:Static v:Converters.KindBrush}}"
                     IsVisible="{Binding MeterText, Converter={x:Static v:Converters.NotEmpty}}"
                     AutomationProperties.Name="{Binding MeterWarningTip}" AutomationProperties.LiveSetting="Assertive" />
          <Button Classes="link" AutomationProperties.Name="Transmit offset" VerticalAlignment="Center">
            <TextBlock Text="{Binding TxOffsetText}" Classes="secondary num" TextDecorations="{x:Null}" />
            <Button.Flyout>
              <Flyout>
                <StackPanel Spacing="8" Width="220">
                  <TextBlock Text="Transmit offset" Classes="title" />
                  <Button Content="Automatic (picks a clear spot)" Command="{Binding OffsetAutoCommand}" HorizontalAlignment="Stretch" />
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBox Text="{Binding ManualOffset}" Width="90" AutomationProperties.Name="Manual offset in hertz" />
                    <TextBlock Text="Hz" VerticalAlignment="Center" />
                    <Button Content="Use" Command="{Binding OffsetManualCommand}" />
                  </StackPanel>
                </StackPanel>
              </Flyout>
            </Button.Flyout>
          </Button>
          <!-- The radio's power setting, when the radio reports it over CAT. Changes the setting only, never keys. -->
          <Button Classes="link" AutomationProperties.Name="Radio power" VerticalAlignment="Center" IsVisible="{Binding HasPower}"
                  ToolTip.Tip="The radio's power setting. Click to change it.">
            <TextBlock Text="{Binding PowerText}" Classes="secondary num" TextDecorations="{x:Null}" />
            <Button.Flyout>
              <Flyout>
                <StackPanel Spacing="8" Width="240">
                  <TextBlock Text="Radio power" Classes="title" />
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <Button Content="−5" Command="{Binding PowerStepCommand}" CommandParameter="-5" AutomationProperties.Name="5 watts less" />
                    <TextBox Text="{Binding PowerEntry}" Width="60" AutomationProperties.Name="Power in watts">
                      <TextBox.KeyBindings><KeyBinding Gesture="Enter" Command="{Binding PowerSetCommand}" /></TextBox.KeyBindings>
                    </TextBox>
                    <TextBlock Text="W" VerticalAlignment="Center" />
                    <Button Content="+5" Command="{Binding PowerStepCommand}" CommandParameter="5" AutomationProperties.Name="5 watts more" />
                    <Button Content="Use" Command="{Binding PowerSetCommand}" />
                  </StackPanel>
                  <TextBlock Text="{Binding PowerRange}" Classes="secondary" />
                  <TextBlock Text="{Binding PowerMessage}" TextWrapping="Wrap" Foreground="{DynamicResource CautionBrush}"
                             IsVisible="{Binding PowerMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                  <TextBlock Text="Changes the radio's power setting only; it does not transmit. Not while a transmission is on the air."
                             Classes="secondary" TextWrapping="Wrap" />
                </StackPanel>
              </Flyout>
            </Button.Flyout>
          </Button>
          <Button Content="Auto-select" Command="{Binding OffsetAutoCommand}"
                  ToolTip.Tip="Automatically pick a clear transmit channel" AutomationProperties.Name="Auto-select transmit channel" />
          <Button Content="{Binding CqText}" Command="{Binding ToggleCqCommand}" MinWidth="80" IsVisible="{Binding BarShowsCqAndSlot}" />
          <Button Content="{Binding TuneText}" Command="{Binding TuneCommand}" IsEnabled="{Binding CanTune}" MinWidth="70"
                  ToolTip.Tip="Starts the radio's own antenna tuner. A radio without one gets a steady tone at your transmit offset for up to 10 seconds instead. Click again to stop." />
          <Button Content="Halt Tx" Command="{Binding HaltCommand}" MinWidth="70" AutomationProperties.Name="Halt transmit"
                  Classes.critical="{Binding Transmitting}" />
          <!-- Instrument skins show the slot on the faceplate, so they hide this copy and the contact card's. -->
          <Panel IsVisible="{DynamicResource StandardSkin}">
            <StackPanel x:Name="BarSlot" Width="200" VerticalAlignment="Center" Margin="6,0,0,0" IsVisible="{Binding BarShowsCqAndSlot}">
              <DockPanel>
                <TextBlock DockPanel.Dock="Right" Text="{Binding SlotRemaining}" Classes="secondary num" />
                <TextBlock Text="{Binding SlotLabel}" Classes="secondary" />
              </DockPanel>
              <ProgressBar Value="{Binding SlotProgress}" Maximum="1" Height="4" MinHeight="4" Margin="0,4,0,0"
                           Foreground="{Binding Transmitting, Converter={x:Static v:Converters.ProgressBrush}}" />
            </StackPanel>
          </Panel>
          <ItemsControl ItemsSource="{Binding Indicators}" VerticalAlignment="Center">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Orientation="Horizontal" Spacing="10" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:IndicatorViewModel">
                <Button Classes="link" Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).OpenCommand}" CommandParameter="diagnostics"
                        ToolTip.Tip="{Binding Detail}">
                  <StackPanel Orientation="Horizontal" Spacing="4">
                    <Ellipse Width="8" Height="8" Fill="{Binding Health, Converter={x:Static v:Converters.HealthBrush}}" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding Text}" Classes="secondary" TextDecorations="{x:Null}" />
                  </StackPanel>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <TextBlock Text="{Binding RemoteText}" ToolTip.Tip="{Binding RemoteTip}" VerticalAlignment="Center" FontWeight="SemiBold"
                     Foreground="{DynamicResource AccentBrush}"
                     IsVisible="{Binding RemoteText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
        </StackPanel>
        <!-- Up to two lines, and the whole text as a tooltip, so a long fault ("... Settings > PSK and RTTY") is not cut short. -->
        <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" TextWrapping="Wrap" MaxLines="2"
                   ToolTip.Tip="{Binding StatusText}"
                   Foreground="{Binding StatusKind, Converter={x:Static v:Converters.KindBrush}}" AutomationProperties.LiveSetting="Polite" />
      </DockPanel>
      <!-- Drag the grip to make the waterfall taller; double-click it to go back to the compact strip. -->
      <Thumb x:Name="WaterfallGrip" Grid.Row="1" Height="8" Cursor="SizeNorthSouth" Focusable="True"
             ToolTip.Tip="Drag to resize the waterfall. Double-click to make it compact again."
             AutomationProperties.Name="Waterfall size; up and down arrows resize, Home makes it compact">
        <Thumb.Template>
          <ControlTemplate>
            <Border Background="Transparent">
              <Border x:Name="Pill" Width="44" Height="4" CornerRadius="2" HorizontalAlignment="Center" VerticalAlignment="Center"
                      Background="{DynamicResource ControlBorderBrush}" />
            </Border>
          </ControlTemplate>
        </Thumb.Template>
        <Thumb.Styles>
          <Style Selector="Thumb:pointerover /template/ Border#Pill, Thumb:pressed /template/ Border#Pill, Thumb:focus-visible /template/ Border#Pill">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
          </Style>
        </Thumb.Styles>
      </Thumb>
      <Grid x:Name="WaterfallStrip" Grid.Row="2">
        <v:WaterfallView x:Name="ReceiveWaterfall" Cursor="Cross" LabelInset="64"
                         ToolTip.Tip="Click between 200 and 2900 Hz to select your transmit channel. Red line: selected offset."
                         AutomationProperties.Name="Receive waterfall; click to select transmit channel" />
        <Button x:Name="PopOutButton" Classes="wfoverlay" Content="Pop out" HorizontalAlignment="Right" VerticalAlignment="Top"
                ToolTip.Tip="Open the waterfall in its own window" AutomationProperties.Name="Pop out the waterfall" />
      </Grid>
      </Grid>
    </Border>
  </Grid>
  </Border>
</Window>
