<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Ft8Client.App.ViewModels"
        xmlns:v="using:Ft8Client.App.Views"
        x:Class="Ft8Client.App.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="{Binding Title}"
        Width="1440" Height="900" MinWidth="1100" MinHeight="720">
  <!-- The whole window is outlined in red while the radio is keyed. -->
  <Border Classes="frame" Classes.onair="{Binding Transmitting}" BorderThickness="4">
    <Border.Styles>
      <Style Selector="Border.frame"><Setter Property="BorderBrush" Value="Transparent" /></Style>
      <Style Selector="Border.frame.onair"><Setter Property="BorderBrush" Value="{DynamicResource OnAirBrush}" /></Style>
    </Border.Styles>
  <Grid RowDefinitions="Auto,Auto,Auto,*,Auto">
    <!-- Top bar -->
    <DockPanel Grid.Row="0" Margin="16,8,16,8" LastChildFill="False">
      <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
        <TextBlock Text="Band" VerticalAlignment="Center" />
        <ComboBox ItemsSource="{Binding Bands}" SelectedItem="{Binding SelectedBand}" IsEnabled="{Binding CanChangeBand}" MinWidth="80"
                  AutomationProperties.Name="Band" />
        <TextBlock Text="Mode" VerticalAlignment="Center" Margin="8,0,0,0" />
        <ComboBox ItemsSource="{Binding Modes}" SelectedItem="{Binding SelectedMode}" IsEnabled="{Binding CanChangeBand}" MinWidth="70"
                  AutomationProperties.Name="Mode" />
        <TextBlock Text="{Binding Frequency}" FontSize="24" FontWeight="SemiBold" Classes="num" Margin="12,0,0,0" VerticalAlignment="Center"
                   AutomationProperties.Name="Dial frequency" />
        <TextBlock Text="MHz" Classes="secondary" VerticalAlignment="Bottom" Margin="0,0,0,6" />
      </StackPanel>
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
        <Button Classes="tab" Classes.selected="{Binding Tab, Converter={x:Static v:Converters.IntEquals}, ConverterParameter=0}"
                Content="Operate" Command="{Binding ShowTabCommand}" CommandParameter="0" ToolTip.Tip="Who to call next, ranked by what you need, and the contact in progress" />
        <Button Classes="tab" Classes.selected="{Binding Tab, Converter={x:Static v:Converters.IntEquals}, ConverterParameter=1}"
                Content="Raw decodes" Command="{Binding ShowTabCommand}" CommandParameter="1" ToolTip.Tip="Every decoded message, as the decoder printed it" />
        <Button Classes="tab" Classes.selected="{Binding Tab, Converter={x:Static v:Converters.IntEquals}, ConverterParameter=2}"
                Content="Reach" Command="{Binding ShowTabCommand}" CommandParameter="2" ToolTip.Tip="Who is hearing your signal, from PSK Reporter" />
        <Button Classes="tab" Classes.selected="{Binding Tab, Converter={x:Static v:Converters.IntEquals}, ConverterParameter=3}"
                Content="Log" Command="{Binding ShowTabCommand}" CommandParameter="3" ToolTip.Tip="Your contacts: search, edit, import and export" />
        <TextBlock Text="{Binding ClockText}" FontSize="16" FontWeight="SemiBold" Classes="num" Margin="12,0,4,0" VerticalAlignment="Center"
                   Foreground="{Binding ClockKind, Converter={x:Static v:Converters.KindBrush}}" ToolTip.Tip="{Binding ClockTip}"
                   AutomationProperties.Name="UTC clock" />
        <Button Content="☰" AutomationProperties.Name="Menu" Padding="10,4">
          <Button.Flyout>
            <MenuFlyout>
              <MenuItem Header="Settings" Command="{Binding OpenCommand}" CommandParameter="settings" />
              <MenuItem Header="Station setup" Command="{Binding OpenCommand}" CommandParameter="setup" />
              <MenuItem Header="Diagnostics" Command="{Binding OpenCommand}" CommandParameter="diagnostics" />
              <MenuItem Header="Keyboard shortcuts" Command="{Binding OpenCommand}" CommandParameter="shortcuts" />
              <MenuItem Header="About" Command="{Binding OpenCommand}" CommandParameter="about" />
            </MenuFlyout>
          </Button.Flyout>
        </Button>
      </StackPanel>
    </DockPanel>

    <!-- Views -->
    <!-- Update bar -->
    <!-- Radio state: red while keyed, yellow when no radio is connected. -->
    <Border Grid.Row="1" IsVisible="{Binding Transmitting}" Background="{DynamicResource OnAirBrush}" Padding="16,10"
            AutomationProperties.Name="On air" AutomationProperties.LiveSetting="Assertive">
      <DockPanel>
        <Button DockPanel.Dock="Right" Content="Halt (Esc)" Command="{Binding HaltCommand}" Background="White" Foreground="#D11F1F"
                FontWeight="SemiBold" Padding="14,4" />
        <TextBlock Text="{Binding OnAirText}" Foreground="White" FontSize="18" FontWeight="Bold" VerticalAlignment="Center"
                   TextTrimming="CharacterEllipsis" />
      </DockPanel>
    </Border>
    <Border Grid.Row="1" IsVisible="{Binding NoRadio}" Background="{DynamicResource NoRadioBrush}" Padding="16,8"
            AutomationProperties.Name="No radio connected">
      <DockPanel>
        <Button DockPanel.Dock="Right" Content="Station setup" Command="{Binding OpenCommand}" CommandParameter="setup"
                Background="#1A1A1A" Foreground="White" Padding="12,4" />
        <TextBlock Text="{Binding NoRadioText}" Foreground="#1A1A1A" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"
                   TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding NoRadioText}" />
      </DockPanel>
    </Border>

    <Border Grid.Row="2" IsVisible="{Binding Update.Visible}" Margin="16,0,16,8" Padding="12,8" CornerRadius="6"
            Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1">
      <DockPanel LastChildFill="True">
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8">
          <Button Content="Install and restart" Classes="accent" Command="{Binding Update.InstallCommand}" IsEnabled="{Binding !Update.Busy}" />
          <Button Content="Release notes" Command="{Binding Update.ReleaseNotesCommand}" />
          <Button Content="Skip this version" Command="{Binding Update.SkipCommand}" IsEnabled="{Binding !Update.Busy}" />
        </StackPanel>
        <DockPanel VerticalAlignment="Center" Margin="0,0,12,0">
          <TextBlock DockPanel.Dock="Left" Text="{Binding Update.Text}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,12,0" />
          <TextBlock Text="{Binding Update.Detail}" Classes="secondary" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                     ToolTip.Tip="{Binding Update.Detail}" />
        </DockPanel>
      </DockPanel>
    </Border>

    <Panel Grid.Row="3">
      <v:OperateView DataContext="{Binding Operate}" IsVisible="{Binding $parent[Window].((vm:MainViewModel)DataContext).Tab, Converter={x:Static v:Converters.IntEquals}, ConverterParameter=0}" />
      <v:RawDecodesView DataContext="{Binding Raw}" IsVisible="{Binding $parent[Window].((vm:MainViewModel)DataContext).Tab, Converter={x:Static v:Converters.IntEquals}, ConverterParameter=1}" />
      <v:ReachView DataContext="{Binding Reach}" IsVisible="{Binding $parent[Window].((vm:MainViewModel)DataContext).Tab, Converter={x:Static v:Converters.IntEquals}, ConverterParameter=2}" />
      <v:LogView DataContext="{Binding LogView}" IsVisible="{Binding $parent[Window].((vm:MainViewModel)DataContext).Tab, Converter={x:Static v:Converters.IntEquals}, ConverterParameter=3}" />
    </Panel>

    <!-- Bottom bar -->
    <Border Grid.Row="4" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="0,1,0,0" Background="{DynamicResource CardBackgroundBrush}">
      <DockPanel Margin="16,8">
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
          <Button Classes="link" AutomationProperties.Name="Transmit offset" VerticalAlignment="Center">
            <TextBlock Text="{Binding TxOffsetText}" Classes="secondary num" TextDecorations="{x:Null}" />
            <Button.Flyout>
              <Flyout>
                <StackPanel Spacing="8" Width="220">
                  <TextBlock Text="Transmit offset" Classes="title" />
                  <Button Content="Automatic (picks a clear spot)" Command="{Binding OffsetAutoCommand}" HorizontalAlignment="Stretch" />
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBox Text="{Binding ManualOffset}" Width="90" AutomationProperties.Name="Manual offset in hertz" />
                    <TextBlock Text="Hz" VerticalAlignment="Center" />
                    <Button Content="Use" Command="{Binding OffsetManualCommand}" />
                  </StackPanel>
                </StackPanel>
              </Flyout>
            </Button.Flyout>
          </Button>
          <Button Content="{Binding CqText}" Command="{Binding ToggleCqCommand}" MinWidth="80" />
          <Button Content="Halt Tx" Command="{Binding HaltCommand}" MinWidth="70" AutomationProperties.Name="Halt transmit"
                  Background="{Binding Transmitting, Converter={x:Static v:Converters.CriticalWhen}}" />
          <StackPanel Width="200" VerticalAlignment="Center" Margin="6,0,0,0">
            <DockPanel>
              <TextBlock DockPanel.Dock="Right" Text="{Binding SlotRemaining}" Classes="secondary num" />
              <TextBlock Text="{Binding SlotLabel}" Classes="secondary" />
            </DockPanel>
            <ProgressBar Value="{Binding SlotProgress}" Maximum="1" Height="4" MinHeight="4" Margin="0,4,0,0"
                         Foreground="{Binding Transmitting, Converter={x:Static v:Converters.ProgressBrush}}" />
          </StackPanel>
          <ItemsControl ItemsSource="{Binding Indicators}" VerticalAlignment="Center">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Orientation="Horizontal" Spacing="10" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:IndicatorViewModel">
                <Button Classes="link" Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).OpenCommand}" CommandParameter="diagnostics"
                        ToolTip.Tip="{Binding Detail}">
                  <StackPanel Orientation="Horizontal" Spacing="4">
                    <Ellipse Width="8" Height="8" Fill="{Binding Health, Converter={x:Static v:Converters.HealthBrush}}" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding Text}" Classes="secondary" TextDecorations="{x:Null}" />
                  </StackPanel>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
        <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                   Foreground="{Binding StatusKind, Converter={x:Static v:Converters.KindBrush}}" AutomationProperties.LiveSetting="Polite" />
      </DockPanel>
    </Border>
  </Grid>
  </Border>
</Window>
