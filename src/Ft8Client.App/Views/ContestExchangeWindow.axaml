<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Ft8Client.App.ViewModels"
        x:Class="Ft8Client.App.Views.ContestExchangeWindow"
        Icon="/Assets/costas.ico"
        x:DataType="vm:ContestExchangeViewModel"
        Title="{Binding Title}" Width="560" SizeToContent="Height" CanResize="False" WindowStartupLocation="CenterOwner">
  <StackPanel Margin="22,18" Spacing="10">
    <TextBlock Text="{Binding Title}" FontSize="20" FontWeight="SemiBold" />
    <TextBlock Classes="secondary" Text="Asked once. Change it any time from the contest bar on Operate." TextWrapping="Wrap" />
    <TextBlock Text="{Binding Prompt}" TextWrapping="Wrap" Margin="0,6,0,0" />
    <TextBox x:Name="ExchangeBox" Text="{Binding Exchange}" IsVisible="{Binding AsksForExchange}" Width="160" HorizontalAlignment="Left"
             FontFamily="{StaticResource MessageFont}" FontWeight="SemiBold" MaxLength="12"
             AutomationProperties.Name="{Binding Prompt}" />
    <TextBlock Classes="secondary" Text="{Binding Note}" TextWrapping="Wrap" />
    <Border BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}" BorderThickness="1" CornerRadius="6" Padding="14,10"
            IsVisible="{Binding HasPreview}">
      <ItemsControl ItemsSource="{Binding Preview}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:ContestPreviewLine">
            <Grid ColumnDefinitions="190,*" Margin="0,3">
              <TextBlock Text="{Binding When}" Classes="secondary" />
              <TextBlock Grid.Column="1" Text="{Binding Text}" FontFamily="{StaticResource MessageFont}" />
            </Grid>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </Border>
    <TextBlock Text="✓ Every message above can be sent exactly as shown." Foreground="{DynamicResource SuccessBrush}" IsVisible="{Binding CanStart}" />
    <TextBlock Text="{Binding Problem}" Foreground="{DynamicResource CautionBrush}" TextWrapping="Wrap"
               IsVisible="{Binding Problem, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" Margin="0,6,0,0">
      <Button Content="Cancel" IsCancel="True" Click="OnCancel" />
      <Button Content="Start contest" Classes="accent" IsDefault="True" IsEnabled="{Binding CanStart}" Click="OnStart" />
    </StackPanel>
  </StackPanel>
</Window>
