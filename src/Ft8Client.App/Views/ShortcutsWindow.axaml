<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Ft8Client.App.Views.ShortcutsWindow"
        Icon="/Assets/costas.ico"
        Title="Keyboard shortcuts" Width="480" Height="550" WindowStartupLocation="CenterOwner">
  <Grid ColumnDefinitions="110,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto" Margin="20">
    <TextBlock Grid.Row="0" Text="Enter" FontWeight="SemiBold" /><TextBlock Grid.Row="0" Grid.Column="1" Text="Call the selected station" Margin="0,0,0,8" />
    <TextBlock Grid.Row="1" Text="Up, Down" FontWeight="SemiBold" /><TextBlock Grid.Row="1" Grid.Column="1" Text="Move the selection in the line" Margin="0,0,0,8" />
    <TextBlock Grid.Row="2" Text="Esc" FontWeight="SemiBold" /><TextBlock Grid.Row="2" Grid.Column="1" Text="Halt Tx. In a contact: abandon it. Once reports are exchanged, the first press only stops transmitting and keeps listening; press again to abandon" TextWrapping="Wrap" Margin="0,0,0,8" />
    <TextBlock Grid.Row="3" Text="Ctrl+Q" FontWeight="SemiBold" /><TextBlock Grid.Row="3" Grid.Column="1" Text="Call CQ / stop CQ" Margin="0,0,0,8" />
    <TextBlock Grid.Row="4" Text="Ctrl+R" FontWeight="SemiBold" /><TextBlock Grid.Row="4" Grid.Column="1" Text="Resend" Margin="0,0,0,8" />
    <TextBlock Grid.Row="5" Text="Ctrl+L" FontWeight="SemiBold" /><TextBlock Grid.Row="5" Grid.Column="1" Text="Log now" Margin="0,0,0,8" />
    <TextBlock Grid.Row="6" Text="Ctrl+1 … 5" FontWeight="SemiBold" /><TextBlock Grid.Row="6" Grid.Column="1" Text="Operate, Raw decodes, Reach, Log, Awards" Margin="0,0,0,8" />
    <TextBlock Grid.Row="7" Text="Ctrl+Tab" FontWeight="SemiBold" /><TextBlock Grid.Row="7" Grid.Column="1" Text="Next view (Ctrl+Shift+Tab: previous)" Margin="0,0,0,8" />
    <TextBlock Grid.Row="8" Text="Ctrl+M" FontWeight="SemiBold" /><TextBlock Grid.Row="8" Grid.Column="1" Text="Mini mode: a small strip that stays on top" Margin="0,0,0,8" />
    <TextBlock Grid.Row="9" Text="F1" FontWeight="SemiBold" /><TextBlock Grid.Row="9" Grid.Column="1" Text="This list (in PSK and RTTY: the CQ macro)" Margin="0,0,0,16" />
    <TextBlock Grid.Row="10" Grid.ColumnSpan="2" Text="PSK and RTTY" FontWeight="SemiBold" Margin="0,0,0,8" />
    <TextBlock Grid.Row="11" Text="F1 … F12" FontWeight="SemiBold" /><TextBlock Grid.Row="11" Grid.Column="1" Text="Send that macro" Margin="0,0,0,8" />
    <TextBlock Grid.Row="12" Text="Enter" FontWeight="SemiBold" /><TextBlock Grid.Row="12" Grid.Column="1" TextWrapping="Wrap" Text="Send what is typed, or the next step's macro. While sending: a new line, or on an empty line return to receive. Esc stops at once." />
  </Grid>
</Window>
