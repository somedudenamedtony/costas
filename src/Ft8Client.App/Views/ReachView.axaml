<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Ft8Client.App.ViewModels"
             xmlns:v="using:Ft8Client.App.Views"
             x:Class="Ft8Client.App.Views.ReachView"
             x:DataType="vm:ReachViewModel">
  <!-- Map and stats take the top two thirds; Who heard you takes the bottom third and scrolls on its own. -->
  <Grid RowDefinitions="2*,*" Margin="16,0,16,12">
    <Border Grid.Row="0" Classes="card" Padding="14,12" Margin="0,0,0,12">
      <Grid RowDefinitions="Auto,Auto,*" ColumnDefinitions="*,380">
        <StackPanel Grid.ColumnSpan="2" Orientation="Horizontal" Spacing="8">
          <CheckBox x:Name="WorldView" Content="World" ToolTip.Tip="Show a globe you can drag to any part of the world" />
          <TextBlock Text="Band" VerticalAlignment="Center" />
          <ComboBox ItemsSource="{Binding Bands}" SelectedItem="{Binding Band}" MinWidth="80" />
          <TextBlock Text="Window" VerticalAlignment="Center" Margin="8,0,0,0" />
          <ComboBox ItemsSource="{Binding Windows}" SelectedItem="{Binding Window}" MinWidth="110" />
        </StackPanel>
        <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding Headline}" FontSize="15" TextWrapping="Wrap" Margin="0,8" />
        <Panel Grid.Row="2" Grid.Column="0" Margin="0,0,16,0">
          <v:StationMap x:Name="Globe" Reports="{Binding Points}" Centre="{Binding Centre}" World="True" IsVisible="False" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
          <v:ReachPlot x:Name="Plot" Points="{Binding Points}" Centre="{Binding Centre}" Units="{Binding Units}" />
          <StackPanel x:Name="ZoomControls" HorizontalAlignment="Left" VerticalAlignment="Top" Spacing="4">
            <Button x:Name="ZoomIn" Content="+" Width="32" Height="32" Padding="0" HorizontalContentAlignment="Center" FontSize="16"
                    ToolTip.Tip="Zoom in" AutomationProperties.Name="Zoom in" />
            <Button x:Name="ZoomOut" Content="−" Width="32" Height="32" Padding="0" HorizontalContentAlignment="Center" FontSize="16"
                    ToolTip.Tip="Zoom out" AutomationProperties.Name="Zoom out" />
            <Button x:Name="ZoomReset" Content="⤢" Width="32" Height="32" Padding="0" HorizontalContentAlignment="Center"
                    ToolTip.Tip="Show the whole map" AutomationProperties.Name="Show the whole map" />
            <TextBlock x:Name="ZoomText" Classes="secondary" FontSize="12" HorizontalAlignment="Center" />
          </StackPanel>
        </Panel>
        <ScrollViewer Grid.Row="2" Grid.Column="1" VerticalScrollBarVisibility="Auto">
          <StackPanel Spacing="6">
            <TextBlock Text="Band activity near you" Classes="title" />
            <TextBlock Text="Spots of stations near you, last 15 minutes, by the continent that heard them. Hover over a row for details."
                       Classes="secondary" FontSize="12" TextWrapping="Wrap" />
            <TextBlock Text="{Binding BandActivityStatus}" Classes="secondary" TextWrapping="Wrap"
                       IsVisible="{Binding BandActivityStatus, Converter={x:Static v:Converters.NotEmpty}}" />
            <!-- One compact row per band with spots: a continent heat map, the total and the countries I still need there.
                 Bands with no spots fold into a single line underneath. -->
            <StackPanel Spacing="2" IsVisible="{Binding HasBandActivityRows}" AutomationProperties.Name="Band activity near you">
              <Grid ColumnDefinitions="46,190,50,*" Margin="0,4,0,0">
                <TextBlock Text="Band" Classes="secondary" FontSize="11" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2">
                  <TextBlock Text="NA" Width="29" TextAlignment="Center" Classes="secondary" FontSize="11" />
                  <TextBlock Text="SA" Width="29" TextAlignment="Center" Classes="secondary" FontSize="11" />
                  <TextBlock Text="EU" Width="29" TextAlignment="Center" Classes="secondary" FontSize="11" />
                  <TextBlock Text="AF" Width="29" TextAlignment="Center" Classes="secondary" FontSize="11" />
                  <TextBlock Text="AS" Width="29" TextAlignment="Center" Classes="secondary" FontSize="11" />
                  <TextBlock Text="OC" Width="29" TextAlignment="Center" Classes="secondary" FontSize="11" />
                </StackPanel>
                <TextBlock Grid.Column="2" Text="Spots" Classes="secondary" FontSize="11" TextAlignment="Right" Margin="0,0,8,0" />
                <TextBlock Grid.Column="3" Text="You need" Classes="secondary" FontSize="11" />
              </Grid>
              <ItemsControl ItemsSource="{Binding BandActivity}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:BandChoiceViewModel">
                    <Border IsVisible="{Binding InGrid}" CornerRadius="3" Margin="0,1"
                            Background="{Binding IsCurrent, Converter={x:Static v:Converters.SelectedBackground}}"
                            ToolTip.Tip="{Binding Tip}" AutomationProperties.Name="{Binding Name}">
                      <Grid ColumnDefinitions="46,190,50,*" MinHeight="24">
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="2,0,0,0" />
                        <ItemsControl Grid.Column="1" ItemsSource="{Binding Continents}" VerticalAlignment="Center" IsVisible="{Binding !NotFollowed}"
                                      AutomationProperties.Name="Heard in">
                          <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="2" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                          <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:ContinentChip">
                              <Border Width="29" Height="20" CornerRadius="3" BorderThickness="1" ToolTip.Tip="{Binding Tip}"
                                      Background="{Binding Level, Converter={x:Static v:Converters.ShadeBackground}}"
                                      BorderBrush="{Binding Level, Converter={x:Static v:Converters.ShadeBorder}}">
                                <TextBlock Text="{Binding Count}" FontSize="11" Classes="num" HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Foreground="{Binding Level, Converter={x:Static v:Converters.ShadeForeground}}" />
                              </Border>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Grid.Column="1" Grid.ColumnSpan="3" Text="{Binding SpotsText}" Classes="secondary" FontSize="12" FontStyle="Italic"
                                   VerticalAlignment="Center" IsVisible="{Binding NotFollowed}" />
                        <TextBlock Grid.Column="2" Text="{Binding SpotsCount}" Classes="num" FontSize="12" TextAlignment="Right" Margin="0,0,8,0"
                                   VerticalAlignment="Center" IsVisible="{Binding !NotFollowed}" />
                        <TextBlock Grid.Column="3" Text="{Binding NeedShort}" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                   Foreground="{DynamicResource CautionBrush}" ToolTip.Tip="{Binding NeedTip}" IsVisible="{Binding !NotFollowed}" />
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
            <TextBlock Text="{Binding QuietBands}" Classes="secondary" FontSize="12" TextWrapping="Wrap" Margin="2,2,0,0"
                       IsVisible="{Binding QuietBands, Converter={x:Static v:Converters.NotEmpty}}" />
            <TextBlock Text="{Binding ByCountryTitle}" Classes="title" IsVisible="{Binding !Empty}" />
            <Grid ColumnDefinitions="*,70,60,100" IsVisible="{Binding !Empty}">
              <TextBlock Text="Country" Classes="secondary" /><TextBlock Grid.Column="1" Text="Stations" Classes="secondary" />
              <TextBlock Grid.Column="2" Text="Best" Classes="secondary" /><TextBlock Grid.Column="3" Text="Farthest" Classes="secondary" />
            </Grid>
            <ItemsControl ItemsSource="{Binding ByCountry}" AutomationProperties.Name="Countries that heard you">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:CountryReachRowViewModel">
                  <Grid ColumnDefinitions="*,70,60,100" MinHeight="28" Background="Transparent" ToolTip.Tip="{Binding Tip}">
                    <TextBlock Text="{Binding Country}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Column="1" Text="{Binding StationsText}" Classes="num" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="2" Text="{Binding Best}" Classes="num" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="3" Text="{Binding Farthest}" Classes="num" VerticalAlignment="Center" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Text="By band, last 24 hours" Classes="title" Margin="0,12,0,0" />
            <Grid ColumnDefinitions="70,90,110,*">
              <TextBlock Text="Band" Classes="secondary" /><TextBlock Grid.Column="1" Text="Stations" Classes="secondary" />
              <TextBlock Grid.Column="2" Text="Farthest" Classes="secondary" /><TextBlock Grid.Column="3" Text="Median report" Classes="secondary" />
            </Grid>
            <ItemsControl ItemsSource="{Binding ByBand}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:BandReachRowViewModel">
                  <Border Background="{Binding Current, Converter={x:Static v:Converters.SelectedBackground}}">
                    <Grid ColumnDefinitions="70,90,110,*" MinHeight="28">
                      <TextBlock Text="{Binding Band}" VerticalAlignment="Center" />
                      <TextBlock Grid.Column="1" Text="{Binding Stations}" Classes="num" VerticalAlignment="Center" />
                      <TextBlock Grid.Column="2" Text="{Binding Farthest}" Classes="num" VerticalAlignment="Center" />
                      <TextBlock Grid.Column="3" Text="{Binding Median}" Classes="num" VerticalAlignment="Center" />
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Text="Compared with stations near you" Classes="title" Margin="0,12,0,0" />
            <TextBlock Text="{Binding NeighbourHeadline}" TextWrapping="Wrap" />
            <TextBlock Text="{Binding NeighbourBasis}" Classes="secondary" FontSize="12" TextWrapping="Wrap"
                       IsVisible="{Binding NeighbourBasis, Converter={x:Static v:Converters.NotEmpty}}" />
            <Grid ColumnDefinitions="110,50,50,70,*" IsVisible="{Binding HasNeighbourRows}">
              <TextBlock Text="Toward" Classes="secondary" /><TextBlock Grid.Column="1" Text="You" Classes="secondary" />
              <TextBlock Grid.Column="2" Text="Them" Classes="secondary" /><TextBlock Grid.Column="3" Text="Receivers" Classes="secondary" />
              <TextBlock Grid.Column="4" Text="Difference" Classes="secondary" />
            </Grid>
            <ItemsControl ItemsSource="{Binding NeighbourRows}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:NeighbourRowViewModel">
                  <Grid ColumnDefinitions="110,50,50,70,*" MinHeight="28">
                    <TextBlock Text="{Binding Toward}" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="{Binding Mine}" Classes="num" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="2" Text="{Binding Theirs}" Classes="num secondary" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="3" Text="{Binding Receivers}" Classes="num secondary" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="4" Text="{Binding Difference}" VerticalAlignment="Center" FontWeight="SemiBold"
                               Foreground="{Binding Weaker, Converter={x:Static v:Converters.CautionWhen}}" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Text="Did a change help?" Classes="title" Margin="0,12,0,0" />
            <TextBlock Text="{Binding HistoryNote}" Classes="secondary" FontSize="12" TextWrapping="Wrap" />
            <ItemsControl ItemsSource="{Binding HistoryRows}" IsVisible="{Binding HasHistory}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:NeighbourHistoryRowViewModel">
                  <StackPanel Spacing="2" Margin="0,4,0,4">
                    <TextBlock Text="{Binding Sentence}" TextWrapping="Wrap" />
                    <v:NeighbourHistoryChart Values="{Binding Days}" MarkIndex="{Binding MarkIndex}" Height="64"
                                             ToolTip.Tip="{Binding Tip}" AutomationProperties.Name="{Binding Sentence}" />
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Text="{Binding MarkText}" Classes="secondary" FontSize="12" TextWrapping="Wrap"
                       IsVisible="{Binding MarkText, Converter={x:Static v:Converters.NotEmpty}}" />
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
              <TextBox Text="{Binding ChangeNote}" PlaceholderText="What changed? (optional)" MaxLength="60"
                       IsVisible="{Binding !MarkedToday}" AutomationProperties.Name="What changed" />
              <Button Grid.Column="1" Content="{Binding MarkButtonText}" Command="{Binding ToggleMarkCommand}"
                      ToolTip.Tip="Mark today as the day you changed your antenna or station. The lines above then compare before and after." />
            </Grid>
            <TextBlock x:Name="MapHelp" Text="You are at the centre, north is up. Bigger, darker dots are stronger reports. Hover over a dot for its call."
                       Classes="secondary" TextWrapping="Wrap" Margin="0,12,0,0" />
            <TextBlock x:Name="ZoomHelp" Text="Scroll or use + and − to zoom, drag to move around, double-click to see the whole map."
                       Classes="secondary" TextWrapping="Wrap" />
          </StackPanel>
        </ScrollViewer>
      </Grid>
    </Border>
    <Border Grid.Row="1" Classes="card" Padding="14,12">
      <Grid RowDefinitions="Auto,Auto,*">
        <TextBlock Text="Who heard you" Classes="title" Margin="0,0,0,6" />
        <Grid Grid.Row="1" ColumnDefinitions="100,200,90,70,50,80,*" Margin="0,0,16,0">
          <TextBlock Text="Station" Classes="secondary" /><TextBlock Grid.Column="1" Text="Where" Classes="secondary" />
          <TextBlock Grid.Column="2" Text="Distance" Classes="secondary" /><TextBlock Grid.Column="3" Text="Bearing" Classes="secondary" />
          <TextBlock Grid.Column="4" Text="dB" Classes="secondary" /><TextBlock Grid.Column="5" Text="Age" Classes="secondary" />
          <TextBlock Grid.Column="6" Text="In your log" Classes="secondary" />
        </Grid>
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="0,0,16,0">
            <TextBlock Text="No reports yet. Reports appear a few minutes after you transmit." Classes="secondary" IsVisible="{Binding Empty}" Margin="0,8" />
            <ItemsControl ItemsSource="{Binding Rows}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:ReachRowViewModel">
                  <Grid ColumnDefinitions="100,200,90,70,50,80,*" MinHeight="28">
                    <TextBlock Text="{Binding Station}" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="{Binding Where}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Column="2" Text="{Binding Distance}" Classes="num" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="3" Text="{Binding Bearing}" Classes="num" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="4" Text="{Binding Db}" Classes="num" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="5" Text="{Binding Age}" Classes="secondary" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="6" Text="{Binding InLog}" VerticalAlignment="Center" Foreground="{Binding InLogKind, Converter={x:Static v:Converters.KindBrush}}" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </ScrollViewer>
      </Grid>
    </Border>
  </Grid>
</UserControl>
