<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Ft8Client.App.ViewModels"
             xmlns:v="using:Ft8Client.App.Views"
             x:Class="Ft8Client.App.Views.ContestView"
             x:DataType="vm:ContestViewModel">
  <UserControl.Styles>
    <Style Selector="Border.tile">
      <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="14,10" />
    </Style>
    <Style Selector="TextBlock.big">
      <Setter Property="FontSize" Value="32" />
      <Setter Property="FontWeight" Value="Bold" />
    </Style>
  </UserControl.Styles>
  <!-- Score and multipliers across the top, the contest log below. Contacts are worked on Operate. -->
  <Grid RowDefinitions="Auto,*" ColumnDefinitions="*,Auto" Margin="16,0,16,12" RowSpacing="12" ColumnSpacing="12">
    <Border Classes="card" Padding="18,12">
      <StackPanel Spacing="12">
        <DockPanel>
          <Button DockPanel.Dock="Right" Content="Export Cabrillo…" Command="{Binding ExportCommand}" VerticalAlignment="Center"
                  ToolTip.Tip="Save the contest log as a Cabrillo file to send to the contest sponsor. Dupes are included, as the rules ask." />
          <TextBlock VerticalAlignment="Center" TextWrapping="Wrap">
            <Run Text="{Binding Title}" FontSize="20" FontWeight="SemiBold" /><Run Text="   " /><Run Text="{Binding Since}" Classes="secondary" />
          </TextBlock>
        </DockPanel>
        <UniformGrid Rows="1" ColumnSpacing="12">
          <Border Classes="tile">
            <StackPanel>
              <TextBlock Text="Contacts" Classes="secondary" />
              <TextBlock Text="{Binding Contacts}" Classes="big num" />
              <TextBlock Text="{Binding ContactsDetail}" Classes="secondary" TextWrapping="Wrap" />
            </StackPanel>
          </Border>
          <Border Classes="tile" IsVisible="{Binding HasMults}">
            <StackPanel>
              <TextBlock Text="Mults" Classes="secondary" />
              <TextBlock Text="{Binding Mults}" Classes="big num" />
              <TextBlock Text="{Binding MultsDetail}" Classes="secondary" TextWrapping="Wrap" />
            </StackPanel>
          </Border>
          <Border Classes="tile">
            <StackPanel>
              <TextBlock Text="Claimed score" Classes="secondary" />
              <TextBlock Text="{Binding Score}" Classes="big num" />
              <TextBlock Text="{Binding ScoreDetail}" Classes="secondary" TextWrapping="Wrap" />
            </StackPanel>
          </Border>
          <Border Classes="tile">
            <StackPanel>
              <TextBlock Text="Rate" Classes="secondary" />
              <TextBlock><Run Text="{Binding Rate}" FontSize="32" FontWeight="Bold" /><Run Text=" /h" Classes="secondary" /></TextBlock>
              <TextBlock Text="{Binding RateDetail}" Classes="secondary" TextWrapping="Wrap" />
            </StackPanel>
          </Border>
        </UniformGrid>
        <StackPanel MaxWidth="520" HorizontalAlignment="Left">
          <Grid ColumnDefinitions="140,140,140" Margin="4,0">
            <TextBlock Text="Band" Classes="secondary" />
            <TextBlock Grid.Column="1" Text="Contacts" Classes="secondary" />
            <TextBlock Grid.Column="2" Text="Mults" Classes="secondary" IsVisible="{Binding HasMults}" />
          </Grid>
          <ItemsControl ItemsSource="{Binding Bands}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:ContestBandRowViewModel">
                <Border BorderBrush="{DynamicResource RowDividerBrush}" BorderThickness="0,1,0,0" Padding="4,6">
                  <Grid ColumnDefinitions="140,140,140">
                    <TextBlock Text="{Binding Band}" />
                    <TextBlock Grid.Column="1" Text="{Binding Contacts}" Classes="num" />
                    <TextBlock Grid.Column="2" Text="{Binding Mults}" Classes="num"
                               IsVisible="{Binding $parent[UserControl].((vm:ContestViewModel)DataContext).HasMults}" />
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </StackPanel>
    </Border>

    <Border Grid.Column="1" Classes="card" Padding="18,12" Width="420">
      <StackPanel Spacing="10">
        <TextBlock><Run Text="Multipliers" FontWeight="SemiBold" FontSize="16" /><Run Text=" · worked in green" Classes="secondary" /></TextBlock>
        <ItemsControl ItemsSource="{Binding MultChips}">
          <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel ItemSpacing="6" LineSpacing="6" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:ContestMultChip">
              <Border MinWidth="40" Padding="6,3" CornerRadius="4" BorderThickness="1"
                      BorderBrush="{Binding Worked, Converter={x:Static v:Converters.WorkedBorder}}">
                <TextBlock Text="{Binding Name}" HorizontalAlignment="Center" FontFamily="{StaticResource MessageFont}" FontWeight="SemiBold"
                           Foreground="{Binding Worked, Converter={x:Static v:Converters.WorkedText}}" />
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <TextBlock Text="{Binding MultsNote}" Classes="secondary" TextWrapping="Wrap" />
      </StackPanel>
    </Border>

    <Border Grid.Row="1" Grid.ColumnSpan="2" Classes="card" Padding="18,12">
      <DockPanel>
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
          <StackPanel DockPanel.Dock="Right" Width="320" Spacing="4">
            <TextBox Text="{Binding DupeCheck}" PlaceholderText="Dupe check: type a call…" AutomationProperties.Name="Dupe check" />
            <TextBlock Text="{Binding DupeAnswer}" TextWrapping="Wrap" FontWeight="SemiBold"
                       Foreground="{Binding DupeFound, Converter={x:Static v:Converters.DupeBrush}}"
                       IsVisible="{Binding DupeAnswer, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
          </StackPanel>
          <TextBlock Text="Contest log" Classes="title" VerticalAlignment="Top" />
        </DockPanel>
        <TextBlock DockPanel.Dock="Bottom" Text="{Binding LogNote}" Classes="secondary" TextWrapping="Wrap" Margin="0,8,0,0" />
        <Grid DockPanel.Dock="Top" ColumnDefinitions="90,90,160,160,160,*" Margin="4,0,4,4">
          <TextBlock Text="UTC" Classes="secondary" />
          <TextBlock Grid.Column="1" Text="Band" Classes="secondary" />
          <TextBlock Grid.Column="2" Text="Call" Classes="secondary" />
          <TextBlock Grid.Column="3" Text="Sent" Classes="secondary" />
          <TextBlock Grid.Column="4" Text="Received" Classes="secondary" />
        </Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <ItemsControl ItemsSource="{Binding Log}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:ContestLogRowViewModel">
                <Border BorderBrush="{DynamicResource RowDividerBrush}" BorderThickness="0,1,0,0" Padding="4,6" Opacity="{Binding Dupe, Converter={x:Static v:Converters.DupeOpacity}}">
                  <Grid ColumnDefinitions="90,90,160,160,160,*">
                    <TextBlock Text="{Binding Time}" Classes="num" />
                    <TextBlock Grid.Column="1" Text="{Binding Band}" />
                    <TextBlock Grid.Column="2" Text="{Binding Call}" FontWeight="SemiBold" />
                    <TextBlock Grid.Column="3" Text="{Binding Sent}" FontFamily="{StaticResource MessageFont}" />
                    <TextBlock Grid.Column="4" Text="{Binding Received}" FontFamily="{StaticResource MessageFont}" />
                    <TextBlock Grid.Column="5" Text="{Binding Tag}" IsVisible="{Binding HasTag}" FontWeight="SemiBold"
                               Foreground="{Binding Dupe, Converter={x:Static v:Converters.DupeBrush}}" />
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </DockPanel>
    </Border>
  </Grid>
</UserControl>
