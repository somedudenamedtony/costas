<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Ft8Client.App.ViewModels"
             xmlns:v="using:Ft8Client.App.Views"
             x:Class="Ft8Client.App.Views.RawDecodesView"
             x:DataType="vm:RawDecodesViewModel">
  <Border Classes="card" Margin="16,0,16,12" Padding="14,10">
    <Grid RowDefinitions="Auto,Auto,*">
      <DockPanel>
        <Button DockPanel.Dock="Right" Content="Jump to live" Command="{Binding JumpToLiveCommand}" IsVisible="{Binding ScrolledAway}" />
        <StackPanel Orientation="Horizontal" Spacing="8">
          <TextBox Text="{Binding Filter}" PlaceholderText="Filter by callsign, text or country" Width="260" AutomationProperties.Name="Filter" />
          <ComboBox ItemsSource="{Binding ShowChoices}" SelectedItem="{Binding Show}" MinWidth="150" AutomationProperties.Name="Show" />
          <Button Classes="link" Content="Clear filters" Command="{Binding ClearFiltersCommand}" IsVisible="{Binding Filtered}" VerticalAlignment="Center" />
          <TextBlock Text="{Binding Count}" Classes="secondary" VerticalAlignment="Center" IsVisible="{Binding Filtered}" />
        </StackPanel>
      </DockPanel>
      <Grid Grid.Row="1" ColumnDefinitions="70,70,50,50,60,320,170,90,*" Margin="8,10,0,4">
        <TextBlock Text="UTC" Classes="secondary" />
        <TextBlock Grid.Column="1" Text="Local" Classes="secondary" />
        <TextBlock Grid.Column="2" Text="dB" Classes="secondary" />
        <TextBlock Grid.Column="3" Text="DT" Classes="secondary" />
        <TextBlock Grid.Column="4" Text="Hz" Classes="secondary" />
        <TextBlock Grid.Column="5" Text="Message" Classes="secondary" />
        <TextBlock Grid.Column="6" Text="Country" Classes="secondary" />
        <TextBlock Grid.Column="7" Text="Distance" Classes="secondary" />
        <TextBlock Grid.Column="8" Text="Why" Classes="secondary" />
      </Grid>
      <ListBox Grid.Row="2" x:Name="List" ItemsSource="{Binding Lines}" Background="Transparent" AutomationProperties.Name="Raw decodes">
        <ListBox.ContextMenu>
          <ContextMenu x:Name="LineMenu">
            <MenuItem x:Name="CallItem" Header="Call" Click="OnCall" />
            <MenuItem x:Name="OnlyItem" Header="Show only" Click="OnShowOnly" />
            <MenuItem Header="Copy line" Click="OnCopy" />
          </ContextMenu>
        </ListBox.ContextMenu>
        <ListBox.Styles>
          <Style Selector="ListBoxItem"><Setter Property="Padding" Value="0" /><Setter Property="MinHeight" Value="0" /></Style>
        </ListBox.Styles>
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="vm:RawLineViewModel">
            <Panel Background="{Binding ., Converter={x:Static v:Converters.RawBackground}}">
              <Border Width="3" HorizontalAlignment="Left" Background="{Binding IsPartner, Converter={x:Static v:Converters.SelectedBar}}" />
              <Grid ColumnDefinitions="70,70,50,50,60,320,170,90,*" MinHeight="20" Margin="8,0,0,0">
                <TextBlock Text="{Binding Utc}" Classes="message" Foreground="{Binding ., Converter={x:Static v:Converters.RawForeground}}" />
                <TextBlock Grid.Column="1" Text="{Binding Local}" Classes="message" Foreground="{Binding ., Converter={x:Static v:Converters.RawForeground}}" />
                <TextBlock Grid.Column="2" Text="{Binding Db}" Classes="message" Foreground="{Binding ., Converter={x:Static v:Converters.RawForeground}}" />
                <TextBlock Grid.Column="3" Text="{Binding Dt}" Classes="message" Foreground="{Binding ., Converter={x:Static v:Converters.RawForeground}}" />
                <TextBlock Grid.Column="4" Text="{Binding Hz}" Classes="message" Foreground="{Binding ., Converter={x:Static v:Converters.RawForeground}}" />
                <TextBlock Grid.Column="5" Text="{Binding Message}" Classes="message" Foreground="{Binding ., Converter={x:Static v:Converters.RawForeground}}" />
                <TextBlock Grid.Column="6" Text="{Binding Country}" Classes="secondary" TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="7" Text="{Binding Distance}" Classes="secondary" />
                <TextBlock Grid.Column="8" Text="{Binding Need}" Foreground="{Binding NeedKind, Converter={x:Static v:Converters.KindBrush}}" TextTrimming="CharacterEllipsis" />
              </Grid>
            </Panel>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </Grid>
  </Border>
</UserControl>
