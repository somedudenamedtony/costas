<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Ft8Client.App.ViewModels"
             xmlns:v="using:Ft8Client.App.Views"
             x:Class="Ft8Client.App.Views.RawDecodesView"
             x:DataType="vm:RawDecodesViewModel">
  <Border Classes="card" Margin="16,0,16,12" Padding="14,10">
    <Grid RowDefinitions="Auto,Auto,*">
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8">
          <Button Content="Jump to live" Command="{Binding JumpToLiveCommand}" IsVisible="{Binding ScrolledAway}" />
          <TextBlock Text="{Binding ClearedAt}" Classes="secondary" VerticalAlignment="Center" IsVisible="{Binding Cleared}" />
          <Button Classes="link" Content="Show earlier lines" Command="{Binding ShowEarlierCommand}" IsVisible="{Binding Cleared}" VerticalAlignment="Center" />
          <Button Content="Clear" Command="{Binding ClearCommand}" AutomationProperties.Name="Clear raw decodes"
                  ToolTip.Tip="Empty this list. New lines keep arriving; the station list and the log are not touched." />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="8">
          <TextBox Text="{Binding Filter}" PlaceholderText="Filter by callsign, text or country" Width="260" AutomationProperties.Name="Filter" />
          <ItemsControl ItemsSource="{Binding ShowOptions}" VerticalAlignment="Center">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="6" /></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:ShowOptionViewModel">
                <Button Classes="chip" Classes.selected="{Binding IsSelected}"
                        Command="{Binding $parent[UserControl].((vm:RawDecodesViewModel)DataContext).PickShowCommand}" CommandParameter="{Binding Choice}">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="{Binding Label}" VerticalAlignment="Center" />
                    <Border Classes="badge"><TextBlock Text="{Binding Count}" FontSize="12" TextAlignment="Center" /></Border>
                  </StackPanel>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <Button Classes="link" Content="Clear filters" Command="{Binding ClearFiltersCommand}" IsVisible="{Binding Filtered}" VerticalAlignment="Center" />
        </StackPanel>
      </DockPanel>
      <Border Grid.Row="1" BorderBrush="{DynamicResource RowDividerBrush}" BorderThickness="0,0,0,1" Margin="0,12,0,0" Padding="11,0,0,6">
        <Grid ColumnDefinitions="70,70,44,36,46,60,16,*,170,90,150">
          <TextBlock Text="UTC" Classes="colhead" />
          <TextBlock Grid.Column="1" Text="Local" Classes="colhead" />
          <TextBlock Grid.Column="2" Text="dB" Classes="colhead" TextAlignment="Right" Margin="0,0,6,0" />
          <TextBlock Grid.Column="4" Text="DT" Classes="colhead" TextAlignment="Right" Margin="0,0,8,0" />
          <TextBlock Grid.Column="5" Text="Hz" Classes="colhead" TextAlignment="Right" />
          <TextBlock Grid.Column="7" Text="Message" Classes="colhead" />
          <TextBlock Grid.Column="8" Text="Country" Classes="colhead" />
          <TextBlock Grid.Column="9" Text="Distance" Classes="colhead" TextAlignment="Right" Margin="0,0,14,0" />
          <TextBlock Grid.Column="10" Text="Why" Classes="colhead" />
        </Grid>
      </Border>
      <ListBox Grid.Row="2" x:Name="List" ItemsSource="{Binding Lines}" Background="Transparent" AutomationProperties.Name="Raw decodes">
        <ListBox.ContextMenu>
          <ContextMenu x:Name="LineMenu">
            <MenuItem x:Name="CallItem" Header="Call" Click="OnCall" />
            <MenuItem x:Name="OnlyItem" Header="Show only" Click="OnShowOnly" />
            <MenuItem Header="Copy line" Click="OnCopy" />
          </ContextMenu>
        </ListBox.ContextMenu>
        <ListBox.Styles>
          <Style Selector="ListBoxItem"><Setter Property="Padding" Value="0" /><Setter Property="MinHeight" Value="0" /></Style>
        </ListBox.Styles>
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="vm:RawLineViewModel">
            <Panel>
              <!-- Slot heading: time, then what the slot held, on a thin rule. -->
              <DockPanel IsVisible="{Binding IsHeading}" Margin="11,10,0,3">
                <TextBlock DockPanel.Dock="Left" Text="{Binding Heading}" Classes="message" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                <TextBlock DockPanel.Dock="Left" Text="{Binding Summary}" Classes="secondary" FontSize="12" Margin="14,0,12,0" VerticalAlignment="Center" />
                <Border Height="1" Background="{DynamicResource RowDividerBrush}" VerticalAlignment="Center" />
              </DockPanel>
              <Panel IsVisible="{Binding IsLine}" Background="{Binding ., Converter={x:Static v:Converters.RawBackground}}">
                <Border Width="3" HorizontalAlignment="Left" Background="{Binding IsPartner, Converter={x:Static v:Converters.SelectedBar}}" />
                <Grid ColumnDefinitions="70,70,44,36,46,60,16,*,170,90,150" MinHeight="22" Margin="11,0,0,0">
                  <TextBlock Text="{Binding Utc}" Classes="message" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                  <TextBlock Grid.Column="1" Text="{Binding Local}" Classes="message" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                  <TextBlock Grid.Column="2" Text="{Binding Db}" Classes="message" TextAlignment="Right" Margin="0,0,6,0" VerticalAlignment="Center" Foreground="{Binding ., Converter={x:Static v:Converters.RawForeground}}" />
                  <!-- Signal bar: a quick read of strength next to the number. -->
                  <Panel Grid.Column="3" Width="28" Height="6" HorizontalAlignment="Left" VerticalAlignment="Center" IsVisible="{Binding HasSnr}">
                    <Border CornerRadius="3" Background="{DynamicResource RowDividerBrush}" />
                    <Border CornerRadius="3" HorizontalAlignment="Left" Width="{Binding SnrWidth}" Background="{DynamicResource SuccessBrush}" Opacity="0.85" />
                  </Panel>
                  <TextBlock Grid.Column="4" Text="{Binding Dt}" Classes="message" TextAlignment="Right" Margin="0,0,8,0" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" />
                  <TextBlock Grid.Column="5" Text="{Binding Hz}" Classes="message" TextAlignment="Right" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" />
                  <TextBlock Grid.Column="7" Text="{Binding Message}" Classes="message" Foreground="{Binding ., Converter={x:Static v:Converters.RawForeground}}"
                             TextTrimming="CharacterEllipsis" Margin="0,0,12,0" VerticalAlignment="Center" ToolTip.Tip="{Binding Message}" />
                  <TextBlock Grid.Column="8" Text="{Binding Country}" Classes="secondary" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                  <TextBlock Grid.Column="9" Text="{Binding Distance}" Classes="secondary" TextAlignment="Right" Margin="0,0,14,0" VerticalAlignment="Center" />
                  <!-- Why as a tinted tag, as in the station list. -->
                  <Panel Grid.Column="10" HorizontalAlignment="Left" VerticalAlignment="Center" IsVisible="{Binding HasNeed}">
                    <Border CornerRadius="9" Background="{Binding NeedKind, Converter={x:Static v:Converters.KindBrush}}" Opacity="0.16" />
                    <TextBlock Text="{Binding Need}" FontSize="12" Margin="8,1" Foreground="{Binding NeedKind, Converter={x:Static v:Converters.KindBrush}}" TextTrimming="CharacterEllipsis" />
                  </Panel>
                </Grid>
              </Panel>
            </Panel>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </Grid>
  </Border>
</UserControl>
