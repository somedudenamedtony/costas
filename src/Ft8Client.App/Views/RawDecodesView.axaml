<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Ft8Client.App.ViewModels"
             xmlns:v="using:Ft8Client.App.Views"
             x:Class="Ft8Client.App.Views.RawDecodesView"
             x:DataType="vm:RawDecodesViewModel">
  <Border Classes="card" Margin="16,0,16,12" Padding="14,10">
    <Grid RowDefinitions="Auto,Auto,*">
      <DockPanel>
        <Button DockPanel.Dock="Right" Content="Jump to live" Command="{Binding JumpToLiveCommand}" IsVisible="{Binding ScrolledAway}" />
        <TextBox Text="{Binding Filter}" PlaceholderText="Filter by callsign or text" Width="260" HorizontalAlignment="Left" AutomationProperties.Name="Filter" />
      </DockPanel>
      <Grid Grid.Row="1" ColumnDefinitions="70,70,50,50,60,320,*" Margin="0,10,0,4">
        <TextBlock Text="UTC" Classes="secondary" />
        <TextBlock Grid.Column="1" Text="Local" Classes="secondary" />
        <TextBlock Grid.Column="2" Text="dB" Classes="secondary" />
        <TextBlock Grid.Column="3" Text="DT" Classes="secondary" />
        <TextBlock Grid.Column="4" Text="Hz" Classes="secondary" />
        <TextBlock Grid.Column="5" Text="Message" Classes="secondary" />
        <TextBlock Grid.Column="6" Text="Country" Classes="secondary" />
      </Grid>
      <ListBox Grid.Row="2" x:Name="List" ItemsSource="{Binding Lines}" Background="Transparent" AutomationProperties.Name="Raw decodes">
        <ListBox.Styles>
          <Style Selector="ListBoxItem"><Setter Property="Padding" Value="0" /><Setter Property="MinHeight" Value="0" /></Style>
        </ListBox.Styles>
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="vm:RawLineViewModel">
            <Grid ColumnDefinitions="70,70,50,50,60,320,*" MinHeight="20" Background="{Binding ., Converter={x:Static v:Converters.RawBackground}}">
              <TextBlock Text="{Binding Utc}" Classes="message" Foreground="{Binding ., Converter={x:Static v:Converters.RawForeground}}" />
              <TextBlock Grid.Column="1" Text="{Binding Local}" Classes="message" Foreground="{Binding ., Converter={x:Static v:Converters.RawForeground}}" />
              <TextBlock Grid.Column="2" Text="{Binding Db}" Classes="message" Foreground="{Binding ., Converter={x:Static v:Converters.RawForeground}}" />
              <TextBlock Grid.Column="3" Text="{Binding Dt}" Classes="message" Foreground="{Binding ., Converter={x:Static v:Converters.RawForeground}}" />
              <TextBlock Grid.Column="4" Text="{Binding Hz}" Classes="message" Foreground="{Binding ., Converter={x:Static v:Converters.RawForeground}}" />
              <TextBlock Grid.Column="5" Text="{Binding Message}" Classes="message" Foreground="{Binding ., Converter={x:Static v:Converters.RawForeground}}" />
              <TextBlock Grid.Column="6" Text="{Binding Country}" Classes="secondary" />
            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </Grid>
  </Border>
</UserControl>
