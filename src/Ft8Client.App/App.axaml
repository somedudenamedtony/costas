<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Ft8Client.App.App"
             RequestedThemeVariant="Default">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
          <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#F3F3F3" />
          <SolidColorBrush x:Key="CardBackgroundBrush" Color="#FFFFFF" />
          <SolidColorBrush x:Key="CardBorderBrush" Color="#E0E0E0" />
          <SolidColorBrush x:Key="ControlBorderBrush" Color="#D1D1D1" />
          <SolidColorBrush x:Key="TextPrimaryBrush" Color="#1A1A1A" />
          <SolidColorBrush x:Key="TextSecondaryBrush" Color="#5F5F5F" />
          <SolidColorBrush x:Key="AccentBrush" Color="{DynamicResource SystemAccentColor}" />
          <SolidColorBrush x:Key="AccentTextBrush" Color="{DynamicResource SystemAccentColorDark1}" />
          <SolidColorBrush x:Key="CautionBrush" Color="#8A4B00" />
          <SolidColorBrush x:Key="CriticalBrush" Color="#C42B1C" />
          <SolidColorBrush x:Key="SuccessBrush" Color="#0F7B0F" />
          <SolidColorBrush x:Key="SelectedRowBrush" Color="#E5F1FB" />
          <SolidColorBrush x:Key="RowDividerBrush" Color="#EBEBEB" />
          <SolidColorBrush x:Key="OnAirBrush" Color="#D11F1F" />
          <SolidColorBrush x:Key="NoRadioBrush" Color="#F5C518" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
          <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#202020" />
          <SolidColorBrush x:Key="CardBackgroundBrush" Color="#2B2B2B" />
          <SolidColorBrush x:Key="CardBorderBrush" Color="#3A3A3A" />
          <SolidColorBrush x:Key="ControlBorderBrush" Color="#4A4A4A" />
          <SolidColorBrush x:Key="TextPrimaryBrush" Color="#F2F2F2" />
          <SolidColorBrush x:Key="TextSecondaryBrush" Color="#AAAAAA" />
          <SolidColorBrush x:Key="AccentBrush" Color="{DynamicResource SystemAccentColor}" />
          <SolidColorBrush x:Key="AccentTextBrush" Color="{DynamicResource SystemAccentColorLight2}" />
          <SolidColorBrush x:Key="CautionBrush" Color="#F0A64B" />
          <SolidColorBrush x:Key="CriticalBrush" Color="#E5584A" />
          <SolidColorBrush x:Key="SuccessBrush" Color="#6CCB5F" />
          <SolidColorBrush x:Key="SelectedRowBrush" Color="#1F3A55" />
          <SolidColorBrush x:Key="RowDividerBrush" Color="#353535" />
          <SolidColorBrush x:Key="OnAirBrush" Color="#D11F1F" />
          <SolidColorBrush x:Key="NoRadioBrush" Color="#F5C518" />
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>
      <FontFamily x:Key="AppFont">Segoe UI Variable Text, Segoe UI, Inter, Open Sans, DejaVu Sans</FontFamily>
      <FontFamily x:Key="MessageFont">Cascadia Mono, Consolas, DejaVu Sans Mono, monospace</FontFamily>
    </ResourceDictionary>
  </Application.Resources>
  <Application.Styles>
    <FluentTheme />
    <Style Selector="Window">
      <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Background" Value="{DynamicResource WindowBackgroundBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>
    <Style Selector="Border.card">
      <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
    </Style>
    <Style Selector="TextBlock.title">
      <Setter Property="FontSize" Value="15" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TextBlock.secondary">
      <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
    </Style>
    <Style Selector="TextBlock.num">
      <Setter Property="FontFeatures" Value="+tnum" />
    </Style>
    <Style Selector="TextBlock.message">
      <Setter Property="FontFamily" Value="{StaticResource MessageFont}" />
      <Setter Property="FontSize" Value="12" />
    </Style>
    <Style Selector="Button.link">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.link TextBlock">
      <Setter Property="TextDecorations" Value="Underline" />
    </Style>
    <Style Selector="Button, ComboBox, TextBox">
      <Setter Property="MinHeight" Value="32" />
      <Setter Property="CornerRadius" Value="4" />
    </Style>
    <Style Selector="Button.critical">
      <Setter Property="Background" Value="{DynamicResource CriticalBrush}" />
      <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="Button.tab">
      <Setter Property="MinHeight" Value="32" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="Margin" Value="2,0" />
    </Style>
    <!-- The selected view's tab: clicking it again keeps it selected. -->
    <Style Selector="Button.tab.selected /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
      <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="Button.tab.selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="Opacity" Value="0.9" />
    </Style>
  </Application.Styles>
</Application>
