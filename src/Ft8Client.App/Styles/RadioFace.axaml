<Styles xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Ft8Client.App.ViewModels" xmlns:v="using:Ft8Client.App.Views">
  <Styles.Resources>
    <DataTemplate x:Key="InstrumentFaceTemplate" x:DataType="vm:MainViewModel">
      <Border CornerRadius="8" BorderBrush="#657782" BorderThickness="1" Padding="20,14" BoxShadow="0 3 6 0 #66000000">
        <Border.Background><LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%"><GradientStop Color="#3F4D57" Offset="0" /><GradientStop Color="#1A232B" Offset="1" /></LinearGradientBrush></Border.Background>
        <Grid ColumnDefinitions="160,*,220,88" ColumnSpacing="24">
          <StackPanel VerticalAlignment="Center" Spacing="5">
            <TextBlock Text="COSTAS" FontSize="25" FontWeight="Bold" LetterSpacing="4" Foreground="#F0F5F8" />
            <TextBlock Text="DIGITAL TRANSCEIVER" FontSize="9" LetterSpacing="1.8" Foreground="#A9BDC9" />
            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,6,0,0">
              <Border Background="#0D1920" BorderBrush="#526674" BorderThickness="1" Padding="8,3" CornerRadius="2">
                <TextBlock Text="{Binding SelectedMode}" FontSize="11" Foreground="#8BDCF0" FontFamily="{StaticResource MessageFont}" />
              </Border>
              <TextBlock Text="{Binding SelectedBandChoice.Name}" Foreground="#B8CEDB" VerticalAlignment="Center" FontSize="11" />
            </StackPanel>
          </StackPanel>
          <Border Grid.Column="1" Background="#07151C" BorderBrush="#091015" BorderThickness="3" CornerRadius="4" Padding="16,8">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="16">
            <!-- Transmit meters from the radio over CAT, as on the radio's own display; held after a transmission. -->
            <v:TxFaceMeters Grid.Column="1" LabelBrush="#64A8BB" ValueBrush="#C8E9F2" MeterBrush="#5DD2ED" CautionBrush="#F0A64B"
                            TrackBrush="#152832" FontFamily="{StaticResource MessageFont}" />
            <StackPanel Spacing="1">
              <TextBlock Text="DIAL FREQUENCY" Foreground="#64A8BB" FontSize="9" LetterSpacing="2" />
              <Button Classes="instrument-dial" IsEnabled="{Binding CanChangeBand}" ToolTip.Tip="Edit dial frequency" AutomationProperties.Name="Dial frequency">
                <StackPanel Orientation="Horizontal" Spacing="10">
                  <TextBlock Text="{Binding Frequency}" Foreground="#9BEAFF" FontSize="38" FontFamily="{StaticResource MessageFont}" FontWeight="SemiBold" />
                  <TextBlock Text="MHz" Foreground="#64A8BB" FontSize="11" VerticalAlignment="Bottom" Margin="0,0,0,7" />
                </StackPanel>
              </Button>
            </StackPanel>
            </Grid>
          </Border>
          <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="8">
            <DockPanel><TextBlock Classes="instrument-phase" Classes.transmitting="{Binding Transmitting}" Text="{Binding SlotLabel}" /><TextBlock Text="{Binding SlotRemaining}" HorizontalAlignment="Right" Foreground="#C8E9F2" FontFamily="{StaticResource MessageFont}" /></DockPanel>
            <v:SlotMeter Value="{Binding SlotProgress}" Height="14" MeterBrush="#5DD2ED" TrackBrush="#152832" AutomationProperties.Name="Slot progress" />
            <TextBlock Text="SLOT PROGRESS" Foreground="#8CA7B6" FontSize="9" LetterSpacing="1.5" />
          </StackPanel>
          <Button Grid.Column="3" Classes="instrument-dial tuning-knob" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" IsEnabled="{Binding CanChangeBand}" Width="78" Height="78" CornerRadius="39" ToolTip.Tip="Open the dial frequency editor" AutomationProperties.Name="Edit dial frequency">
            <Button.Background><RadialGradientBrush Center="35%,30%" RadiusX="80%" RadiusY="80%"><GradientStop Color="#748692" Offset="0" /><GradientStop Color="#26343E" Offset="0.65" /><GradientStop Color="#101A21" Offset="1" /></RadialGradientBrush></Button.Background>
            <StackPanel Spacing="9"><Border Width="3" Height="12" Background="#AAE6F2" CornerRadius="1" /><TextBlock Text="DIAL" FontSize="9" Foreground="#D7E7EF" LetterSpacing="1" /></StackPanel>
          </Button>
        </Grid>
      </Border>
    </DataTemplate>
  </Styles.Resources>
  <Style Selector="Border.card">
    <Setter Property="CornerRadius" Value="3" /><Setter Property="BorderThickness" Value="1,2,1,1" />
    <Setter Property="BoxShadow" Value="0 2 4 0 #25000000" />
    <Setter Property="Background"><LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%"><GradientStop Color="{DynamicResource SkinCardColor}" Offset="0" /><GradientStop Color="{DynamicResource SkinWindowColor}" Offset="1" /></LinearGradientBrush></Setter>
  </Style>
  <Style Selector="TextBlock.title"><Setter Property="FontFamily" Value="{StaticResource MessageFont}" /><Setter Property="FontSize" Value="13" /><Setter Property="LetterSpacing" Value="0.5" /></Style>
  <Style Selector="Button:not(.link):not(.wfoverlay):not(.instrument-dial)"><Setter Property="CornerRadius" Value="3" /><Setter Property="BorderThickness" Value="1,1,1,3" /><Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}" /></Style>
  <Style Selector="TextBlock.instrument-phase"><Setter Property="Foreground" Value="#96DFF1" /><Setter Property="FontWeight" Value="SemiBold" /></Style>
  <Style Selector="TextBlock.instrument-phase.transmitting"><Setter Property="Foreground" Value="{DynamicResource CriticalBrush}" /></Style>
  <Style Selector="Button.instrument-dial"><Setter Property="Padding" Value="0" /><Setter Property="BorderThickness" Value="0" /><Setter Property="Background" Value="Transparent" /></Style>
  <Style Selector="Button.instrument-dial:not(.tuning-knob) /template/ ContentPresenter"><Setter Property="Background" Value="Transparent" /></Style>
  <Style Selector="Button.instrument-dial:pointerover /template/ ContentPresenter"><Setter Property="Opacity" Value="0.85" /></Style>
</Styles>
