<Styles xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Ft8Client.App.ViewModels" xmlns:v="using:Ft8Client.App.Views">
  <Styles.Resources>
    <DataTemplate x:Key="InstrumentFaceTemplate" x:DataType="vm:MainViewModel">
      <Border CornerRadius="4" BorderBrush="#858985" BorderThickness="1,1,1,4" Padding="20,12" BoxShadow="0 3 6 0 #60000000">
        <Border.Background><LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%"><GradientStop Color="#626563" Offset="0" /><GradientStop Color="#333634" Offset="1" /></LinearGradientBrush></Border.Background>
        <Grid ColumnDefinitions="170,*,200,90" ColumnSpacing="20">
          <StackPanel VerticalAlignment="Center" Spacing="5">
            <TextBlock Text="COSTAS" FontSize="25" FontWeight="Bold" LetterSpacing="3" Foreground="#F1F3EC" />
            <TextBlock Text="HF DIGITAL TRANSCEIVER" FontSize="9" LetterSpacing="1.2" Foreground="#D0D6C6" />
            <StackPanel Spacing="4" Margin="0,10,28,0">
              <Border Height="2" Background="#22271F" /><Border Height="2" Background="#22271F" /><Border Height="2" Background="#22271F" />
            </StackPanel>
          </StackPanel>
          <Border Grid.Column="1" Background="#111A0B" BorderBrush="#1A2014" BorderThickness="5" CornerRadius="3" Padding="14,6">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="16">
            <v:TxFaceMeters Grid.Column="1" LabelBrush="#819D54" ValueBrush="#C3E391" MeterBrush="#BDF462" CautionBrush="#F0A64B"
                            TrackBrush="#263B17" FontFamily="{StaticResource MessageFont}" />
            <StackPanel Spacing="5">
              <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="12"><TextBlock Text="{Binding SelectedMode}" Foreground="#A8CF68" FontFamily="{StaticResource MessageFont}" FontSize="10" /><TextBlock Text="{Binding SelectedBandChoice.Name}" Foreground="#A8CF68" FontFamily="{StaticResource MessageFont}" FontSize="10" /></StackPanel>
                <TextBlock Text="FREQUENCY" Foreground="#819D54" FontFamily="{StaticResource MessageFont}" FontSize="9" LetterSpacing="2" />
              </DockPanel>
              <Button Classes="instrument-dial" IsEnabled="{Binding CanChangeBand}" ToolTip.Tip="Edit dial frequency" AutomationProperties.Name="{Binding Frequency, StringFormat='Dial frequency {0}'}">
                <StackPanel Orientation="Horizontal" Spacing="12">
                  <v:SegmentedDisplay Text="{Binding Frequency}" DigitHeight="48" SegmentBrush="#BDF462" InactiveBrush="#263B17" />
                  <TextBlock Text="MHz" Foreground="#A8CF68" FontSize="10" VerticalAlignment="Bottom" Margin="0,0,0,3" FontFamily="{StaticResource MessageFont}" />
                </StackPanel>
              </Button>
            </StackPanel>
            </Grid>
          </Border>
          <Border Grid.Column="2" Background="#22291B" BorderBrush="#747F62" BorderThickness="1" CornerRadius="2" Padding="12,10">
            <StackPanel VerticalAlignment="Center" Spacing="7">
              <DockPanel><TextBlock Text="SLOT" FontFamily="{StaticResource MessageFont}" Foreground="#8DAB5F" FontSize="9" /><TextBlock Text="{Binding SlotRemaining}" HorizontalAlignment="Right" FontFamily="{StaticResource MessageFont}" Foreground="#C3E391" FontSize="10" /></DockPanel>
              <v:SlotMeter Value="{Binding SlotProgress}" Height="11" MeterBrush="#BDF462" TrackBrush="#394828" AutomationProperties.Name="Slot progress" />
              <TextBlock Classes="instrument-phase" Classes.transmitting="{Binding Transmitting}" Text="{Binding SlotLabel}" FontFamily="{StaticResource MessageFont}" FontSize="10" />
            </StackPanel>
          </Border>
          <Button Grid.Column="3" Classes="instrument-dial tuning-knob" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" IsEnabled="{Binding CanChangeBand}" Width="82" Height="82" CornerRadius="41" BorderBrush="#171B18" BorderThickness="3" ToolTip.Tip="Open the dial frequency editor" AutomationProperties.Name="Edit dial frequency">
            <Button.Background><RadialGradientBrush Center="35%,30%" RadiusX="80%" RadiusY="80%"><GradientStop Color="#666A68" Offset="0" /><GradientStop Color="#252927" Offset="0.65" /><GradientStop Color="#090C0B" Offset="1" /></RadialGradientBrush></Button.Background>
            <StackPanel Spacing="12"><Border Width="3" Height="12" Background="#C8D2BA" /><TextBlock Text="DIAL" FontSize="9" Foreground="#D6DEC9" FontFamily="{StaticResource MessageFont}" /></StackPanel>
          </Button>
        </Grid>
      </Border>
    </DataTemplate>
  </Styles.Resources>
  <Style Selector="Border.card"><Setter Property="CornerRadius" Value="2" /><Setter Property="BorderThickness" Value="1,1,1,3" /><Setter Property="BoxShadow" Value="0 2 3 0 #25000000" /></Style>
  <Style Selector="TextBlock.title"><Setter Property="FontSize" Value="13" /><Setter Property="FontWeight" Value="Bold" /><Setter Property="LetterSpacing" Value="0.7" /></Style>
  <Style Selector="Button:not(.link):not(.wfoverlay):not(.instrument-dial)"><Setter Property="CornerRadius" Value="2" /><Setter Property="BorderThickness" Value="1,1,1,3" /><Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}" /></Style>
  <Style Selector="ComboBox, TextBox"><Setter Property="CornerRadius" Value="2" /></Style>
  <Style Selector="TextBlock.instrument-phase"><Setter Property="Foreground" Value="#BDF462" /></Style>
  <Style Selector="TextBlock.instrument-phase.transmitting"><Setter Property="Foreground" Value="{DynamicResource CriticalBrush}" /></Style>
  <Style Selector="Button.instrument-dial"><Setter Property="Padding" Value="0" /><Setter Property="BorderThickness" Value="0" /><Setter Property="Background" Value="Transparent" /></Style>
  <Style Selector="Button.instrument-dial:not(.tuning-knob) /template/ ContentPresenter"><Setter Property="Background" Value="Transparent" /></Style>
  <Style Selector="Button.instrument-dial:pointerover /template/ ContentPresenter"><Setter Property="Opacity" Value="0.85" /></Style>
</Styles>
